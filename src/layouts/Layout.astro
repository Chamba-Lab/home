---
import "@fontsource-variable/inter";
import "@fontsource-variable/plus-jakarta-sans";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_URL } from "../lib/constants";
import {
    breadcrumbJsonLd,
    serializeJsonLd,
    type BreadcrumbItem,
} from "../lib/seo";

interface Props {
    title: string;
    description?: string;
    image?: string;
    type?: "website" | "article";
    /** Migas de pan (JSON-LD). La primera debe ser el inicio. */
    breadcrumbs?: BreadcrumbItem[];
    /** Nodos JSON-LD adicionales (Organization, Event, etc.). */
    jsonLd?: Record<string, unknown>[];
    /** Excluye la página de los buscadores (por ejemplo, el 404). */
    noindex?: boolean;
    /** Categoría de recursos: logo, LAB e idioma toman su color. */
    category?: string;
}

const {
    title,
    description = "Chamba Lab: comunidad tech para conectar, inspirarte y crecer. Conversa, aprende y avanza junto a otras personas en tecnología. Únete en Discord.",
    image,
    type = "website",
    breadcrumbs,
    jsonLd = [],
    noindex = false,
    category,
} = Astro.props;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const siteUrl = Astro.site ?? new URL(SITE_URL);
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const defaultImage = `${base}og-image.png`;
const ogImageUrl = new URL(image || defaultImage, siteUrl);

const structuredData = [
    ...jsonLd,
    ...(breadcrumbs ? [breadcrumbJsonLd(siteUrl.origin, breadcrumbs)] : []),
];
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <!-- Al navegar, Chrome sigue mostrando la página anterior mientras
             carga el CSS de la nueva, pero los clics ya llegan a esta sin
             estilos (el logo SVG ocupa toda la pantalla y cada clic volvía a
             navegar a /). Se ignoran hasta que global.css los reactiva. -->
        <style is:inline>
            body {
                pointer-events: none;
            }
        </style>
        <title>{title}</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#080D1A" />
        {noindex && <meta name="robots" content="noindex" />}
        <link rel="canonical" href={canonicalUrl.href} />
        <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
        <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
        <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
        <link rel="manifest" href={`${base}site.webmanifest`} />

        <!-- Open Graph / Facebook / Discord / LinkedIn -->
        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonicalUrl.href} />
        <meta property="og:site_name" content="Chamba Lab" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageUrl.href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
            property="og:image:alt"
            content="Chamba Lab · Connect. Inspire. Grow."
        />
        <meta property="og:locale" content="es_PE" />
        <meta property="og:locale:alternate" content="en_US" />

        <!-- Twitter / X Cards -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalUrl.href} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl.href} />
        <meta
            name="twitter:image:alt"
            content="Chamba Lab · Connect. Inspire. Grow."
        />

        {structuredData.length > 0 && (
            <script
                is:inline
                type="application/ld+json"
                set:html={serializeJsonLd(structuredData)}
            />
        )}
    </head>
    <body
        data-category={category}
        class="min-h-screen flex flex-col bg-bg text-slate-200 selection:bg-brand-yellow selection:text-slate-950"
    >
        <Header />
        <slot />
        <Footer />

        <script>
            import { translations, type Lang } from "../i18n/translations";
            import { getStoredLang, setStoredLang } from "../i18n/lang";
            import { removeBrokenImages } from "../lib/broken-images";
            import { forwardClicksDuringTransition } from "../lib/view-transitions";

            removeBrokenImages();
            forwardClicksDuringTransition();

            function applyLang(lang: Lang) {
                document.documentElement.lang = lang;

                // Sync UI pill buttons state if present
                const btnEs = document.querySelectorAll(".lang-btn-es");
                const btnEn = document.querySelectorAll(".lang-btn-en");
                if (lang === "es") {
                    btnEs.forEach((el) => {
                        el.classList.add(
                            "bg-(--page-accent)",
                            "text-slate-950",
                            "font-bold",
                        );
                        el.classList.remove("text-slate-400");
                    });
                    btnEn.forEach((el) => {
                        el.classList.remove(
                            "bg-(--page-accent)",
                            "text-slate-950",
                            "font-bold",
                        );
                        el.classList.add("text-slate-400");
                    });
                } else {
                    btnEn.forEach((el) => {
                        el.classList.add(
                            "bg-(--page-accent)",
                            "text-slate-950",
                            "font-bold",
                        );
                        el.classList.remove("text-slate-400");
                    });
                    btnEs.forEach((el) => {
                        el.classList.remove(
                            "bg-(--page-accent)",
                            "text-slate-950",
                            "font-bold",
                        );
                        el.classList.add("text-slate-400");
                    });
                }

                // Chrome-level strings from translations dictionary
                document
                    .querySelectorAll<HTMLElement>("[data-i18n]")
                    .forEach((el) => {
                        const key = el.dataset
                            .i18n as keyof (typeof translations)["es"];
                        if (
                            key &&
                            translations[lang] &&
                            translations[lang][key]
                        ) {
                            el.textContent = translations[lang][key];
                        }
                    });

                // Placeholders
                document
                    .querySelectorAll<HTMLInputElement>(
                        "[data-i18n-placeholder-en]",
                    )
                    .forEach((el) => {
                        const enText = el.dataset.i18nPlaceholderEn;
                        const esText = el.dataset.i18nPlaceholderEs;
                        el.placeholder =
                            (lang === "es" ? esText : enText) || "";
                    });

                // Bilingual attributes (alt, aria-label, title)
                for (const attr of ["alt", "aria-label", "title"]) {
                    document
                        .querySelectorAll<HTMLElement>(`[data-i18n-${attr}-en]`)
                        .forEach((el) => {
                            const enText = el.getAttribute(
                                `data-i18n-${attr}-en`,
                            );
                            const esText = el.getAttribute(
                                `data-i18n-${attr}-es`,
                            );
                            const text =
                                lang === "es" ? (esText ?? enText) : enText;
                            if (text) el.setAttribute(attr, text);
                        });
                }

                // Inline bilingual data
                document
                    .querySelectorAll<HTMLElement>("[data-i18n-en]")
                    .forEach((el) => {
                        const enText = el.dataset.i18nEn;
                        const esText = el.dataset.i18nEs;
                        const text =
                            lang === "es" ? (esText ?? enText) : enText;
                        if (text) el.textContent = text;
                    });

                // Notify page-specific listeners
                document.dispatchEvent(
                    new CustomEvent("chamba-lab:lang", { detail: { lang } }),
                );
            }

            let currentLang: Lang = getStoredLang();
            applyLang(currentLang);

            // Handler for language switch buttons
            document.addEventListener("click", (e) => {
                const target = e.target as HTMLElement | null;
                const toggleBtn = target?.closest("[data-set-lang]");
                if (toggleBtn) {
                    const newLang = toggleBtn.getAttribute(
                        "data-set-lang",
                    ) as Lang;
                    if (newLang === "es" || newLang === "en") {
                        currentLang = newLang;
                        applyLang(currentLang);
                        setStoredLang(currentLang);
                    }
                }
            });
        </script>
    </body>
</html>
