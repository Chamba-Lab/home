---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
}

const { title } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            content="Chamba Lab: comunidad tech para crecer juntos. Únete en Discord."
        />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <!-- Google Fonts: Inter & Plus Jakarta Sans -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
            rel="stylesheet"
        />
    </head>
    <body
        class="bg-gray-50 dark:bg-slate-900 text-slate-900 dark:text-slate-100 font-sans antialiased min-h-screen selection:bg-indigo-500 selection:text-white"
    >
        <Header />
        <slot />
        <Footer />

        <script>
            const translations = {
                es: {
                    langToggle: "EN",
                    navResources: "Recursos",
                    navEvents: "Eventos",
                    badge: "Comunidad Tech",
                    intro: "Una comunidad para quienes construyen su carrera en tech — estudiantes, profesionales y todo lo que hay en el medio. Compartimos conocimiento, oportunidades y apoyo real para crecer juntos. Todo pasa en nuestro Discord.",
                    cta: "Unirse a Discord",
                    resourcesTitle: "Recursos",
                    resourcesIntro:
                        "Una selección de guías, plataformas de práctica y plantillas que la comunidad recomienda. Algunos están en inglés — lo marcamos en cada tarjeta.",
                    eventsTitle: "Formatos de eventos",
                    eventsIntro:
                        "Estos son los tipos de sesiones que organizamos. Las fechas se anuncian en el canal #eventos de Discord.",
                },
                en: {
                    langToggle: "ES",
                    navResources: "Resources",
                    navEvents: "Events",
                    badge: "Tech Community",
                    intro: "A community for people building their careers in tech — students, professionals, and everyone in between. We share knowledge, opportunities, and real support to grow together. It all happens in our Discord.",
                    cta: "Join Discord",
                    resourcesTitle: "Resources",
                    resourcesIntro:
                        "A curated set of guides, practice platforms, and templates the community recommends. Some are in English — each card is labeled.",
                    eventsTitle: "Event formats",
                    eventsIntro:
                        "These are the kinds of sessions we run. Exact dates are announced in the #eventos channel on Discord.",
                },
            };

            type Lang = keyof typeof translations;

            function getStoredLang(): Lang {
                try {
                    const stored = localStorage.getItem("chamba-lab-lang");
                    if (stored === "es" || stored === "en") return stored;
                } catch {
                    /* ignore storage access issues (private mode, etc.) */
                }
                return "es";
            }

            function applyLang(lang: Lang) {
                document.documentElement.lang = lang;
                document
                    .querySelectorAll<HTMLElement>("[data-i18n]")
                    .forEach((el) => {
                        const key = el.dataset
                            .i18n as keyof (typeof translations)["es"];
                        if (key && translations[lang][key]) {
                            el.textContent = translations[lang][key];
                        }
                    });
            }

            let currentLang: Lang = getStoredLang();
            applyLang(currentLang);

            document
                .getElementById("lang-toggle")
                ?.addEventListener("click", () => {
                    currentLang = currentLang === "es" ? "en" : "es";
                    applyLang(currentLang);
                    try {
                        localStorage.setItem("chamba-lab-lang", currentLang);
                    } catch {
                        /* ignore storage access issues (private mode, etc.) */
                    }
                });
        </script>
    </body>
</html>
