---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
}

const { title } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            content="Chamba Lab: El espacio para impulsar tu camino en tecnología. Comunidad tech para crecer juntos. Únete en Discord."
        />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>

        <!-- Google Fonts: Inter & Plus Jakarta Sans & Material Symbols -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
            rel="stylesheet"
        />
    </head>
    <body
        class="min-h-screen flex flex-col bg-[#080D1A] text-slate-200 selection:bg-brand-yellow selection:text-slate-950"
    >
        <Header />
        <slot />
        <Footer />

        <script>
            import { translations, type Lang } from "../i18n/translations";
            import { getStoredLang, setStoredLang } from "../i18n/lang";

            function applyLang(lang: Lang) {
                document.documentElement.lang = lang;

                // Sync UI pill buttons state if present
                const btnEs = document.querySelectorAll(".lang-btn-es");
                const btnEn = document.querySelectorAll(".lang-btn-en");
                if (lang === "es") {
                    btnEs.forEach((el) => {
                        el.classList.add(
                            "bg-brand-yellow",
                            "text-slate-950",
                            "font-bold",
                        );
                        el.classList.remove("text-slate-400");
                    });
                    btnEn.forEach((el) => {
                        el.classList.remove(
                            "bg-brand-yellow",
                            "text-slate-950",
                            "font-bold",
                        );
                        el.classList.add("text-slate-400");
                    });
                } else {
                    btnEn.forEach((el) => {
                        el.classList.add(
                            "bg-brand-yellow",
                            "text-slate-950",
                            "font-bold",
                        );
                        el.classList.remove("text-slate-400");
                    });
                    btnEs.forEach((el) => {
                        el.classList.remove(
                            "bg-brand-yellow",
                            "text-slate-950",
                            "font-bold",
                        );
                        el.classList.add("text-slate-400");
                    });
                }

                // Chrome-level strings from translations dictionary
                document
                    .querySelectorAll<HTMLElement>("[data-i18n]")
                    .forEach((el) => {
                        const key = el.dataset
                            .i18n as keyof (typeof translations)["es"];
                        if (
                            key &&
                            translations[lang] &&
                            translations[lang][key]
                        ) {
                            el.textContent = translations[lang][key];
                        }
                    });

                // Placeholders
                document
                    .querySelectorAll<HTMLInputElement>(
                        "[data-i18n-placeholder-en]",
                    )
                    .forEach((el) => {
                        const enText = el.dataset.i18nPlaceholderEn;
                        const esText = el.dataset.i18nPlaceholderEs;
                        el.placeholder =
                            (lang === "es" ? esText : enText) || "";
                    });

                // Inline bilingual data
                document
                    .querySelectorAll<HTMLElement>("[data-i18n-en]")
                    .forEach((el) => {
                        const enText = el.dataset.i18nEn;
                        const esText = el.dataset.i18nEs;
                        const text =
                            lang === "es" ? (esText ?? enText) : enText;
                        if (text) el.textContent = text;
                    });

                // Notify page-specific listeners
                document.dispatchEvent(
                    new CustomEvent("chamba-lab:lang", { detail: { lang } }),
                );
            }

            let currentLang: Lang = getStoredLang();
            applyLang(currentLang);

            // Handler for language switch buttons
            document.addEventListener("click", (e) => {
                const target = e.target as HTMLElement | null;
                const toggleBtn = target?.closest("[data-set-lang]");
                if (toggleBtn) {
                    const newLang = toggleBtn.getAttribute(
                        "data-set-lang",
                    ) as Lang;
                    if (newLang === "es" || newLang === "en") {
                        currentLang = newLang;
                        applyLang(currentLang);
                        setStoredLang(currentLang);
                    }
                }
            });
        </script>
    </body>
</html>
