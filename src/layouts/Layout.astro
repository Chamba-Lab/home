---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
}

const { title } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <script is:inline>
            // Runs before first paint so an explicit theme choice applies
            // immediately, with no flash of the OS-default theme.
            (function () {
                try {
                    var stored = localStorage.getItem("chamba-lab-theme");
                    if (stored === "light" || stored === "dark") {
                        document.documentElement.setAttribute(
                            "data-theme",
                            stored,
                        );
                    }
                } catch {
                    /* ignore storage access issues (private mode, etc.) */
                }
            })();
        </script>
        <meta
            name="description"
            content="Chamba Lab: comunidad tech para crecer juntos. Únete en Discord."
        />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <!-- Google Fonts: Inter & Archivo Black -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Archivo+Black&display=swap"
            rel="stylesheet"
        />
    </head>
    <body
        class="bg-bg text-content font-sans antialiased min-h-screen selection:bg-primary selection:text-content-inverse"
    >
        <Header />
        <slot />
        <Footer />

        <script>
            import { translations, type Lang } from "../i18n/translations";
            import { getStoredLang, setStoredLang } from "../i18n/lang";
            import {
                currentTheme,
                getStoredTheme,
                setStoredTheme,
                type Theme,
            } from "../lib/theme";

            function syncThemeIcons(theme: Theme) {
                const sun = document.getElementById("theme-icon-sun");
                const moon = document.getElementById("theme-icon-moon");
                if (sun) sun.hidden = theme !== "dark";
                if (moon) moon.hidden = theme === "dark";
            }

            syncThemeIcons(currentTheme());

            document
                .getElementById("theme-toggle")
                ?.addEventListener("click", () => {
                    const next: Theme =
                        currentTheme() === "dark" ? "light" : "dark";
                    document.documentElement.dataset.theme = next;
                    setStoredTheme(next);
                    syncThemeIcons(next);
                });

            window
                .matchMedia("(prefers-color-scheme: dark)")
                .addEventListener("change", () => {
                    if (!getStoredTheme()) syncThemeIcons(currentTheme());
                });

            function applyLang(lang: Lang) {
                document.documentElement.lang = lang;

                // Chrome-level strings (nav, hero, section titles) from the
                // dictionary above.
                document
                    .querySelectorAll<HTMLElement>("[data-i18n]")
                    .forEach((el) => {
                        const key = el.dataset
                            .i18n as keyof (typeof translations)["es"];
                        if (key && translations[lang][key]) {
                            el.textContent = translations[lang][key];
                        }
                    });

                // Content-collection text (resource/event descriptions, etc.)
                // authored inline as data-i18n-en (required) / data-i18n-es
                // (optional). Falls back to English when the selected
                // language has no translation configured.
                document
                    .querySelectorAll<HTMLElement>("[data-i18n-en]")
                    .forEach((el) => {
                        const enText = el.dataset.i18nEn;
                        const esText = el.dataset.i18nEs;
                        const text =
                            lang === "es" ? (esText ?? enText) : enText;
                        if (text) el.textContent = text;
                    });

                // Notify page-specific scripts (e.g. Eventos' month
                // navigation) that need to know the current language for UI
                // they render/update dynamically, outside the sweeps above.
                document.dispatchEvent(
                    new CustomEvent("chamba-lab:lang", { detail: { lang } }),
                );
            }

            let currentLang: Lang = getStoredLang();
            applyLang(currentLang);

            document
                .getElementById("lang-toggle")
                ?.addEventListener("click", () => {
                    currentLang = currentLang === "es" ? "en" : "es";
                    applyLang(currentLang);
                    setStoredLang(currentLang);
                });
        </script>
    </body>
</html>
