---
import { getCollection } from "astro:content";
import { formatShortDate, type EventKind, type I18nText } from "../lib/events";

interface PosterEvent {
    dateIso?: string;
    startTime?: string;
    endTime?: string;
    tag?: I18nText;
}
interface Props {
    kind?: EventKind;
    compact?: boolean;
    // Event shown in an agenda row. Without it (hero), each poster reads its
    // event from the collection by kind.
    event?: PosterEvent;
}
const { kind, compact = false, event } = Astro.props;
const events = await getCollection("events");

function posterEvent(wanted: EventKind): PosterEvent | undefined {
    if (kind === wanted && event) return event;
    const data = events.find((e) => e.data.kind === wanted)?.data;
    return (
        data && {
            dateIso: data.date ?? data.startDate,
            startTime: data.startTime,
            endTime: data.endTime,
            tag: data.tag,
        }
    );
}

const launch = posterEvent("launch");
const coworking = posterEvent("coworking");
const activity = posterEvent("activity");
const launchDateEs = formatShortDate(launch?.dateIso, "es");
const launchDateEn = formatShortDate(launch?.dateIso, "en");
const activityDateEs = formatShortDate(activity?.dateIso, "es");
const activityDateEn = formatShortDate(activity?.dateIso, "en");
const activityTime = activity?.startTime
    ? `${activity.startTime}${activity.endTime ? `—${activity.endTime}` : ""}`
    : "";
---

<div class:list={["posters", { compact }]} aria-hidden="true">
    {!compact && (
        <img class="poster-glow" src="/images/events/glow.svg" alt="" />
    )}
    {(!kind || kind === "launch") && (
        <div class="poster-slot launch-slot">
            <div class="poster launch-poster">
                <span
                    class="poster-label"
                    data-i18n-es="CHAMBA LAB / ENCUENTRO"
                    data-i18n-en="CHAMBA LAB / GATHERING"
                >
                    CHAMBA LAB / ENCUENTRO
                </span>
                <strong
                    class="poster-title"
                    data-i18n-es="EL INICIO&#10;DE ALGO&#10;EN COMÚN."
                    data-i18n-en="THE START&#10;OF SOMETHING&#10;TOGETHER."
                >
                    EL INICIO
                    <br />
                    DE ALGO
                    <br />
                    EN COMÚN.
                </strong>
                <img class="poster-star" src="/images/events/star.svg" alt="" />
                <strong
                    class="poster-date"
                    data-i18n-es={launchDateEs}
                    data-i18n-en={launchDateEn}
                >
                    {launchDateEs}
                </strong>
                <span class="poster-bottom">{launch?.startTime} · DISCORD</span>
            </div>
        </div>
    )}
    {kind === "activity" && (
        <div class="poster-slot activity-slot">
            <div class="poster activity-poster">
                <span
                    class="poster-label"
                    data-i18n-es="CHAMBA LAB / ACTIVIDAD"
                    data-i18n-en="CHAMBA LAB / ACTIVITY"
                >
                    CHAMBA LAB / ACTIVIDAD
                </span>
                <strong
                    class="poster-title"
                    data-i18n-es={activity?.tag?.es ?? activity?.tag?.en}
                    data-i18n-en={activity?.tag?.en}
                >
                    {activity?.tag?.es ?? activity?.tag?.en}
                </strong>
                <span class="poster-rule" />
                <strong
                    class="poster-date"
                    data-i18n-es={activityDateEs}
                    data-i18n-en={activityDateEn}
                >
                    {activityDateEs}
                </strong>
                <span class="poster-bottom">{activityTime} · DISCORD</span>
            </div>
        </div>
    )}
    {(!kind || kind === "coworking") && (
        <div class="poster-slot coffee-slot">
            <div class="poster coffee-poster">
                <span class="poster-label">CHAMBA LAB / COWORKING</span>
                <strong class="poster-title">
                    Code &amp;
                    <br />
                    Coffee
                </strong>
                <img
                    class="poster-coffee"
                    src="/images/events/coffee.svg"
                    alt=""
                />
                <span
                    class="poster-bottom"
                    data-i18n-es={`VIERNES · ${coworking?.startTime}—${coworking?.endTime}`}
                    data-i18n-en={`FRIDAYS · ${coworking?.startTime}—${coworking?.endTime}`}
                >
                    VIERNES · {coworking?.startTime}—{coworking?.endTime}
                </span>
            </div>
        </div>
    )}
</div>
<style>
    .posters {
        position: relative;
        width: 100%;
        aspect-ratio: 610/495;
        container-type: inline-size;
    }
    .poster-glow {
        position: absolute;
        width: 85.2%;
        left: 6.6%;
        top: -2%;
        height: auto;
    }
    .poster-slot {
        position: absolute;
        width: 47.54%;
        aspect-ratio: 290/350;
    }
    .launch-slot {
        left: 4.9%;
        top: 5%;
        transform: rotate(-9deg);
    }
    .coffee-slot {
        left: 48.5%;
        top: 27%;
        transform: rotate(8deg);
    }
    .poster {
        position: relative;
        width: 100%;
        height: 100%;
        border-radius: 2.95cqw;
        overflow: hidden;
        color: var(--color-on-accent);
        font-family: var(--font-display);
        font-weight: 800;
        line-height: 1.16;
    }
    .launch-poster {
        background: var(--color-brand-yellow);
    }
    .coffee-poster {
        background: var(--color-brand-cream);
    }
    .activity-poster {
        background: var(--color-surface-card);
        color: var(--color-content-inverse);
        border: 1px solid var(--color-surface-border-subtle);
    }
    .activity-poster .poster-label,
    .activity-poster .poster-date {
        color: var(--color-brand-yellow);
    }
    .activity-poster .poster-title {
        right: 8.28%;
        font-size: 6.2cqw;
        overflow-wrap: anywhere;
    }
    .poster-rule {
        position: absolute;
        left: 8.28%;
        top: 70%;
        width: 17%;
        height: 0.9cqw;
        border-radius: 1cqw;
        background: var(--color-brand-yellow);
    }
    .poster-label {
        position: absolute;
        left: 8.28%;
        top: 6.28%;
        font-size: 1.64cqw;
    }
    .poster-title {
        position: absolute;
        left: 8.28%;
        top: 17.7%;
        font-size: 5.41cqw;
        white-space: pre-line;
    }
    .coffee-poster .poster-title {
        top: 14.85%;
        font-size: 6.56cqw;
    }
    .poster-star {
        position: absolute;
        left: 57.24%;
        top: 59.43%;
        width: 33.1%;
        height: auto;
    }
    .poster-coffee {
        position: absolute;
        left: 20%;
        top: 43.14%;
        width: 55.17%;
        height: auto;
    }
    .poster-date {
        position: absolute;
        left: 8.28%;
        top: 77.14%;
        font-size: 5.57cqw;
    }
    .poster-bottom {
        position: absolute;
        left: 8.28%;
        top: 90.28%;
        font-size: 1.8cqw;
    }
    .coffee-poster .poster-bottom {
        top: 88%;
        font-size: 1.96cqw;
    }
    .compact {
        width: 132px;
        aspect-ratio: 132/159.31;
    }
    .compact .poster-slot {
        inset: 0;
        width: 100%;
        height: 100%;
        transform: none;
    }
    .compact .poster {
        border-radius: 8px;
    }
    .compact .poster-label {
        font-size: 3.45cqw;
    }
    .compact .poster-title {
        font-size: 11.38cqw;
    }
    .compact .coffee-poster .poster-title {
        font-size: 13.79cqw;
    }
    .compact .activity-poster .poster-title {
        font-size: 12.5cqw;
    }
    .compact .poster-rule {
        height: 2.2cqw;
        border-radius: 2cqw;
    }
    .compact .poster-date {
        font-size: 11.72cqw;
    }
    .compact .poster-bottom {
        font-size: 3.79cqw;
    }
    .compact .coffee-poster .poster-bottom {
        font-size: 4.14cqw;
    }
    @media (max-width: 767px) {
        .posters:not(.compact) {
            max-width: 440px;
            margin-inline: auto;
        }
    }
</style>
