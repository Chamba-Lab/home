---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import GithubIcon from "./icons/GithubIcon.astro";
import GlobeIcon from "./icons/GlobeIcon.astro";
import LinkedinIcon from "./icons/LinkedinIcon.astro";

// Avatares locales (descargados de GitHub una vez): no se piden a terceros en cada visita.
const avatars = import.meta.glob<{ default: ImageMetadata }>(
    "../assets/team/*.jpg",
    { eager: true },
);
const svgAvatars = import.meta.glob<string>("../assets/team/*.svg", {
    eager: true,
    query: "?url",
    import: "default",
});

const members = (await getCollection("team"))
    .sort((a, b) => a.data.order - b.data.order)
    .map((member) => ({
        ...member.data,
        id: member.id,
        avatarSrc: avatars[`../assets/team/${member.data.avatar}`]?.default,
        avatarSvgSrc: svgAvatars[`../assets/team/${member.data.avatar}`],
    }));

const linkClass =
    "w-9 h-9 inline-flex items-center justify-center rounded-lg bg-slate-900/80 border border-white/10 text-slate-300 hover:text-brand-yellow hover:border-brand-yellow/40 transition-all";
---

<section class="py-20 border-t border-white/[0.06]" id="team">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-12 max-w-2xl">
            <span
                class="inline-block text-[11px] font-bold uppercase tracking-wider px-2 py-1 rounded bg-brand-yellow/15 text-brand-yellow border border-brand-yellow/30 mb-4"
                data-i18n="teamBadge"
            >
                Equipo
            </span>
            <h2
                class="font-display text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-2"
                data-i18n="teamTitle"
            >
                Quienes hacen Chamba Lab
            </h2>
            <p
                class="text-sm sm:text-base text-slate-400 leading-relaxed"
                data-i18n="teamDesc"
            >
                Voluntarios que sostienen la comunidad. Sin fines de lucro, con
                ganas.
            </p>
        </div>

        <ul class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {
                members.map((member) => (
                    <li class="card-glass rounded-2xl p-6 flex flex-col items-center text-center gap-4 border border-white/10 hover:-translate-y-0.5 transition-all duration-300">
                        {member.avatarSrc ? (
                            <Image
                                src={member.avatarSrc}
                                alt={`Foto de ${member.name}`}
                                data-i18n-alt-en={`Photo of ${member.name}`}
                                data-i18n-alt-es={`Foto de ${member.name}`}
                                width={192}
                                height={192}
                                class="w-24 h-24 rounded-full object-cover border-2 border-brand-yellow/40"
                            />
                        ) : member.avatarSvgSrc ? (
                            <img
                                src={member.avatarSvgSrc}
                                alt={`Foto de ${member.name}`}
                                data-i18n-alt-en={`Photo of ${member.name}`}
                                data-i18n-alt-es={`Foto de ${member.name}`}
                                width="192"
                                height="192"
                                class="w-24 h-24 rounded-full object-cover border-2 border-brand-yellow/40"
                            />
                        ) : (
                            <div
                                class="w-24 h-24 rounded-full bg-brand-yellow text-slate-950 flex items-center justify-center font-display text-3xl font-extrabold"
                                aria-hidden="true"
                            >
                                {member.name.charAt(0)}
                            </div>
                        )}
                        <div class="space-y-1">
                            <h3 class="font-display text-lg font-bold text-white">
                                {member.name}
                            </h3>
                            <p
                                class="text-sm text-slate-400"
                                data-i18n-en={member.role.en}
                                data-i18n-es={member.role.es ?? member.role.en}
                            >
                                {member.role.es ?? member.role.en}
                            </p>
                        </div>
                        <div class="flex items-center gap-2 mt-auto">
                            <a
                                href={member.github}
                                target="_blank"
                                rel="noopener noreferrer"
                                class={linkClass}
                                aria-label={`${member.name} - GitHub`}
                                title="GitHub"
                            >
                                <GithubIcon class="w-4 h-4" />
                            </a>
                            {member.portfolio && (
                                <a
                                    href={member.portfolio}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class={linkClass}
                                    aria-label={`${member.name} - Portfolio`}
                                    title="Portfolio"
                                >
                                    <GlobeIcon class="w-4 h-4" />
                                </a>
                            )}
                            {member.linkedin && (
                                <a
                                    href={member.linkedin}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class={linkClass}
                                    aria-label={`${member.name} - LinkedIn`}
                                    title="LinkedIn"
                                >
                                    <LinkedinIcon class="w-4 h-4" />
                                </a>
                            )}
                        </div>
                    </li>
                ))
            }
        </ul>
    </div>
</section>
