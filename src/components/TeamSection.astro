---
import { getTeamMembers } from "../lib/team";
import TeamMemberCard from "./TeamMemberCard.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

// El home muestra solo al equipo fundador; el resto vive en /team y escala ahí.
const founders = (await getTeamMembers()).filter(
    (m) => m.tier === "founder" || m.tier === "cofounder",
);
---

<section class="py-20 border-t border-white/[0.06]" id="team">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-12 max-w-2xl">
            <span
                class="inline-block text-[11px] font-bold uppercase tracking-wider px-2 py-1 rounded bg-brand-yellow/15 text-brand-yellow border border-brand-yellow/30 mb-4"
                data-i18n="teamBadge"
            >
                Equipo
            </span>
            <h2
                class="font-display text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-2"
                data-i18n="teamTitle"
            >
                Quienes hacen Chamba Lab
            </h2>
            <p
                class="text-sm sm:text-base text-slate-400 leading-relaxed"
                data-i18n="teamDesc"
            >
                Voluntarios que sostienen la comunidad. Sin fines de lucro, con
                ganas.
            </p>
        </div>

        <ul class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {founders.map((member) => <TeamMemberCard member={member} />)}
        </ul>

        <div class="mt-10">
            <a
                href={`${base}team`}
                class="inline-flex items-center gap-2 text-sm font-bold text-brand-yellow hover:text-amber-300 transition-colors"
            >
                <span data-i18n="viewFullTeam">Conoce a todo el equipo</span>
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
            </a>
        </div>
    </div>
</section>
