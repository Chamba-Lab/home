---
// Video corto en bucle para entradas del blog (en lugar de un GIF). Se
// reproduce solo y sin sonido; con movimiento reducido (o sin JavaScript) no
// arranca y muestra los controles. Los archivos van en
// public/blog/<entrada>/ porque Astro no optimiza video.
interface Props {
    /** Ruta del mp4, por ejemplo "/blog/mi-entrada/demo.mp4". */
    src: string;
    /** Ruta opcional de la misma pieza en webm (más liviana). */
    webm?: string;
    /** Descripción corta del video, para lectores de pantalla. */
    title: string;
    /** Ruta opcional de la imagen que se ve antes de reproducir. */
    poster?: string;
}

const { src, webm, title, poster } = Astro.props;
---

<figure class="clip">
    <div class="zoom-wrap">
        <video
            data-clip
            muted
            loop
            playsinline
            controls
            preload="metadata"
            poster={poster}
            aria-label={title}
        >
            {webm && <source src={webm} type="video/webm" />}
            <source src={src} type="video/mp4" />
        </video>
        <button
            type="button"
            class="zoom-btn"
            data-zoom-btn="video"
            aria-label="Ampliar video"
            data-i18n-aria-label-es="Ampliar video"
            data-i18n-aria-label-en="Enlarge video"
        >
            <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path>
            </svg>
        </button>
    </div>
    <figcaption>{title}</figcaption>
</figure>

<style>
    .clip {
        margin: 2rem 0;
    }
    /* Un clip vertical no puede ocupar más de una pantalla: se limita el alto y
       el ancho sigue la proporción del video. */
    video {
        display: block;
        width: auto;
        max-width: 100%;
        max-height: min(32rem, 70vh);
        height: auto;
        margin: 0 auto;
        border-radius: 1rem;
        border: 1px solid var(--color-surface-border-subtle);
        background: var(--color-surface-subtle);
    }
    figcaption {
        margin-top: 0.75rem;
        font-size: 0.875rem;
        color: var(--color-muted);
        text-align: center;
    }
</style>

<script>
    const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    if (!reduceMotion) {
        document
            .querySelectorAll<HTMLVideoElement>("[data-clip]")
            .forEach((video) => {
                video.controls = false;
                video.play().catch(() => {
                    // El navegador no permitió el autoplay: se dejan los controles.
                    video.controls = true;
                });
            });
    }
</script>
