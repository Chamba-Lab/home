---
// Enlace de las entradas del blog. Se ofrece a MDX como `a`, así que todos los
// enlaces de Markdown pasan por aquí: los que van a otros sitios se abren en
// una pestaña nueva (con noopener y noreferrer); los internos, no. Los que
// apuntan a GitHub, YouTube o al portafolio de alguien del equipo llevan además
// una insignia con su icono (estilos en src/pages/blog/[id].astro). El
// portafolio sale de team.json: con `logo` usa el logo personal y, si no, un
// globo.
import GlobeIcon from "../icons/GlobeIcon.astro";
import { isExternalUrl, linkKind, matchPortfolio } from "../../lib/links";
import { getTeamMembers } from "../../lib/team";

const { href, target, rel, ...rest } = Astro.props;
const external = isExternalUrl(href);
const platform = linkKind(href);
const owner = platform
    ? undefined
    : matchPortfolio(href, await getTeamMembers());
const kind = platform ?? (owner ? "portfolio" : undefined);
---

<a
    href={href}
    target={external ? "_blank" : target}
    rel={external ? "noopener noreferrer" : rel}
    data-kind={kind}
    {...rest}
>
    {kind === "youtube" ? (
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
            <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z" />
        </svg>
    ) : kind === "portfolio" ? (
        owner?.logoSrc ? (
            <img src={owner.logoSrc} alt="" width="16" height="16" />
        ) : (
            <GlobeIcon />
        )
    ) : kind ? (
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
            <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
        </svg>
    ) : null}
    <slot />
</a>
