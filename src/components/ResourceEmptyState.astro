---
// Sin resultados: la hámster buscó por todas partes. Repite lo que se buscó,
// sugiere categorías y deja proponer ese recurso (la plantilla de issue con
// lo buscado como título) o limpiar la búsqueda. Lo muestra el script de
// ResourceSearch, que también rellena lo buscado.
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import hamster from "../assets/scenes/hamster-shrug.webp";
import { RESOURCE_PROPOSAL_URL } from "../lib/constants";
import { categoryPath, groupByCategory } from "../lib/resources";

interface Props {
    /** Categoría actual, que no se sugiere. */
    exclude?: string;
}

const { exclude } = Astro.props;

// Las tres categorías con más recursos (sin la actual).
const resources = (await getCollection("resources")).map((r) => r.data);
const suggestions = groupByCategory(resources)
    .filter(({ category }) => category.id !== exclude)
    .sort((a, b) => b.items.length - a.items.length)
    .slice(0, 3)
    .map(({ category }) => category);
---

<div
    id="resources-empty"
    hidden
    class="resources-empty card-glass my-12 flex flex-col items-center gap-6 rounded-[20px] border border-white/[0.08] p-6 text-center sm:flex-row sm:items-center sm:gap-10 sm:p-10 sm:text-left"
>
    <Image
        src={hamster}
        alt=""
        aria-hidden="true"
        width={220}
        densities={[1, 2]}
        class="h-auto w-36 shrink-0 sm:w-[220px]"
    />
    <div class="flex max-w-[560px] flex-col gap-3">
        <h2
            class="font-display text-2xl font-extrabold text-white"
            data-i18n-es="La hámster buscó por todas partes"
            data-i18n-en="The hamster searched everywhere"
        >
            La hámster buscó por todas partes
        </h2>
        <p class="text-[15px] leading-relaxed text-slate-300">
            <span
                data-i18n-es="No hay recursos con"
                data-i18n-en="No resources match"
            >
                No hay recursos con
            </span>{" "}
            «<span data-empty-query></span>».{" "}
            <span
                data-i18n-es="Prueba con otra palabra, revisa una categoría o propón el recurso: si cumple los criterios, lo sumamos."
                data-i18n-en="Try another word, browse a category or suggest the resource: if it meets the criteria, we'll add it."
            >
                Prueba con otra palabra, revisa una categoría o propón el
                recurso: si cumple los criterios, lo sumamos.
            </span>
        </p>
        <ul
            class="flex flex-wrap justify-center gap-2 sm:justify-start"
            aria-label="Categorías"
            data-i18n-aria-label-es="Categorías"
            data-i18n-aria-label-en="Categories"
        >
            {suggestions.map((category) => (
                <li>
                    <a
                        href={categoryPath(category.id)}
                        class="inline-flex rounded-full border border-white/15 px-3 py-1.5 text-xs font-medium text-slate-300 transition-colors hover:border-white/30 hover:text-white"
                        data-i18n-es={category.label.es}
                        data-i18n-en={category.label.en}
                    >
                        {category.label.es}
                    </a>
                </li>
            ))}
        </ul>
        <div class="mt-2 flex flex-wrap justify-center gap-2.5 sm:justify-start">
            <a
                href={RESOURCE_PROPOSAL_URL}
                data-propose-query
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-[10px] bg-brand-yellow px-4 py-2.5 text-sm font-semibold text-slate-950 transition-colors hover:bg-brand-yellow-hover"
            >
                <span
                    data-i18n-es="Proponer este recurso"
                    data-i18n-en="Suggest this resource"
                >
                    Proponer este recurso
                </span>
                <span aria-hidden="true">↗</span>
            </a>
            <button
                type="button"
                data-clear-filters
                class="rounded-[10px] border border-white/15 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:border-white/30"
                data-i18n-es="Limpiar búsqueda"
                data-i18n-en="Clear search"
            >
                Limpiar búsqueda
            </button>
        </div>
    </div>
</div>
