---
/**
 * El cuarto del dueño de una categoría, detrás de su cabecera (título,
 * descripción y buscador). En escritorio (≥ 1280 px) el cuarto ocupa la
 * derecha y se funde hacia el texto; por debajo es una franja arriba.
 *
 * Cada cuarto tiene su variante de Navidad. Aprendizaje es el cuarto real de
 * Bunny y además cambia con la hora de Lima: de día la tarde dorada y desde
 * las 7 p. m., de noche con la pantalla encendida.
 */
import type { ImageMetadata } from "astro";
import SeasonalImage from "./SeasonalImage.astro";
import type { SeasonVariants } from "../../lib/scenes";

interface Props {
    category: string;
}

const { category } = Astro.props;

const files = import.meta.glob<ImageMetadata>(
    "../../assets/scenes/rooms/*.webp",
    { eager: true, import: "default" },
);

/** `<nombre>.webp` rige todo el año y `<nombre>-christmas.webp`, en Navidad. */
function variantsOf(name: string): SeasonVariants<ImageMetadata> {
    const at = (file: string) =>
        files[`../../assets/scenes/rooms/${file}.webp`];
    const base = at(name);
    if (!base) {
        throw new Error(`Falta el cuarto src/assets/scenes/rooms/${name}.webp`);
    }
    const christmas = at(`${name}-christmas`);
    return christmas ? { default: base, christmas } : { default: base };
}

// Aprendizaje (Bunny) tiene una escena de día y otra de noche.
const dayparts =
    category === "learning"
        ? {
              day: variantsOf("learning-day"),
              night: variantsOf("learning-night"),
          }
        : null;
const variants = dayparts ? null : variantsOf(category);

const image = {
    widths: [536, 1072, 1320, 1600],
    sizes: "(min-width: 1280px) min(1320px, 92vw), (min-width: 640px) 100vw, 536px",
    imgClass: "category-room__img",
};
---

<div class="category-room" aria-hidden="true">
    {variants && (
        <SeasonalImage
            variants={variants}
            {...image}
            class="category-room__scene"
            loading="eager"
            fetchpriority="high"
        />
    )}
    {dayparts && (
        <div
            class="category-room__scene"
            data-daypart-slot
            data-daypart-current="none"
        >
            {(["day", "night"] as const).map((part) => (
                <template data-daypart={part}>
                    <SeasonalImage
                        variants={dayparts[part]}
                        {...image}
                        class="category-room__fill"
                        loading="eager"
                        fetchpriority="high"
                    />
                </template>
            ))}
        </div>
    )}
</div>

<script>
    import { applyDaypart, daypartFor, limaHour } from "../../lib/scenes";
    import { currentSeason } from "../../lib/seasons";

    // La hora de quien visita no se sabe en el build: aquí se elige la escena.
    applyDaypart(document, daypartFor(limaHour()), currentSeason());
</script>

<style is:global>
    /* Móvil y tableta: franja del cuarto bajo el header; el contenido sube
       80 px sobre su fundido. */
    .category-room {
        position: relative;
        height: 230px;
        margin-bottom: -80px;
        overflow: hidden;
        pointer-events: none;
    }

    .category-room__scene {
        position: absolute;
        inset: 0;
        -webkit-mask-image: linear-gradient(
            to bottom,
            rgb(0 0 0 / 0.75) 0%,
            #000 55%,
            transparent 100%
        );
        mask-image: linear-gradient(
            to bottom,
            rgb(0 0 0 / 0.75) 0%,
            #000 55%,
            transparent 100%
        );
    }

    .category-room__fill,
    .category-room__scene picture {
        display: block;
        height: 100%;
        width: 100%;
    }

    .category-room__img {
        display: block;
        height: 100%;
        width: 100%;
        object-fit: cover;
        /* El dueño suele estar a la derecha del cuarto. */
        object-position: 87% 50%;
    }

    @media (min-width: 640px) {
        .category-room {
            height: 300px;
        }

        .category-room__img {
            object-position: 70% 50%;
        }
    }

    /* Escritorio: el cuarto a la derecha, como en Figma a 1440 (x 300,
       1320 × 567); por debajo de 1440 se escala con el ancho. */
    @media (min-width: 1280px) {
        .category-room {
            position: absolute;
            inset-inline: 0;
            top: 0;
            height: 620px;
            margin-bottom: 0;
        }

        .category-room__scene {
            inset: auto;
            top: -10px;
            left: max(calc(50% - 420px), 20.833vw);
            width: min(1320px, 91.667vw);
            aspect-ratio: 1320 / 567;
            /* El velo del texto y el fundido inferior de Figma, como máscara:
               se ve el fondo de la página (y el brillo de la categoría). */
            --room-fade-x: linear-gradient(
                to right,
                rgb(0 0 0 / 0.065) 0%,
                rgb(0 0 0 / 0.1) 23.1%,
                rgb(0 0 0 / 0.65) 44.9%,
                #000 58%,
                #000 86%,
                transparent 100%
            );
            --room-fade-y: linear-gradient(
                to bottom,
                #000 78%,
                transparent 97%
            );
            -webkit-mask-image: var(--room-fade-x), var(--room-fade-y);
            -webkit-mask-composite: source-in;
            mask-image: var(--room-fade-x), var(--room-fade-y);
            mask-composite: intersect;
        }

        .category-room__img {
            object-position: 50% 50%;
        }
    }
</style>
