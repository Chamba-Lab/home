---
/**
 * Escena de fondo con las medidas de Figma: detrás del título de una página
 * (equipo, dinámicas, blog…), del pie o de una sección. Recibe dónde va la
 * escena en el marco de Figma (x, y, ancho y alto en px) y sus velos, que se
 * convierten en máscara (ver `src/lib/veils.ts`).
 *
 * - `desktop`: marco de 1440 px centrado, desde 1280 px de ancho.
 * - `mobile`: marco de 390 px centrado, por debajo de 1280 px. Sin `mobile`,
 *   en móvil no hay escena (o va como franja, `SceneStrip`).
 *
 * Se posiciona respecto de su contenedor posicionado más cercano (o de la
 * página) y va detrás del contenido (`z-index: -1`). Lo que se pase como hijo
 * (un personaje como capa aparte) se coloca en px del marco de escritorio.
 * Cada variante solo se descarga en su ancho (`loading="lazy"` y oculta en el
 * otro).
 */
import type { ImageMetadata } from "astro";
import SeasonalImage from "./SeasonalImage.astro";
import type { SeasonVariants } from "../../lib/scenes";
import { veilMask, type Veil } from "../../lib/veils";

interface Geometry {
    x: number;
    y: number;
    w: number;
    h: number;
    veils?: Veil[];
}

interface Props {
    variants: SeasonVariants<ImageMetadata>;
    desktop?: Geometry;
    mobile?: Geometry;
    class?: string;
}

const { variants, desktop, mobile, class: className } = Astro.props;

/** Posición y máscara de la escena en un marco de `frame` px de ancho. */
function sceneStyle(g: Geometry, frame: number) {
    const masks = [
        veilMask(g.veils ?? [], "x", g.x, g.w),
        veilMask(g.veils ?? [], "y", g.y, g.h),
    ].filter((m) => m !== "none");
    // Los lados que tocan el borde del marco se funden cuando la pantalla es
    // más ancha que el marco (ver el CSS).
    const left = g.x <= 0 ? "transparent 0, #000 160px" : "#000 0";
    const right =
        g.x + g.w >= frame
            ? "#000 calc(100% - 160px), transparent 100%"
            : "#000 100%";
    return [
        `left: ${g.x}px`,
        `top: ${g.y}px`,
        `width: ${g.w}px`,
        `height: ${g.h}px`,
        `--sb-mask: ${masks.length ? masks.join(", ") : "linear-gradient(#000, #000)"}`,
        `--sb-sides: linear-gradient(to right, ${left}, ${right})`,
    ].join("; ");
}
---

<div class:list={["scene-backdrop", className]} aria-hidden="true">
    {desktop && (
        <div class="scene-backdrop__frame scene-backdrop__frame--desktop">
            <SeasonalImage
                variants={variants}
                widths={[800, 1200, 1600]}
                sizes={`${desktop.w}px`}
                class="scene-backdrop__scene"
                style={sceneStyle(desktop, 1440)}
                imgClass="scene-backdrop__img"
            />
            <slot />
        </div>
    )}
    {mobile && (
        <div class="scene-backdrop__frame scene-backdrop__frame--mobile">
            <SeasonalImage
                variants={variants}
                widths={[600, 900, 1200]}
                sizes={`${mobile.w}px`}
                class="scene-backdrop__scene"
                style={sceneStyle(mobile, 390)}
                imgClass="scene-backdrop__img"
            />
        </div>
    )}
</div>

<style is:global>
    .scene-backdrop {
        position: absolute;
        z-index: -1;
        inset-inline: 0;
        top: 0;
        height: 0;
        /* La escena sale del marco por los lados: se recorta en horizontal
           sin cortar lo que baja. */
        overflow-x: clip;
        overflow-y: visible;
        pointer-events: none;
    }

    .scene-backdrop__frame {
        position: absolute;
        top: 0;
        left: calc(50% - 720px);
        width: 1440px;
    }

    .scene-backdrop__frame--mobile {
        left: calc(50% - 195px);
        width: 390px;
    }

    .scene-backdrop__scene {
        position: absolute;
        -webkit-mask-image: var(--sb-mask);
        mask-image: var(--sb-mask);
        -webkit-mask-composite: source-in;
        mask-composite: intersect;
    }

    .scene-backdrop__scene picture {
        display: block;
        height: 100%;
    }

    .scene-backdrop__img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .scene-backdrop__frame--desktop {
        display: none;
    }

    @media (min-width: 1280px) {
        .scene-backdrop__frame--desktop {
            display: block;
        }

        .scene-backdrop__frame--mobile {
            display: none;
        }
    }

    /* Pantalla más ancha que el marco: se funden los lados que llegaban al
       borde (si no, se vería el corte de la imagen). */
    @media (min-width: 1500px) {
        .scene-backdrop__frame--desktop .scene-backdrop__scene {
            -webkit-mask-image: var(--sb-mask), var(--sb-sides);
            mask-image: var(--sb-mask), var(--sb-sides);
        }
    }

    @media (min-width: 440px) and (max-width: 1279px) {
        .scene-backdrop__frame--mobile .scene-backdrop__scene {
            -webkit-mask-image: var(--sb-mask), var(--sb-sides);
            mask-image: var(--sb-mask), var(--sb-sides);
        }
    }
</style>
