---
import { Image } from "astro:assets";
import { TIER_LABEL, type TeamMember } from "../lib/team";
import GithubIcon from "./icons/GithubIcon.astro";
import GlobeIcon from "./icons/GlobeIcon.astro";
import LinkedinIcon from "./icons/LinkedinIcon.astro";

interface Props {
    member: TeamMember;
    // "full": tarjeta centrada con avatar y enlaces (fundadores y core team).
    // "row": fila con avatar, nombre y enlaces (contributors).
    // "chip": solo avatar, enlaza a GitHub (miembros; escala a muchas personas).
    variant?: "full" | "row" | "chip";
}

const { member, variant = "full" } = Astro.props;
const title = TIER_LABEL[member.tier];
const founding = member.tier === "founder" || member.tier === "cofounder";

const linkClass =
    "w-9 h-9 inline-flex items-center justify-center rounded-lg bg-slate-900/80 border border-white/10 text-slate-300 hover:text-brand-yellow hover:border-brand-yellow/40 transition-all";

// Tamaño del avatar (px de origen = 2x el mostrado, para pantallas retina).
const avatar = {
    full: { box: "w-20 h-20", px: 160, text: "text-2xl" },
    row: { box: "w-16 h-16", px: 128, text: "text-xl" },
    chip: { box: "w-12 h-12", px: 96, text: "text-base" },
}[variant];
// Fundadores con aro dorado marcado y resplandor; el resto, más sutil.
const ring = founding
    ? "border-brand-yellow/70 shadow-[0_0_18px_rgba(250,204,21,0.18)]"
    : variant === "full"
      ? "border-white/25"
      : "border-brand-yellow/30";
const avatarClass = `${avatar.box} shrink-0 rounded-full object-cover border-2 ${ring}`;
const chipHover =
    "transition-all duration-200 group-hover:border-brand-yellow group-hover:scale-110";
---

{
    variant === "chip" ? (
        <li class="group relative">
            <a
                href={member.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${member.name} - GitHub`}
                class="block rounded-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-yellow"
            >
                {member.avatarSrc ? (
                    <Image
                        src={member.avatarSrc}
                        alt=""
                        width={avatar.px}
                        height={avatar.px}
                        loading="lazy"
                        class={`${avatarClass} ${chipHover}`}
                    />
                ) : (
                    <div
                        class={`${avatarClass} ${chipHover} bg-brand-yellow text-slate-950 flex items-center justify-center font-display ${avatar.text} font-extrabold`}
                        aria-hidden="true"
                    >
                        {member.name.charAt(0)}
                    </div>
                )}
            </a>
            <span
                role="tooltip"
                aria-hidden="true"
                class="pointer-events-none absolute left-1/2 -top-9 z-10 -translate-x-1/2 whitespace-nowrap rounded-md border border-white/10 bg-slate-900 px-2 py-1 text-xs font-semibold text-white opacity-0 shadow-lg transition-opacity group-hover:opacity-100 group-focus-within:opacity-100"
            >
                {member.name}
            </span>
        </li>
    ) : (
        <li
            class:list={[
                "card-glass rounded-2xl border border-white/10 hover:-translate-y-0.5 transition-all duration-300",
                variant === "row"
                    ? "p-4 flex items-center gap-4"
                    : "p-5 flex flex-col items-center text-center gap-3",
            ]}
        >
            {member.avatarSrc ? (
                <Image
                    src={member.avatarSrc}
                    alt={`Foto de ${member.name}`}
                    data-i18n-alt-en={`Photo of ${member.name}`}
                    data-i18n-alt-es={`Foto de ${member.name}`}
                    width={avatar.px}
                    height={avatar.px}
                    class={avatarClass}
                />
            ) : (
                <div
                    class={`${avatarClass} bg-brand-yellow text-slate-950 flex items-center justify-center font-display ${avatar.text} font-extrabold`}
                    aria-hidden="true"
                >
                    {member.name.charAt(0)}
                </div>
            )}
            <div
                class:list={[
                    "space-y-0.5",
                    variant === "row" && "min-w-0 flex-1",
                ]}
            >
                <h3
                    class:list={[
                        "font-display font-bold text-white text-base",
                        variant === "row" && "truncate",
                    ]}
                >
                    {member.name}
                </h3>
                <p
                    class="text-sm text-slate-400"
                    data-i18n-en={title.en}
                    data-i18n-es={title.es}
                >
                    {title.es}
                </p>
            </div>
            <div
                class:list={[
                    "flex items-center gap-2",
                    variant === "full" && "mt-auto",
                ]}
            >
                <a
                    href={member.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={linkClass}
                    aria-label={`${member.name} - GitHub`}
                    title="GitHub"
                >
                    <GithubIcon class="w-4 h-4" />
                </a>
                {member.portfolio && (
                    <a
                        href={member.portfolio}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={linkClass}
                        aria-label={`${member.name} - Portfolio`}
                        title="Portfolio"
                    >
                        {member.logoSrc ? (
                            <img
                                src={member.logoSrc}
                                alt=""
                                width="20"
                                height="20"
                                loading="lazy"
                                class="w-5 h-5 object-contain"
                            />
                        ) : (
                            <GlobeIcon class="w-4 h-4" />
                        )}
                    </a>
                )}
                {member.linkedin && (
                    <a
                        href={member.linkedin}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={linkClass}
                        aria-label={`${member.name} - LinkedIn`}
                        title="LinkedIn"
                    >
                        <LinkedinIcon class="w-4 h-4" />
                    </a>
                )}
            </div>
        </li>
    )
}
