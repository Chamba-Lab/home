---
import { TIER_LABEL, type TeamMember } from "../lib/team";
import TeamAvatar from "./TeamAvatar.astro";
import GithubIcon from "./icons/GithubIcon.astro";
import GlobeIcon from "./icons/GlobeIcon.astro";
import LinkedinIcon from "./icons/LinkedinIcon.astro";

interface Props {
    member: TeamMember;
    // "full": tarjeta centrada con avatar y enlaces (fundadores, core team y contributors: mismo diseño).
    // "chip": solo avatar, enlaza a GitHub (miembros; escala a muchas personas).
    variant?: "full" | "row" | "chip";
}

const { member, variant = "full" } = Astro.props;
const title = TIER_LABEL[member.tier];

// Variantes compactas (core team y contributors): enlaces más pequeños.
const small = variant !== "full";
const linkClass =
    (small ? "w-8 h-8" : "w-9 h-9") +
    " inline-flex items-center justify-center rounded-lg bg-slate-900/80 border border-white/10 text-slate-300 hover:text-brand-yellow hover:border-brand-yellow/40 transition-all";

// Tamaño mostrado del avatar en px (TeamAvatar lo pide al doble, para retina).
const avatar = {
    full: { box: "w-20 h-20", px: 80, text: "text-2xl" },
    row: { box: "w-12 h-12", px: 48, text: "text-lg" },
    chip: { box: "w-12 h-12", px: 48, text: "text-base" },
}[variant];
const shell = {
    full: "card-glass rounded-2xl border border-white/10 p-5 flex flex-col items-center text-center gap-3 hover:-translate-y-0.5 transition-all duration-300",
    row: "card-glass rounded-xl border border-white/10 p-3 flex items-center gap-3 hover:-translate-y-0.5 transition-all duration-300",
    chip: "",
}[variant];
const avatarClass = `${avatar.box} shrink-0 rounded-full border-2 border-white/25`;
const chipHover =
    "transition-all duration-200 group-hover:border-white/60 group-hover:scale-110";
---

{
    variant === "chip" ? (
        <li class="group relative">
            <a
                href={member.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${member.name} - GitHub`}
                class="block rounded-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-yellow"
            >
                <TeamAvatar
                    member={member}
                    px={avatar.px}
                    textClass={avatar.text}
                    class={`${avatarClass} ${chipHover}`}
                />
            </a>
            <span
                role="tooltip"
                aria-hidden="true"
                class="pointer-events-none absolute left-1/2 -top-9 z-10 -translate-x-1/2 whitespace-nowrap rounded-md border border-white/10 bg-slate-900 px-2 py-1 text-xs font-semibold text-white opacity-0 shadow-lg transition-opacity group-hover:opacity-100 group-focus-within:opacity-100"
            >
                {member.name}
            </span>
        </li>
    ) : (
        <li class={shell}>
            <TeamAvatar
                member={member}
                px={avatar.px}
                textClass={avatar.text}
                labelled
                class={avatarClass}
            />
            <div
                class:list={[
                    "space-y-0.5",
                    variant === "row" && "min-w-0 flex-1",
                ]}
            >
                <h3
                    class:list={[
                        "font-display font-bold text-white",
                        small ? "text-sm" : "text-base",
                        variant === "row" && "truncate",
                    ]}
                >
                    {member.name}
                </h3>
                <p
                    class:list={[
                        "text-slate-400",
                        small ? "text-xs" : "text-sm",
                    ]}
                    data-i18n-en={title.en}
                    data-i18n-es={title.es}
                >
                    {title.es}
                </p>
            </div>
            <div
                class:list={[
                    "flex items-center",
                    small ? "gap-1.5" : "gap-2",
                    variant !== "row" && "mt-auto",
                ]}
            >
                <a
                    href={member.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={linkClass}
                    aria-label={`${member.name} - GitHub`}
                    title="GitHub"
                >
                    <GithubIcon class="w-4 h-4" />
                </a>
                {member.portfolio && (
                    <a
                        href={member.portfolio}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={linkClass}
                        aria-label={`${member.name} - Portfolio`}
                        title="Portfolio"
                    >
                        {member.logoSrc ? (
                            <img
                                src={member.logoSrc}
                                alt=""
                                width="20"
                                height="20"
                                loading="lazy"
                                class="w-5 h-5 object-contain"
                            />
                        ) : (
                            <GlobeIcon class="w-4 h-4" />
                        )}
                    </a>
                )}
                {member.linkedin && (
                    <a
                        href={member.linkedin}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={linkClass}
                        aria-label={`${member.name} - LinkedIn`}
                        title="LinkedIn"
                    >
                        <LinkedinIcon class="w-4 h-4" />
                    </a>
                )}
            </div>
        </li>
    )
}
