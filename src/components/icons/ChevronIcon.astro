---
interface Props {
    direction?: "left" | "right";
    class?: string;
}

const { direction = "right", class: className = "w-4 h-4" } = Astro.props;
const d =
    direction === "left"
        ? "M15.75 19.5 8.25 12l7.5-7.5"
        : "m8.25 4.5 7.5 7.5-7.5 7.5";
---

<svg
    class={className}
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="2"
    stroke="currentColor"
    aria-hidden="true"
>
    <path stroke-linecap="round" stroke-linejoin="round" d={d}></path>
</svg>
