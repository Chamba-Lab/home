---
interface Props {
    class?: string;
    [key: string]: unknown;
}

const { class: className = "w-4 h-4", ...rest } = Astro.props;
---

<svg
    class={className}
    {...rest}
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="2"
    stroke="currentColor"
    aria-hidden="true"
>
    <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 1020.354 15.354z"
    ></path>
</svg>
