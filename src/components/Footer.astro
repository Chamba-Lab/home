---
import {
    CODE_OF_CONDUCT_URL,
    CONTRIBUTING_URL,
    DISCORD_URL,
    GITHUB_URL,
    LINKEDIN_URL,
} from "../lib/constants";
import DiscordIcon from "./icons/DiscordIcon.astro";
import GithubIcon from "./icons/GithubIcon.astro";
import LinkedinIcon from "./icons/LinkedinIcon.astro";
import BrandTile from "./BrandTile.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/[0.08] bg-[#050811] mt-auto py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8 pb-10 border-b border-white/[0.06]">
            <div class="flex flex-col gap-3">
                <a href={base} class="flex items-center gap-3 group">
                    <BrandTile class="w-9 h-9 rounded-xl brand-tile-shadow transition-transform group-hover:scale-105" />
                    <span class="font-display text-xl font-extrabold tracking-tight text-white">
                        Chamba
                    </span>
                    <span class="text-[10px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded badge-lab">
                        Lab
                    </span>
                </a>
                <p
                    class="text-xs text-slate-400 max-w-sm leading-relaxed"
                    data-i18n="footerDesc"
                >
                    Comunidad tech para conectar, inspirarte y crecer. Nos
                    encontramos en Discord.
                </p>
            </div>

            <!-- Clean Nav Links -->
            <nav class="flex flex-wrap items-center gap-6 text-sm font-medium">
                <a
                    href={`${base}resources/`}
                    data-i18n="navResources"
                    class="text-slate-400 hover:text-white transition-colors"
                >
                    Recursos
                </a>
                <a
                    href={`${base}events/`}
                    data-i18n="navEvents"
                    class="text-slate-400 hover:text-white transition-colors"
                >
                    Eventos
                </a>
                <a
                    href={`${base}activities/`}
                    data-i18n="navActivities"
                    class="text-slate-400 hover:text-white transition-colors"
                >
                    Dinámicas
                </a>
            </nav>
        </div>

        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
            <p>
                &copy; {currentYear} Chamba Lab.{" "}
                <span data-i18n="allRightsReserved">
                    Todos los derechos reservados.
                </span>
            </p>
            <div class="flex flex-wrap items-center justify-center gap-4">
                <a
                    href={CONTRIBUTING_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-i18n="footerContribute"
                    class="text-slate-400 hover:text-white transition-colors"
                >
                    Contribuir
                </a>
                <a
                    href={CODE_OF_CONDUCT_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-i18n="footerConduct"
                    class="text-slate-400 hover:text-white transition-colors"
                >
                    Código de conducta
                </a>
                <a
                    href={DISCORD_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-slate-400 hover:text-white transition-colors"
                    aria-label="Discord"
                >
                    <DiscordIcon class="w-4 h-4" />
                </a>
                <a
                    href={GITHUB_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-slate-400 hover:text-white transition-colors"
                    aria-label="GitHub"
                >
                    <GithubIcon class="w-4 h-4" />
                </a>
                <a
                    href={LINKEDIN_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-slate-400 hover:text-white transition-colors"
                    aria-label="LinkedIn"
                >
                    <LinkedinIcon class="w-4 h-4" />
                </a>
            </div>
        </div>
    </div>
</footer>
