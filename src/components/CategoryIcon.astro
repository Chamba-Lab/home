---
// Icono de una categoría de recursos dentro de un recuadro del color de la
// categoría. El trazo sale del catálogo en `src/lib/resources.ts` y los colores
// de la paleta `[data-category]` de `src/styles/global.css`.
interface Props {
    category: { id: string; iconPath: string };
    class?: string;
    // view-transition-name para la transición entre /resources y la categoría.
    transitionName?: string;
}

const {
    category,
    class: className = "h-12 w-12",
    transitionName,
} = Astro.props;
---

<span
    data-category={category.id}
    class={`inline-flex shrink-0 items-center justify-center rounded-xl border border-(--cat-border) bg-(--cat-tint) text-(--cat-accent) ${className}`}
    style={
        transitionName ? `view-transition-name: ${transitionName}` : undefined
    }
    aria-hidden="true"
>
    <svg
        class="h-[50%] w-[50%]"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
    >
        <path d={category.iconPath}></path>
    </svg>
</span>
