---
/**
 * Escenas por festividad del widget de Discord. Se pintan todos los perfiles
 * y el CSS muestra solo el que marca `data-season` en `#discord-widget` (ver
 * `src/lib/seasons.ts`). Va detrás del contenido, sin eventos ni lectura de
 * pantalla.
 *
 * Cada escena tiene un reposo estático y un "momento" animado de 5 s como
 * máximo (WCAG 2.2.2) al entrar en pantalla y al pasar el ratón por la
 * tarjeta. Con `prefers-reduced-motion` solo se ve el reposo.
 */

// Murciélago de frente: cuerpo y cabeza fijos, alas aparte para aletear.
const BAT = `
    <path class="wing wing-l" d="M18 9.5Q12 3.5 1 6.5q4 1.8 4.2 5.6 2.6-1.8 5 0 1.9-1.8 4.3.8 1.6-1.6 3.5-.4z"/>
    <path class="wing wing-r" d="M22 9.5q6-6 17-3-4 1.8-4.2 5.6-2.6-1.8-5 0-1.9-1.8-4.3.8-1.6-1.6-3.5-.4z"/>
    <path d="M17.6 4.2 18.6 7a2.6 2.6 0 0 1 2.8 0l1-2.8.6 3.6a2.6 2.6 0 0 1-.2 1.6c1 1 1.5 2.3 1.5 3.8 0 2.4-1.6 4.8-4.3 6.3-2.7-1.5-4.3-3.9-4.3-6.3 0-1.5.5-2.8 1.5-3.8a2.6 2.6 0 0 1-.2-1.6z"/>
`;

// Bandada: sale de la luna. Los dos primeros son los murciélagos del reposo
// que despegan desde donde estaban; el resto nace pequeño en la luna y crece al
// acercarse. Tamaño final (px), escala inicial, trayectoria (px desde la
// esquina superior izquierda; el centro del murciélago la sigue), duración y
// retraso (s), opacidad inicial y final, desenfoque. Lo último acaba a los 4,4 s.
const flock = [
    {
        size: 36,
        s0: 0.72,
        path: "M33 20.5C110 0 200 90 440 60",
        dur: 3,
        delay: 0,
        o0: 1,
        o: 0.95,
        blur: 0,
    },
    {
        size: 26,
        s0: 0.58,
        path: "M59.5 37.8C130 70 220 40 440 150",
        dur: 3.2,
        delay: 0.2,
        o0: 1,
        o: 0.9,
        blur: 0,
    },
    {
        size: 17,
        s0: 0.3,
        path: "M20 12C120 40 180 170 440 210",
        dur: 3.4,
        delay: 0.5,
        o0: 0,
        o: 0.6,
        blur: 0.6,
    },
    {
        size: 24,
        s0: 0.3,
        path: "M20 12C90 90 250 120 450 270",
        dur: 3.1,
        delay: 0.7,
        o0: 0,
        o: 0.85,
        blur: 0,
    },
    {
        size: 15,
        s0: 0.3,
        path: "M20 12C140 -10 260 30 440 24",
        dur: 3.2,
        delay: 0.95,
        o0: 0,
        o: 0.5,
        blur: 0.8,
        extra: true,
    },
    {
        size: 31,
        s0: 0.3,
        path: "M20 12C60 160 220 220 460 330",
        dur: 3,
        delay: 1.2,
        o0: 0,
        o: 0.9,
        blur: 0,
        extra: true,
    },
];

// Nieve acumulada en el borde superior: más gruesa en las esquinas, con
// ondas irregulares y algunos carámbanos. Coordenadas en un ancho de 400.
const thickness = (x: number) => {
    const edge =
        Math.max(0, 1 - x / 80) ** 1.6 + Math.max(0, 1 - (400 - x) / 80) ** 1.6;
    const wobble = Math.sin(x * 0.045) * 1.6 + Math.sin(x * 0.11 + 1) * 0.8;
    return 5.5 + edge * 10 + wobble;
};
const capPath = (offset: number) => {
    let d = `M0 0H400V${(thickness(400) + offset).toFixed(1)}`;
    for (let x = 384; x >= 0; x -= 16) {
        const cx = x + 8;
        d += `Q${cx} ${(thickness(cx) + offset + 1.6).toFixed(1)} ${x} ${(thickness(x) + offset).toFixed(1)}`;
    }
    return d + "Z";
};
const icicles = [
    { x: 44, len: 10 },
    { x: 55, len: 6 },
    { x: 174, len: 7 },
    { x: 270, len: 8 },
    { x: 350, len: 11 },
    { x: 361, len: 6 },
].map(({ x, len }) => {
    const y = thickness(x) - 1.2;
    return `M${x - 3.2} ${y.toFixed(1)}Q${x - 0.6} ${(y + len * 0.7).toFixed(1)} ${x} ${(y + len).toFixed(1)}Q${x + 0.8} ${(y + len * 0.6).toFixed(1)} ${x + 3.2} ${y.toFixed(1)}Z`;
});
---

<div class="season-decor" aria-hidden="true">
    <!-- Halloween: luna, murciélagos en reposo, niebla baja y bandada -->
    <div data-season-deco="halloween">
        <div class="moon"></div>
        <svg class="bat-rest bat-rest-1" viewBox="0 0 40 20" set:html={BAT} />
        <svg class="bat-rest bat-rest-2" viewBox="0 0 40 20" set:html={BAT} />
        <div class="fog fog-1"></div>
        <div class="fog fog-2"></div>
        {flock.map((b) => (
            <div
                class:list={["flyer", b.extra && "decor-extra"]}
                style={`offset-path:path("${b.path}");width:${b.size}px;--dur:${b.dur}s;--delay:${b.delay}s;--s0:${b.s0};--o0:${b.o0};--o:${b.o};--blur:${b.blur}px`}
            >
                <svg viewBox="0 0 40 20" set:html={BAT} />
            </div>
        ))}
    </div>

    <!-- Navidad: nieve acumulada arriba y nevada en canvas -->
    <div data-season-deco="christmas">
        <svg class="snow-cap" viewBox="0 0 400 30" preserveAspectRatio="none">
            <defs>
                <linearGradient id="snow-cap-fill" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0"></stop>
                    <stop offset="1"></stop>
                </linearGradient>
            </defs>
            <path class="snow-cap-shadow" d={capPath(1.4)}></path>
            <path class="snow-cap-body" d={capPath(0)}></path>
            {icicles.map((d) => (
                <path class="snow-icicle" d={d} />
            ))}
        </svg>
        <canvas class="snow-canvas"></canvas>
    </div>
</div>

<script>
    import {
        SNOW_TIMING,
        createFlake,
        landsOn,
        meltAlpha,
        restingFlakes,
        settle,
        snowOpacity,
        stepFlake,
        type Flake,
        type Ledge,
        type Settled,
    } from "../lib/snow";

    const widget = document.getElementById("discord-widget");
    const decor = widget?.querySelector<HTMLElement>(".season-decor");
    const bats = decor?.querySelector<HTMLElement>(
        '[data-season-deco="halloween"]',
    );
    const canvas = decor?.querySelector<HTMLCanvasElement>(".snow-canvas");
    const ctx = canvas?.getContext("2d");
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");

    const MOMENT_MS = SNOW_TIMING.end * 1000;
    const COOLDOWN_MS = 6000;

    let playing = false;
    let lastPlay = -Infinity;
    let visible = false;
    let playedOnEnter = false;
    let width = 0;
    let height = 0;

    // Copo suave pre-renderizado: un degradado radial que se escala al dibujar.
    const sprite = document.createElement("canvas");
    sprite.width = sprite.height = 32;
    const sctx = sprite.getContext("2d");
    if (sctx) {
        const g = sctx.createRadialGradient(16, 16, 0, 16, 16, 16);
        g.addColorStop(0, "rgba(252, 246, 232, 1)");
        g.addColorStop(0.35, "rgba(252, 246, 232, 0.85)");
        g.addColorStop(1, "rgba(252, 246, 232, 0)");
        sctx.fillStyle = g;
        sctx.fillRect(0, 0, 32, 32);
    }

    const season = () => widget?.dataset.season;

    function drawFlakes(list: Flake[], k: number) {
        if (!ctx) return;
        for (const f of list) {
            const size = f.r * 4;
            ctx.globalAlpha = f.alpha * k;
            ctx.drawImage(sprite, f.x - size / 2, f.y - size / 2, size, size);
        }
        ctx.globalAlpha = 1;
    }

    /** Copos posados en el botón: se encogen un poco mientras se derriten. */
    function drawSettled(list: Settled[], t: number) {
        if (!ctx) return;
        for (const s of list) {
            const a = meltAlpha(s, t);
            if (a <= 0) continue;
            // Achatado: un copo posado se apoya en el borde.
            const size = s.r * 4.4 * (0.6 + 0.4 * (a / s.alpha));
            const tall = size * 0.6;
            ctx.globalAlpha = a;
            ctx.drawImage(sprite, s.x - size / 2, s.y - tall / 2, size, tall);
        }
        ctx.globalAlpha = 1;
    }

    function drawResting() {
        if (!ctx) return;
        ctx.clearRect(0, 0, width, height);
        if (season() === "christmas") {
            drawFlakes(restingFlakes(width, height), 1);
        }
    }

    function resize() {
        if (!canvas || !ctx || !decor) return;
        const rect = decor.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = rect.width;
        height = rect.height;
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        if (!playing) drawResting();
    }

    /** Borde superior del botón de unirse, relativo a la tarjeta. */
    function findLedge(): Ledge | null {
        const cta = widget?.querySelector<HTMLElement>("[data-snow-ledge]");
        if (!cta || !decor) return null;
        const a = cta.getBoundingClientRect();
        const b = decor.getBoundingClientRect();
        if (!a.width) return null; // vista oficial: el botón no está
        return {
            top: a.top - b.top,
            left: a.left - b.left,
            right: a.right - b.left,
        };
    }

    function playSnow() {
        if (!ctx) return;
        const resting = restingFlakes(width, height);
        const ledge = findLedge();
        const settled: Settled[] = [];
        const perSecond = 26 * (width / 350);
        // La nevada empieza ya repartida por la tarjeta (entra con un fundido).
        const flakes: Flake[] = Array.from(
            { length: Math.round(height / 12) },
            () => createFlake(width, Math.random, Math.random() * height * 0.9),
        );
        let start = 0;
        let prev = 0;
        let pending = 0;

        const frame = (now: number) => {
            if (!start) start = prev = now;
            const t = (now - start) / 1000;
            const dt = Math.min(0.05, (now - prev) / 1000);
            prev = now;

            if (t >= SNOW_TIMING.end || !visible) {
                playing = false;
                drawResting();
                return;
            }
            if (t < SNOW_TIMING.emit) {
                pending += perSecond * dt;
                while (pending >= 1) {
                    flakes.push(createFlake(width));
                    pending -= 1;
                }
            }
            for (let i = flakes.length - 1; i >= 0; i--) {
                const f = flakes[i];
                const prevY = f.y;
                stepFlake(f, dt, t);
                if (ledge && landsOn(f, prevY, ledge) && Math.random() < 0.9) {
                    settled.push(settle(f, ledge, t));
                    flakes.splice(i, 1);
                } else if (f.y > height + 8) {
                    flakes.splice(i, 1);
                }
            }

            ctx.clearRect(0, 0, width, height);
            drawFlakes(resting, 1);
            drawFlakes(flakes, snowOpacity(t));
            drawSettled(settled, t);
            requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
    }

    function playBats() {
        if (!bats) return;
        bats.classList.remove("is-playing");
        void bats.offsetWidth; // reinicia las animaciones CSS
        bats.classList.add("is-playing");
        window.setTimeout(() => {
            bats.classList.remove("is-playing");
            playing = false;
        }, MOMENT_MS);
    }

    function play() {
        if (reduceMotion.matches || playing || !visible) return;
        const now = performance.now();
        if (now - lastPlay < COOLDOWN_MS) return;
        const current = season();
        if (current !== "halloween" && current !== "christmas") return;
        lastPlay = now;
        playing = true;
        if (current === "halloween") playBats();
        else playSnow();
    }

    if (widget && decor) {
        new ResizeObserver(resize).observe(decor);
        // El perfil puede corregirse en el navegador después de este script.
        new MutationObserver(() => {
            if (!playing) drawResting();
        }).observe(widget, { attributeFilter: ["data-season"] });

        new IntersectionObserver(
            ([entry]) => {
                visible =
                    entry.isIntersecting && entry.intersectionRatio >= 0.35;
                if (visible && !playedOnEnter) {
                    playedOnEnter = true;
                    play();
                }
            },
            { threshold: [0, 0.35] },
        ).observe(widget);

        widget.addEventListener("pointerenter", (e) => {
            if (e.pointerType === "mouse") play();
        });
    }
</script>

<style is:global>
    #discord-widget .season-decor {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
        border-radius: inherit;
    }

    /* Solo se ve el avatar y la escena del perfil activo. */
    #discord-widget .season-avatar,
    #discord-widget [data-season-deco] {
        display: none;
    }

    #discord-widget[data-season="default"] [data-season-avatar="default"],
    #discord-widget[data-season="halloween"] [data-season-avatar="halloween"],
    #discord-widget[data-season="christmas"] [data-season-avatar="christmas"] {
        display: block;
    }

    #discord-widget[data-season="halloween"] [data-season-deco="halloween"],
    #discord-widget[data-season="christmas"] [data-season-deco="christmas"] {
        display: block;
    }

    /* Brillo superior teñido por la festividad */
    #discord-widget[data-season="halloween"] .season-glow {
        background-color: color-mix(
            in srgb,
            var(--color-season-fog) 22%,
            transparent
        );
    }

    #discord-widget[data-season="christmas"] .season-glow {
        background-color: color-mix(
            in srgb,
            var(--color-brand-yellow) 14%,
            transparent
        );
    }

    /* --- Halloween --- */
    #discord-widget .moon {
        position: absolute;
        top: -34px;
        left: -26px;
        width: 92px;
        aspect-ratio: 1;
        border-radius: 50%;
        background:
            radial-gradient(
                circle at 64% 70%,
                rgb(90 60 20 / 0.16) 0 8%,
                rgb(90 60 20 / 0.06) 10%,
                transparent 12%
            ),
            radial-gradient(
                circle at 78% 44%,
                rgb(90 60 20 / 0.13) 0 5%,
                transparent 7%
            ),
            radial-gradient(
                circle at 50% 84%,
                rgb(90 60 20 / 0.1) 0 4%,
                transparent 6%
            ),
            radial-gradient(
                ellipse at 70% 60%,
                rgb(90 60 20 / 0.1),
                transparent 45%
            ),
            radial-gradient(
                circle at 40% 35%,
                var(--color-season-moon),
                color-mix(
                        in srgb,
                        var(--color-season-moon) 80%,
                        var(--color-brand-yellow-deep)
                    )
                    72%
            );
        box-shadow:
            inset -6px -8px 14px rgb(90 60 20 / 0.18),
            0 0 24px 4px
                color-mix(in srgb, var(--color-season-moon) 22%, transparent),
            0 0 70px 24px
                color-mix(in srgb, var(--color-season-moon) 8%, transparent);
        opacity: 0.92;
    }

    /* Halo que se aviva durante el momento (solo opacidad). */
    #discord-widget .moon::after {
        content: "";
        position: absolute;
        inset: -40px;
        border-radius: 50%;
        background: radial-gradient(
            circle,
            color-mix(in srgb, var(--color-season-moon) 30%, transparent) 30%,
            transparent 68%
        );
        opacity: 0;
    }

    #discord-widget .is-playing .moon::after {
        animation: season-halo 5s ease-in-out;
    }

    /* Murciélagos en silueta con un borde de luz de luna. */
    #discord-widget .bat-rest,
    #discord-widget .flyer {
        fill: var(--color-season-night);
    }

    #discord-widget .bat-rest {
        position: absolute;
        transition: opacity 0.6s ease;
    }

    /* Al despegar, los del reposo pasan a ser los dos primeros de la bandada. */
    #discord-widget .is-playing .bat-rest {
        opacity: 0;
        transition-duration: 0s;
    }

    #discord-widget .bat-rest-1 {
        top: 14px;
        left: 20px;
        width: 26px;
    }

    #discord-widget .bat-rest-2 {
        top: 34px;
        left: 52px;
        width: 15px;
    }

    #discord-widget .fog {
        position: absolute;
        bottom: -40px;
        height: 140px;
        border-radius: 50%;
        filter: blur(18px);
    }

    #discord-widget .fog-1 {
        left: -25%;
        width: 95%;
        background: radial-gradient(
            ellipse,
            color-mix(in srgb, var(--color-season-fog) 34%, transparent),
            transparent 70%
        );
    }

    #discord-widget .is-playing .fog-1 {
        animation: season-fog 5s ease-in-out;
    }

    #discord-widget .is-playing .fog-2 {
        animation: season-fog 5s ease-in-out reverse;
    }

    #discord-widget .fog-2 {
        right: -25%;
        width: 85%;
        background: radial-gradient(
            ellipse,
            color-mix(in srgb, var(--color-season-halloween) 20%, transparent),
            transparent 70%
        );
    }

    #discord-widget .flyer {
        display: none;
    }

    @supports (offset-path: path("M0 0")) {
        #discord-widget .flyer {
            display: block;
            position: absolute;
            top: 0;
            left: 0;
            offset-rotate: 0deg;
            offset-distance: 0%;
            opacity: 0;
            filter: blur(var(--blur))
                drop-shadow(
                    0 0 1.2px
                        color-mix(
                            in srgb,
                            var(--color-season-moon) 95%,
                            transparent
                        )
                )
                drop-shadow(
                    0 0 8px
                        color-mix(
                            in srgb,
                            var(--color-season-halloween) 55%,
                            transparent
                        )
                );
        }

        #discord-widget .is-playing .flyer {
            animation: season-fly var(--dur) var(--delay)
                cubic-bezier(0.37, 0, 0.63, 1) both;
        }

        #discord-widget .is-playing .flyer svg {
            animation: season-flutter 0.28s ease-in-out infinite alternate;
        }

        #discord-widget .is-playing .flyer .wing-l {
            animation: season-flap-l 0.28s ease-in-out infinite alternate;
        }

        #discord-widget .is-playing .flyer .wing-r {
            animation: season-flap-r 0.28s ease-in-out infinite alternate;
        }
    }

    #discord-widget .wing {
        transform-box: fill-box;
    }

    #discord-widget .wing-l {
        transform-origin: 100% 30%;
    }

    #discord-widget .wing-r {
        transform-origin: 0% 30%;
    }

    @keyframes season-fly {
        0% {
            offset-distance: 0%;
            opacity: var(--o0);
            transform: scale(var(--s0));
        }
        12%,
        86% {
            opacity: var(--o);
        }
        100% {
            offset-distance: 100%;
            opacity: 0;
            transform: scale(1);
        }
    }

    @keyframes season-halo {
        30% {
            opacity: 1;
        }
    }

    @keyframes season-fog {
        50% {
            transform: translateX(14px) scale(1.08);
        }
    }

    @keyframes season-flutter {
        to {
            transform: translateY(1.5px);
        }
    }

    @keyframes season-flap-l {
        from {
            transform: rotate(-22deg) scaleY(1);
        }
        to {
            transform: rotate(26deg) scaleY(0.55);
        }
    }

    @keyframes season-flap-r {
        from {
            transform: rotate(22deg) scaleY(1);
        }
        to {
            transform: rotate(-26deg) scaleY(0.55);
        }
    }

    /* --- Navidad --- */
    #discord-widget .snow-cap {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 30px;
    }

    #discord-widget .snow-cap stop:first-child {
        stop-color: white;
    }

    #discord-widget .snow-cap stop:last-child {
        stop-color: var(--color-brand-cream);
    }

    #discord-widget .snow-cap-body,
    #discord-widget .snow-icicle {
        fill: url(#snow-cap-fill);
    }

    #discord-widget .snow-cap-body {
        opacity: 0.94;
    }

    #discord-widget .snow-icicle {
        opacity: 0.8;
    }

    #discord-widget .snow-cap-shadow {
        fill: var(--color-season-frost);
        opacity: 0.18;
    }

    #discord-widget .snow-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    /* En móvil, menos elementos para no saturar la tarjeta. */
    @media (max-width: 639px) {
        #discord-widget .decor-extra {
            display: none !important;
        }
    }
</style>
