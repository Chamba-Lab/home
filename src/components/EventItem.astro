---
import EventPosters from "./EventPosters.astro";
import {
    buildGoogleCalendarUrl,
    buildIcsDataUri,
    formatTimeDisplay,
} from "../lib/calendar";

interface Props {
    id?: string;
    day: number;
    monthShortEn: string;
    monthShortEs: string;
    titleEs: string;
    titleEn?: string;
    descriptionEn: string;
    descriptionEs?: string;
    recurrenceLabelEn?: string;
    recurrenceLabelEs?: string;
    dateIso?: string;
    startTime?: string;
    endTime?: string;
    timezone?: string;
    isRecurring?: boolean;
    kind?: "activity";
    tagEn?: string;
    tagEs?: string;
}

const {
    id = "evento",
    day,
    monthShortEn,
    monthShortEs,
    titleEs,
    titleEn,
    descriptionEn,
    descriptionEs,
    recurrenceLabelEn,
    recurrenceLabelEs,
    dateIso,
    startTime,
    endTime,
    timezone = "UTC-5",
    isRecurring = false,
    kind,
    tagEn,
    tagEs,
} = Astro.props;

const title = titleEs || titleEn || "Evento Chamba Lab";
const description =
    descriptionEs || descriptionEn || "Sesión de la comunidad tech Chamba Lab";

const gcalUrl = buildGoogleCalendarUrl({
    id,
    title,
    description,
    date: dateIso,
    startTime,
    endTime,
    timezone,
    recurring: isRecurring,
});

const icsUrl = buildIcsDataUri({
    id,
    title,
    description,
    date: dateIso,
    startTime,
    endTime,
    timezone,
    recurring: isRecurring,
});

const posterKind =
    kind === "activity"
        ? "activity"
        : id === "launch"
          ? "launch"
          : id.startsWith("code-coffee-")
            ? "coffee"
            : undefined;
const eventDate = dateIso ? new Date(dateIso + "T12:00:00-05:00") : undefined;
const weekdayEs =
    eventDate?.toLocaleDateString("es-PE", {
        weekday: "long",
        timeZone: "America/Lima",
    }) ?? "";
const weekdayEn =
    eventDate?.toLocaleDateString("en-US", {
        weekday: "long",
        timeZone: "America/Lima",
    }) ?? "";
const categoryEs = isRecurring
    ? `Coworking · ${recurrenceLabelEs ?? recurrenceLabelEn ?? ""}`
    : posterKind === "launch"
      ? "Encuentro de lanzamiento"
      : posterKind === "activity"
        ? (tagEs ?? tagEn ?? "Actividad")
        : "Encuentro de la comunidad";
const categoryEn = isRecurring
    ? `Coworking · ${recurrenceLabelEn ?? ""}`
    : posterKind === "launch"
      ? "Community launch"
      : posterKind === "activity"
        ? (tagEn ?? "Activity")
        : "Community gathering";
const timeDisplay = formatTimeDisplay(startTime, endTime, timezone, "es");
const timeDisplayEn = formatTimeDisplay(startTime, endTime, timezone, "en");
---

<li
    data-date-iso={dateIso}
    class:list={["agenda-event", { recurring: isRecurring }]}
>
    <time class="event-date" datetime={dateIso}>
        <span
            class="event-weekday"
            data-i18n-es={weekdayEs}
            data-i18n-en={weekdayEn}
        >
            {weekdayEs}
        </span>
        <strong>{day}</strong>
        <span
            class="event-month"
            data-i18n-es={monthShortEs.replace(".", "")}
            data-i18n-en={monthShortEn}
        >
            {monthShortEs.replace(".", "")}
        </span>
    </time>
    <div class="event-poster">
        {
            posterKind && (
                <EventPosters
                    kind={posterKind}
                    compact
                    activity={{
                        tagEs: tagEs ?? tagEn,
                        tagEn,
                        dateIso,
                        startTime,
                        endTime,
                    }}
                />
            )
        }
    </div>
    <div class="event-info">
        <p
            class="event-category"
            data-i18n-es={categoryEs}
            data-i18n-en={categoryEn}
        >
            {categoryEs}
        </p>
        <h3 data-i18n-es={titleEs} data-i18n-en={titleEn ?? titleEs}>
            {titleEs}
        </h3>
        <p
            class="event-time"
            data-i18n-es={`${timeDisplay} · Discord`}
            data-i18n-en={`${timeDisplayEn} · Discord`}
        >
            {timeDisplay} · Discord
        </p>
        <p
            class="event-description"
            data-i18n-es={descriptionEs ?? descriptionEn}
            data-i18n-en={descriptionEn}
        >
            {descriptionEs ?? descriptionEn}
        </p>
    </div>
    <p class="event-mobile-time">
        <span data-i18n-es={weekdayEs} data-i18n-en={weekdayEn}>
            {weekdayEs}
        </span>{" "}
        · {startTime}
        {endTime && `—${endTime}`}
    </p>
    <p
        class="event-ended"
        data-i18n-es="Evento realizado"
        data-i18n-en="Event held"
    >
        Evento realizado
    </p>
    <div class="event-actions">
        <a
            class="event-gcal"
            href={gcalUrl}
            target="_blank"
            rel="noopener noreferrer"
        >
            <span data-i18n="addToGCal">Google Calendar</span>{" "}
            <span aria-hidden="true">↗</span>
        </a>
        <a class="event-ical" href={icsUrl} download={`${id}.ics`}>
            <span data-i18n-es="Descargar iCal" data-i18n-en="Download iCal">
                Descargar iCal
            </span>{" "}
            <span aria-hidden="true">↓</span>
        </a>
    </div>
</li>
<style>
    .agenda-event {
        display: grid;
        grid-template-columns: 88px 132px minmax(0, 1fr) 190px;
        gap: 28px;
        align-items: center;
        padding: 32px 0;
        border-bottom: 1px solid var(--color-surface-border-subtle);
    }
    .event-date {
        display: flex;
        flex-direction: column;
        color: var(--color-brand-yellow);
    }
    .recurring .event-date,
    .recurring .event-category {
        color: var(--color-event-recurring);
    }
    .event-weekday,
    .event-month {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        color: var(--color-muted);
    }
    .event-date strong {
        font: 800 58px/1.16 var(--font-display);
        letter-spacing: -0.04em;
    }
    .event-mobile-time {
        display: none;
    }
    .event-info {
        min-width: 0;
    }
    .event-category {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        color: var(--color-brand-yellow);
        margin-bottom: 12px;
    }
    .event-info h3 {
        font: 800 29px/1.2 var(--font-display);
        letter-spacing: -0.025em;
        color: var(--color-content-inverse);
    }
    .event-time {
        font-size: 14px;
        font-weight: 600;
        margin: 12px 0;
    }
    .event-description {
        font-size: 15px;
        line-height: 1.55;
        color: var(--color-muted);
    }
    .event-actions {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
        font-size: 13px;
        font-weight: 600;
    }
    /* Eventos pasados: sin acciones de calendario, solo una nota discreta. */
    .event-ended {
        display: none;
        font-size: 12px;
        font-weight: 600;
        color: var(--color-muted);
    }
    :global(.agenda-event.is-past) .event-actions {
        display: none;
    }
    :global(.agenda-event.is-past) .event-ended {
        display: block;
    }
    .event-gcal {
        padding: 14px;
        border: 1px solid var(--color-surface-border-subtle);
        background: var(--color-surface-subtle);
        border-radius: 10px;
    }
    .event-gcal:hover {
        border-color: var(--color-brand-yellow);
    }
    .event-ical {
        padding: 12px;
        color: var(--color-muted);
        font-size: 12px;
    }
    .event-ical:hover {
        color: var(--color-content-inverse);
    }
    .event-actions a:focus-visible {
        outline: 2px solid var(--color-brand-yellow);
        outline-offset: 4px;
    }
    @media (max-width: 1100px) {
        .agenda-event {
            grid-template-columns: 70px 100px minmax(0, 1fr) 155px;
            gap: 20px;
        }
        .event-poster {
            transform: scale(0.758);
            transform-origin: left center;
            width: 100px;
        }
        .event-info h3 {
            font-size: 24px;
        }
    }
    @media (max-width: 767px) {
        .agenda-event {
            grid-template-columns: 110px minmax(0, 1fr);
            gap: 20px 12px;
            padding: 28px 0;
        }
        .event-date {
            flex-direction: row;
            align-items: baseline;
            gap: 4px;
        }
        .event-date strong,
        .event-month {
            font: 800 26px/1.16 var(--font-display);
            color: inherit;
        }
        .event-weekday,
        .event-poster,
        .event-time {
            display: none;
        }
        .event-info {
            grid-column: 1/-1;
            grid-row: 2;
        }
        .event-info h3 {
            font-size: 26px;
        }
        .event-description {
            margin-top: 12px;
        }
        .event-mobile-time {
            display: block;
            grid-column: 2;
            grid-row: 1;
            font-size: 11px;
            text-transform: capitalize;
        }
        .event-actions,
        .event-ended {
            grid-column: 1/-1;
        }
        .event-category {
            font-size: 10px;
        }
    }
</style>
