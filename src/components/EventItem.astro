---
import { DISCORD_URL } from "../lib/constants";
import DiscordIcon from "./icons/DiscordIcon.astro";
import {
    buildGoogleCalendarUrl,
    buildIcsDataUri,
    formatTimeDisplay,
} from "../lib/calendar";

interface Props {
    id?: string;
    day: number;
    monthShortEn: string;
    monthShortEs: string;
    titleEs: string;
    titleEn?: string;
    descriptionEn: string;
    descriptionEs?: string;
    recurrenceLabelEn?: string;
    recurrenceLabelEs?: string;
    dateIso?: string;
    startTime?: string;
    endTime?: string;
    timezone?: string;
    isRecurring?: boolean;
}

const {
    id = "evento",
    day,
    monthShortEn,
    monthShortEs,
    titleEs,
    titleEn,
    descriptionEn,
    descriptionEs,
    recurrenceLabelEn,
    recurrenceLabelEs,
    dateIso,
    startTime,
    endTime,
    timezone = "UTC-5",
    isRecurring = false,
} = Astro.props;

const title = titleEs || titleEn || "Evento Chamba Lab";
const description =
    descriptionEs || descriptionEn || "Sesión de la comunidad tech Chamba Lab";

const gcalUrl = buildGoogleCalendarUrl({
    id,
    title,
    description,
    date: dateIso,
    startTime,
    endTime,
    timezone,
    recurring: isRecurring,
});

const icsUrl = buildIcsDataUri({
    id,
    title,
    description,
    date: dateIso,
    startTime,
    endTime,
    timezone,
    recurring: isRecurring,
});

const timeDisplay = formatTimeDisplay(startTime, endTime, timezone, "es");
---

<li
    class="card-glass rounded-2xl p-6 flex flex-col md:flex-row gap-5 items-start md:items-center justify-between border border-white/10 hover:border-brand-yellow/30 transition-all duration-300 shadow-lg shadow-black/20"
>
    <!-- Left: Date block & Description -->
    <div class="flex items-start gap-4 min-w-0">
        <!-- Date Badge -->
        <div
            class="shrink-0 w-14 h-14 rounded-xl bg-gradient-to-br from-brand-yellow/20 to-amber-500/10 border border-brand-yellow/30 text-brand-yellow flex flex-col items-center justify-center leading-none shadow-sm"
        >
            <span class="text-xl font-extrabold font-display">{day}</span>
            <span
                class="text-[10px] font-bold uppercase tracking-wider mt-1 text-slate-300"
                data-i18n-en={monthShortEn}
                data-i18n-es={monthShortEs}
            >
                {monthShortEs}
            </span>
        </div>

        <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2 mb-1.5">
                <h3 class="font-display text-lg font-bold text-white">
                    {titleEs ?? titleEn}
                </h3>
                {
                    recurrenceLabelEn && (
                        <span
                            class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-[#5865F2]/15 border border-[#5865F2]/30 text-[#8a95ff]"
                            data-i18n-en={recurrenceLabelEn}
                            data-i18n-es={recurrenceLabelEs}
                        >
                            {recurrenceLabelEs ?? recurrenceLabelEn}
                        </span>
                    )
                }
                <!-- Time & Timezone Badge -->
                <span
                    class="inline-flex items-center gap-1 text-[11px] font-semibold text-brand-yellow/90 bg-brand-yellow/10 border border-brand-yellow/20 px-2 py-0.5 rounded-md"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-3 h-3 text-brand-yellow"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                    </svg>
                    <span>{timeDisplay}</span>
                </span>
            </div>
            <p
                class="text-sm text-slate-400 leading-relaxed max-w-xl"
                data-i18n-en={descriptionEn}
                data-i18n-es={descriptionEs}
            >
                {descriptionEs ?? descriptionEn}
            </p>
        </div>
    </div>

    <!-- Right: Actions (Google Calendar, iCal & Discord) -->
    <div
        class="flex flex-wrap items-center gap-2 shrink-0 self-end md:self-center pt-2 md:pt-0"
    >
        <a
            href={gcalUrl}
            target="_blank"
            rel="noopener noreferrer"
            title="Añadir a Google Calendar"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-300 hover:text-brand-yellow transition-colors border border-white/10 hover:border-brand-yellow/30 px-3 py-2 rounded-xl bg-slate-900/80"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-3.5 h-3.5 text-brand-yellow"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path>
            </svg>
            <span data-i18n="addToGCal">Google Calendar</span>
        </a>

        <a
            href={icsUrl}
            download={`${id}.ics`}
            title="Descargar archivo iCal (.ics)"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-300 hover:text-white transition-colors border border-white/10 hover:border-white/20 px-3 py-2 rounded-xl bg-slate-900/50"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-3.5 h-3.5 text-slate-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                ></path>
            </svg>
            <span data-i18n="downloadIcs">iCal</span>
        </a>

        <a
            href={DISCORD_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 bg-[#5865F2] hover:bg-[#4752c4] text-white px-3.5 py-2 rounded-xl text-xs font-bold transition-all shadow-sm hover:shadow-[0_0_15px_rgba(88,101,242,0.4)]"
        >
            <DiscordIcon class="w-3.5 h-3.5" />
            <span data-i18n="reviewDiscord">Revisar en Discord</span>
        </a>
    </div>
</li>
