---
import { DISCORD_URL } from "../lib/constants";
import DiscordIcon from "./icons/DiscordIcon.astro";
import MenuIcon from "./icons/MenuIcon.astro";
import CloseIcon from "./icons/CloseIcon.astro";

import PowerBoltIcon from "./icons/PowerBoltIcon.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
---

<header
    class="sticky top-0 z-50 w-full border-b border-white/[0.08] bg-[#080D1A]/85 backdrop-blur-xl transition-all"
>
    <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between"
    >
        <!-- Brand Logo: Modern Power Bolt -->
        <a
            href={base}
            class="flex items-center gap-3 transition-opacity hover:opacity-90 group"
        >
            <div
                class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-yellow to-amber-500 flex items-center justify-center shadow-lg shadow-brand-yellow/20 text-slate-950 transition-transform group-hover:scale-105"
            >
                <PowerBoltIcon class="w-6 h-6 text-slate-950" />
            </div>
            <div class="flex items-center gap-1.5">
                <span
                    class="font-display text-2xl font-extrabold tracking-tight text-white"
                >
                    Chamba
                </span>
                <span
                    class="text-[11px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-brand-yellow/15 text-brand-yellow border border-brand-yellow/30"
                >
                    Lab
                </span>
            </div>
        </a>

        <!-- Desktop Nav: Direct links to subpages as requested -->
        <nav class="hidden md:flex items-center gap-8">
            <a
                href={`${base}resources`}
                data-i18n="navResources"
                class="text-sm font-semibold text-slate-300 hover:text-white transition-colors"
            >
                Recursos
            </a>
            <a
                href={`${base}events`}
                data-i18n="navEvents"
                class="text-sm font-semibold text-slate-300 hover:text-white transition-colors"
            >
                Eventos
            </a>
            <a
                href={`${base}activities`}
                data-i18n="navActivities"
                class="text-sm font-semibold text-slate-300 hover:text-white transition-colors"
            >
                Dinámicas
            </a>
        </nav>

        <!-- Right Actions: Language Switcher + Discord CTA -->
        <div class="hidden sm:flex items-center gap-4">
            <!-- Segmented Pill Language Switcher -->
            <div
                class="flex items-center p-1 rounded-lg bg-slate-900/90 border border-white/10 text-xs font-semibold"
            >
                <button
                    type="button"
                    data-set-lang="es"
                    class="lang-btn-es px-2.5 py-1 rounded bg-brand-yellow text-slate-950 font-bold transition-all"
                >
                    ES
                </button>
                <button
                    type="button"
                    data-set-lang="en"
                    class="lang-btn-en px-2.5 py-1 rounded text-slate-400 hover:text-slate-200 transition-all"
                >
                    EN
                </button>
            </div>

            <!-- Discord Button with Blurple Glow -->
            <a
                href={DISCORD_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-[#5865F2] hover:bg-[#4752c4] text-white px-4 py-2.5 rounded-xl text-sm font-semibold transition-all shadow-sm hover:shadow-[0_0_20px_rgba(88,101,242,0.4)]"
            >
                <DiscordIcon class="w-4 h-4" />
                <span data-i18n="joinDiscord">Unirse a Discord</span>
            </a>
        </div>

        <!-- Mobile Hamburger Toggle -->
        <button
            id="mobile-toggle"
            type="button"
            class="md:hidden p-2.5 rounded-xl bg-slate-900 border border-white/10 text-slate-300 hover:text-white focus:outline-none"
            aria-label="Abrir menú"
            aria-expanded="false"
        >
            <MenuIcon id="menu-icon-open" class="w-5 h-5" />
            <CloseIcon id="menu-icon-close" class="w-5 h-5" hidden />
        </button>
    </div>

    <!-- Mobile Drawer -->
    <div
        id="mobile-menu"
        class="hidden md:hidden border-b border-white/10 bg-[#080D1A]/95 backdrop-blur-2xl px-6 py-6"
    >
        <div class="flex flex-col gap-4">
            <a
                href={`${base}resources`}
                data-i18n="navResources"
                class="text-base font-medium text-slate-200 hover:text-brand-yellow py-1.5 transition-colors"
            >
                Recursos
            </a>
            <a
                href={`${base}events`}
                data-i18n="navEvents"
                class="text-base font-medium text-slate-200 hover:text-brand-yellow py-1.5 transition-colors"
            >
                Eventos
            </a>
            <a
                href={`${base}activities`}
                data-i18n="navActivities"
                class="text-base font-medium text-slate-200 hover:text-brand-yellow py-1.5 transition-colors"
            >
                Dinámicas
            </a>

            <div
                class="pt-4 border-t border-white/10 flex items-center justify-between"
            >
                <div
                    class="flex items-center p-1 rounded-lg bg-slate-900 border border-white/10 text-xs font-semibold"
                >
                    <button
                        type="button"
                        data-set-lang="es"
                        class="lang-btn-es px-2.5 py-1 rounded bg-brand-yellow text-slate-950 font-bold transition-all"
                    >
                        ES
                    </button>
                    <button
                        type="button"
                        data-set-lang="en"
                        class="lang-btn-en px-2.5 py-1 rounded text-slate-400"
                    >
                        EN
                    </button>
                </div>
                <a
                    href={DISCORD_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 bg-[#5865F2] hover:bg-[#4752c4] text-white px-4 py-2 rounded-xl text-sm font-semibold"
                >
                    <DiscordIcon class="w-4 h-4" />
                    <span>Discord</span>
                </a>
            </div>
        </div>
    </div>
</header>

<script>
    const mobileToggle = document.getElementById("mobile-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("menu-icon-open");
    const iconClose = document.getElementById("menu-icon-close");

    if (mobileToggle && mobileMenu) {
        mobileToggle.addEventListener("click", () => {
            const isHidden = mobileMenu.classList.toggle("hidden");
            mobileToggle.setAttribute("aria-expanded", String(!isHidden));
            iconOpen?.toggleAttribute("hidden", !isHidden);
            iconClose?.toggleAttribute("hidden", isHidden);
        });

        // Close on navigation link click
        mobileMenu.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => {
                mobileMenu.classList.add("hidden");
                mobileToggle.setAttribute("aria-expanded", "false");
                iconOpen?.removeAttribute("hidden");
                iconClose?.setAttribute("hidden", "");
            });
        });
    }
</script>
