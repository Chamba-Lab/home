---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import DiscordIcon from "./icons/DiscordIcon.astro";
import avatarDefault from "../../brand/discord/avatar-cream-1024.png";
import avatarHalloween from "../../brand/discord/avatar-halloween-1024.png";
import avatarChristmas from "../../brand/discord/avatar-christmas-1024.png";
import { DISCORD_URL, DISCORD_WIDGET_API } from "../lib/constants";
import {
    FALLBACK_CHANNELS,
    normalize,
    renderChannelsOnly,
    type DiscordChannel,
} from "../lib/discord";
import { currentSeason, type SeasonId } from "../lib/seasons";

// En el build solo se toman los canales: las personas y los contadores de ese
// momento serían una foto vieja cuando alguien visite el sitio (solo se
// compila al fusionar). La actividad en vivo la pone el navegador.
let channels: DiscordChannel[] = FALLBACK_CHANNELS;

try {
    const res = await fetch(DISCORD_WIDGET_API, {
        signal: AbortSignal.timeout(3500),
    });
    if (res.ok) {
        const live = normalize(await res.json()).channels;
        if (live.length > 0) channels = live;
    }
} catch {
    // Sin red o Discord caído: se quedan los canales de respaldo.
}

// Avatar por festividad con la fecha del build; el navegador lo corrige si
// el sitio se desplegó antes de que cambiara la temporada. La temporada la
// ponen el avatar y la escena alrededor (el cuarto de Rakim), no el widget.
const season = currentSeason();
const avatars: Record<SeasonId, ImageMetadata> = {
    default: avatarDefault,
    halloween: avatarHalloween,
    christmas: avatarChristmas,
};
---

<!--
    La pantalla del monitor de Rakim: llena el hueco que le da el hero (en
    escritorio, la pantalla de la escena; en móvil, un monitor dibujado). Los
    canales se desplazan dentro si no caben; el botón de unirse queda abajo.
-->
<div
    id="discord-widget"
    data-season={season}
    data-live="loading"
    data-channels={JSON.stringify(channels)}
    class="relative flex h-full min-h-[27rem] flex-col gap-3.5 p-[22px]"
>
    <!-- Servidor y estado: cargando, en vivo o sin conexión (data-live) -->
    <div class="flex items-center gap-3">
        {(Object.keys(avatars) as SeasonId[]).map((id) => (
            <Image
                src={avatars[id]}
                alt="Chamba Lab"
                width={88}
                height={88}
                data-season-avatar={id}
                class="season-avatar w-11 h-11 rounded-xl bg-brand-cream shrink-0"
            />
        ))}
        <div class="flex flex-col min-w-0 gap-[3px]">
            <p
                id="discord-server-name"
                class="font-display text-[17px] font-extrabold text-white truncate leading-tight"
            >
                Chamba Lab
            </p>
            <p class="live-only text-xs font-semibold items-center gap-1.5">
                <span
                    class="w-[7px] h-[7px] rounded-full bg-emerald-400 shadow-[0_0_6px] shadow-emerald-400/70"
                    aria-hidden="true"
                ></span>
                <span class="text-emerald-400">
                    <span id="discord-presence-count">0</span>{" "}
                    <span data-i18n="discordOnline">en línea</span>
                </span>
                <span class="text-slate-500 font-normal" aria-hidden="true">
                    ·
                </span>
                <span class="text-slate-400">
                    <span id="discord-voice-count">0</span>{" "}
                    <span data-i18n="discordInVoice">en voz</span>
                </span>
            </p>
            <p class="loading-only items-center gap-1.5 mt-1">
                <span
                    class="h-2.5 w-32 rounded-full bg-white/10 animate-pulse"
                    aria-hidden="true"
                ></span>
                <span class="sr-only" data-i18n="discordLoading">
                    Cargando actividad en vivo
                </span>
            </p>
            <p class="offline-only text-xs text-slate-400 items-center gap-1.5 font-medium">
                <span
                    class="w-[7px] h-[7px] rounded-full bg-slate-500"
                    aria-hidden="true"
                ></span>
                <span data-i18n="discordUnavailable">
                    Actividad en vivo no disponible
                </span>
            </p>
        </div>
    </div>

    <div class="h-px bg-white/[0.07]" aria-hidden="true"></div>

    <!-- Canales de voz (con su gente) y el resto en línea -->
    <div
        id="discord-voice"
        class="widget-scroll min-h-0 flex-1 overflow-y-auto -mr-2 pr-2"
        set:html={renderChannelsOnly(channels, "loading")}
    />

    <a
        href={DISCORD_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full shrink-0 inline-flex items-center justify-center gap-2 bg-brand-discord hover:bg-brand-discord-hover text-white h-[46px] rounded-[10px] text-sm font-semibold shadow-lg shadow-brand-discord/25 hover:shadow-brand-discord/40 transition-all"
    >
        <DiscordIcon class="w-4 h-4" />
        <span data-i18n="discordJoin">Unirse a la comunidad</span>
    </a>
</div>

<script>
    import { DISCORD_WIDGET_API } from "../lib/constants";
    import {
        buildView,
        normalize,
        renderChannelsOnly,
        renderVoice,
        type DiscordChannel,
    } from "../lib/discord";
    import { getStoredLang } from "../i18n/lang";
    import { currentSeason } from "../lib/seasons";

    const widget = document.getElementById("discord-widget");

    // El HTML trae el perfil de la fecha del build; aquí se ajusta al día de hoy.
    widget?.setAttribute("data-season", currentSeason());

    // --- Actividad en vivo (solo en el navegador) ---
    const LIVE_TIMEOUT_MS = 5000;
    // Si tras estar en vivo Discord deja de responder este tiempo, se avisa.
    const STALE_MS = 3 * 60 * 1000;
    let lastOk = 0;

    function setLive(state: "loading" | "live" | "offline") {
        widget?.setAttribute("data-live", state);
    }

    // Avisa a la escena (Rakim se pone audífonos si hay gente en voz).
    function announce(inVoice: number) {
        document.dispatchEvent(
            new CustomEvent("discord:update", { detail: { inVoice } }),
        );
    }

    function showOffline() {
        setLive("offline");
        announce(0);
        let channels: DiscordChannel[] = [];
        try {
            channels = JSON.parse(widget?.dataset.channels ?? "[]");
        } catch {
            // Sin canales: queda solo el aviso.
        }
        const voiceEl = document.getElementById("discord-voice");
        if (voiceEl) {
            voiceEl.innerHTML = renderChannelsOnly(
                channels,
                "offline",
                getStoredLang(),
            );
        }
    }

    async function refreshDiscordData() {
        try {
            const res = await fetch(DISCORD_WIDGET_API, {
                signal: AbortSignal.timeout(LIVE_TIMEOUT_MS),
            });
            if (!res.ok) throw new Error(String(res.status));
            const data = normalize(await res.json());
            const view = buildView(data);

            const presenceEl = document.getElementById(
                "discord-presence-count",
            );
            if (presenceEl) presenceEl.textContent = String(view.online);
            const voiceCountEl = document.getElementById("discord-voice-count");
            if (voiceCountEl) voiceCountEl.textContent = String(view.inVoice);

            const voiceEl = document.getElementById("discord-voice");
            if (voiceEl) {
                voiceEl.innerHTML = renderVoice(view, getStoredLang());
            }
            lastOk = Date.now();
            setLive("live");
            announce(view.inVoice);
        } catch {
            // Bloqueado, sin red o Discord caído: nunca se muestran datos viejos.
            if (!lastOk || Date.now() - lastOk > STALE_MS) showOffline();
        }
    }

    refreshDiscordData();

    // Refresca cada 60 s si la pestaña está visible.
    setInterval(() => {
        if (document.visibilityState === "visible") {
            refreshDiscordData();
        }
    }, 60000);
</script>

<style is:global>
    /* Solo se ve la línea de estado que corresponde a data-live. */
    #discord-widget .live-only,
    #discord-widget .loading-only,
    #discord-widget .offline-only {
        display: none;
    }

    #discord-widget[data-live="live"] .live-only,
    #discord-widget[data-live="loading"] .loading-only,
    #discord-widget[data-live="offline"] .offline-only {
        display: flex;
    }

    /* Solo el avatar de la temporada; los ocultos no se descargan (lazy). */
    #discord-widget .season-avatar {
        display: none;
    }

    #discord-widget[data-season="default"] [data-season-avatar="default"],
    #discord-widget[data-season="halloween"] [data-season-avatar="halloween"],
    #discord-widget[data-season="christmas"] [data-season-avatar="christmas"] {
        display: block;
    }
</style>
