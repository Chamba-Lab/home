---
import { Image } from "astro:assets";
import DiscordIcon from "./icons/DiscordIcon.astro";
import serverAvatar from "../../brand/discord/avatar-halloween-1024.png";
import {
    DISCORD_URL,
    DISCORD_WIDGET_API,
    DISCORD_WIDGET_IFRAME,
} from "../lib/constants";
import {
    FALLBACK_DATA,
    buildView,
    normalize,
    renderVoice,
    type DiscordData,
} from "../lib/discord";

let discordData: DiscordData = FALLBACK_DATA;

try {
    const res = await fetch(DISCORD_WIDGET_API, {
        signal: AbortSignal.timeout(3500),
    });
    if (res.ok) {
        discordData = normalize(await res.json());
    }
} catch {
    // Sin red o Discord caído: se queda FALLBACK_DATA (datos de ejemplo).
}

const view = buildView(discordData);
---

<div class="w-full max-w-[370px] flex flex-col items-center">
    <div class="w-full card-glass rounded-2xl p-5 shadow-2xl border border-white/10 relative overflow-hidden group transition-all duration-300 hover:border-brand-yellow/30 bg-surface/85 backdrop-blur-xl">
        <!-- Top ambient glow -->
        <div class="absolute -top-16 -right-16 w-36 h-36 bg-brand-discord/20 rounded-full blur-2xl pointer-events-none"></div>

        <!-- Mode Toggle (Modern Card vs Official Iframe) -->
        <div class="flex items-center justify-end pb-4 mb-4 border-b border-white/[0.08] relative z-10">
            <!-- View switch -->
            <div class="flex items-center gap-1 bg-slate-900/80 p-0.5 rounded-lg border border-white/10 text-[10px] font-semibold">
                <button
                    id="btn-view-modern"
                    type="button"
                    class="px-2 py-0.5 rounded bg-brand-yellow text-slate-950 font-bold transition-all"
                    data-i18n="discordWidgetTabModern"
                >
                    Vista Moderna
                </button>
                <button
                    id="btn-view-official"
                    type="button"
                    class="px-2 py-0.5 rounded text-slate-400 hover:text-white transition-all"
                    data-i18n="discordWidgetTabOfficial"
                >
                    Oficial
                </button>
            </div>
        </div>

        <!-- VIEW A: Modern Glass Card -->
        <div id="discord-view-modern" class="flex flex-col gap-4 relative z-10">
            <!-- Server Header -->
            <div class="flex items-center gap-3">
                <Image
                    src={serverAvatar}
                    alt="Chamba Lab"
                    width={88}
                    height={88}
                    class="w-11 h-11 rounded-xl bg-brand-cream shadow-md shadow-brand-discord/30 shrink-0"
                />
                <div class="flex flex-col min-w-0">
                    <p
                        id="discord-server-name"
                        class="font-display text-base font-extrabold text-white truncate leading-tight"
                    >
                        {discordData.name}
                    </p>
                    <p class="text-xs text-emerald-400 flex items-center gap-1.5 font-medium mt-0.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                        <span id="discord-presence-count">{view.online}</span>
                        <span data-i18n="discordOnline">miembros en línea</span>
                        <span class="text-slate-500">·</span>
                        <span id="discord-voice-count">{view.inVoice}</span>
                        <span data-i18n="discordInVoice">en voz</span>
                    </p>
                </div>
            </div>

            <!-- Canales de voz con su gente + el resto en línea -->
            <div class="space-y-2 pt-2 border-t border-white/[0.06]">
                <span
                    class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block"
                    data-i18n="discordChannels"
                >
                    Canales de voz y estudio
                </span>
                <div
                    id="discord-voice"
                    class="max-h-80 overflow-y-auto pr-1"
                    set:html={renderVoice(view)}
                />
            </div>

            <!-- Join Server CTA Button -->
            <a
                href={DISCORD_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 bg-brand-discord hover:bg-brand-discord-hover text-white py-3 rounded-xl text-sm font-bold shadow-lg shadow-brand-discord/25 hover:shadow-brand-discord/40 transition-all transform hover:-translate-y-0.5 mt-1"
            >
                <DiscordIcon class="w-4 h-4" />
                <span data-i18n="discordJoin">Unirse a la Comunidad</span>
            </a>
        </div>

        <!-- VIEW B: Official Discord Iframe Widget -->
        <div
            id="discord-view-official"
            class="hidden flex-col items-center relative z-10"
        >
            <iframe
                src={DISCORD_WIDGET_IFRAME}
                width="310"
                height="400"
                allowtransparency="true"
                frameborder="0"
                sandbox="allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts"
                class="w-full rounded-xl bg-transparent"
                title="Discord Server Widget"
                loading="lazy"
            ></iframe>
        </div>
    </div>
</div>

<script>
    import { DISCORD_WIDGET_API } from "../lib/constants";
    import { buildView, normalize, renderVoice } from "../lib/discord";
    import { getStoredLang } from "../i18n/lang";

    const btnModern = document.getElementById("btn-view-modern");
    const btnOfficial = document.getElementById("btn-view-official");
    const viewModern = document.getElementById("discord-view-modern");
    const viewOfficial = document.getElementById("discord-view-official");

    function setView(mode: "modern" | "official") {
        if (mode === "modern") {
            viewModern?.classList.remove("hidden");
            viewOfficial?.classList.add("hidden");
            btnModern?.classList.add(
                "bg-brand-yellow",
                "text-slate-950",
                "font-bold",
            );
            btnModern?.classList.remove("text-slate-400");
            btnOfficial?.classList.remove(
                "bg-brand-yellow",
                "text-slate-950",
                "font-bold",
            );
            btnOfficial?.classList.add("text-slate-400");
        } else {
            viewModern?.classList.add("hidden");
            viewOfficial?.classList.remove("hidden");
            btnOfficial?.classList.add(
                "bg-brand-yellow",
                "text-slate-950",
                "font-bold",
            );
            btnOfficial?.classList.remove("text-slate-400");
            btnModern?.classList.remove(
                "bg-brand-yellow",
                "text-slate-950",
                "font-bold",
            );
            btnModern?.classList.add("text-slate-400");
        }
    }

    btnModern?.addEventListener("click", () => setView("modern"));
    btnOfficial?.addEventListener("click", () => setView("official"));

    // --- Progressive Client-Side Live Hydration ---
    async function refreshDiscordData() {
        try {
            const res = await fetch(DISCORD_WIDGET_API);
            if (!res.ok) return;
            const data = normalize(await res.json());
            const view = buildView(data);

            const serverNameEl = document.getElementById("discord-server-name");
            if (serverNameEl && data.name) {
                serverNameEl.textContent = data.name;
            }
            const presenceEl = document.getElementById(
                "discord-presence-count",
            );
            if (presenceEl) presenceEl.textContent = String(view.online);
            const voiceCountEl = document.getElementById("discord-voice-count");
            if (voiceCountEl) voiceCountEl.textContent = String(view.inVoice);

            const voiceEl = document.getElementById("discord-voice");
            if (voiceEl) {
                voiceEl.innerHTML = renderVoice(view, getStoredLang());
            }
        } catch {
            // Sin red o bloqueado: se conserva el HTML del build.
        }
    }

    // Refresh immediately on page load
    refreshDiscordData();

    // Periodically refresh every 60s if the tab is visible
    setInterval(() => {
        if (document.visibilityState === "visible") {
            refreshDiscordData();
        }
    }, 60000);
</script>
