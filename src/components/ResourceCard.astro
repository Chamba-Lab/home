---
import {
    displayDomain,
    youtubeThumbnail,
    youtubeVideoId,
    type ResourceType,
} from "../lib/resources";

interface Props {
    title: string;
    descriptionEn: string;
    descriptionEs?: string;
    url: string;
    category: string;
    type?: ResourceType;
    // Canal: URL de la imagen del canal; sin ella (o si falla) se ve la inicial.
    avatar?: string;
    // Video: canal que lo publica.
    channel?: string;
    access?: "free" | "freemium" | "paid";
}

const {
    title,
    descriptionEn,
    descriptionEs,
    url,
    category,
    type = "web",
    avatar,
    channel,
    access,
} = Astro.props;

const videoId = type === "video" ? youtubeVideoId(url) : undefined;
const formatLabel = {
    channel: { es: "Canal de YouTube", en: "YouTube channel" },
    video: { es: "Video de YouTube", en: "YouTube video" },
} as const;

const accessBadges = {
    free: {
        es: "Gratis",
        en: "Free",
        class: "border-emerald-500/30 text-emerald-400",
    },
    freemium: {
        es: "Gratis + de pago",
        en: "Free + paid",
        class: "border-amber-500/30 text-amber-400",
    },
    paid: {
        es: "De pago",
        en: "Paid",
        class: "border-slate-500/40 text-slate-300",
    },
} as const;
const accessBadge = access ? accessBadges[access] : undefined;

const categoryBadges: Record<
    string,
    { label: string; labelEn: string; class: string }
> = {
    cv: {
        label: "CV & LinkedIn",
        labelEn: "CV & LinkedIn",
        class: "border-brand-yellow/30 bg-brand-yellow/10 text-brand-yellow",
    },
    empleo: {
        label: "Portales de empleo",
        labelEn: "Job boards",
        class: "border-sky-500/30 bg-sky-500/10 text-sky-400",
    },
    aprendizaje: {
        label: "Aprendizaje",
        labelEn: "Learning",
        class: "border-emerald-500/30 bg-emerald-500/10 text-emerald-400",
    },
    certificacion: {
        label: "Certificaciones",
        labelEn: "Certifications",
        class: "border-orange-500/30 bg-orange-500/10 text-orange-400",
    },
    becas: {
        label: "Oportunidades académicas",
        labelEn: "Academic opportunities",
        class: "border-rose-500/30 bg-rose-500/10 text-rose-400",
    },
    ia: {
        label: "Herramientas de IA",
        labelEn: "AI tools",
        class: "border-fuchsia-500/30 bg-fuchsia-500/10 text-fuchsia-400",
    },
    opensource: {
        label: "Open source y GitHub",
        labelEn: "Open source & GitHub",
        class: "border-slate-400/30 bg-slate-400/10 text-slate-300",
    },
    practica: {
        label: "Práctica Técnica",
        labelEn: "Technical Practice",
        class: "border-brand-discord/30 bg-brand-discord/10 text-[#8a95ff]",
    },
};

const badge = categoryBadges[category] || {
    label: category,
    labelEn: category,
    class: "border-white/10 bg-slate-900 text-slate-300",
};
const isVideo = type === "video";
---

<div
    data-resource-card={category}
    data-resource-format={type}
    class={`card-glass rounded-2xl flex flex-col justify-between group transition-all duration-300 hover:border-brand-yellow/40 hover:-translate-y-0.5 shadow-lg shadow-black/20 ${isVideo ? "overflow-hidden" : "p-6"}`}
>
    <div class="flex flex-col">
        {
            videoId && (
                <a
                    href={url}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-video-id={videoId}
                    data-video-title={title}
                    class="video-thumb relative block aspect-video w-full overflow-hidden bg-slate-900"
                    aria-label={`Reproducir: ${title}`}
                >
                    <img
                        src={youtubeThumbnail(videoId)}
                        alt=""
                        loading="lazy"
                        width="480"
                        height="360"
                        class="h-full w-full object-cover opacity-90 transition-opacity group-hover:opacity-100"
                    />
                    <span class="absolute inset-0 m-auto flex h-14 w-14 items-center justify-center rounded-full bg-red-600 shadow-lg shadow-black/40 transition-transform group-hover:scale-110">
                        <svg
                            class="ml-0.5 h-6 w-6 fill-white"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                        >
                            <path d="M8 5v14l11-7z" />
                        </svg>
                    </span>
                </a>
            )
        }
        <div class={`flex flex-col ${isVideo ? "px-6 pt-5" : ""}`}>
            <div class="flex items-center justify-between gap-2 mb-4">
                <span
                    class={`text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded border ${badge.class}`}
                    data-i18n-es={badge.label}
                    data-i18n-en={badge.labelEn}
                >
                    {badge.label}
                </span>
                {
                    accessBadge && (
                        <span
                            class={`text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded border ${accessBadge.class}`}
                            data-i18n-es={accessBadge.es}
                            data-i18n-en={accessBadge.en}
                        >
                            {accessBadge.es}
                        </span>
                    )
                }
                {
                    type !== "web" && (
                        <span
                            class="text-[11px] font-semibold text-slate-400 whitespace-nowrap"
                            data-i18n-es={formatLabel[type].es}
                            data-i18n-en={formatLabel[type].en}
                        >
                            {formatLabel[type].es}
                        </span>
                    )
                }
            </div>
            {
                type === "channel" ? (
                    <div class="flex items-center gap-4 mb-3 min-w-0">
                        <span
                            class="relative flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-full border-2 border-white/20 bg-slate-800 bg-clip-padding font-display text-xl font-extrabold text-white"
                            aria-hidden="true"
                        >
                            {title.charAt(0).toUpperCase()}
                            {avatar && (
                                <img
                                    src={avatar}
                                    alt=""
                                    width="56"
                                    height="56"
                                    loading="lazy"
                                    decoding="async"
                                    referrerpolicy="no-referrer"
                                    onerror="this.remove()"
                                    class="absolute inset-0 h-full w-full bg-slate-900 object-cover"
                                />
                            )}
                        </span>
                        <h2 class="min-w-0 font-display text-lg font-bold text-white group-hover:text-brand-yellow transition-colors leading-snug">
                            {title}
                        </h2>
                    </div>
                ) : (
                    <div class="mb-2">
                        <h2 class="font-display text-lg font-bold text-white group-hover:text-brand-yellow transition-colors leading-snug">
                            {title}
                        </h2>
                        {isVideo && channel && (
                            <p class="mt-1 text-xs font-medium text-slate-400">
                                {channel}
                            </p>
                        )}
                        {type === "web" && (
                            <p class="mt-1 text-xs text-slate-500">
                                {displayDomain(url)}
                            </p>
                        )}
                    </div>
                )
            }
            <p
                class="text-sm text-slate-400 leading-relaxed"
                data-i18n-en={descriptionEn}
                data-i18n-es={descriptionEs}
            >
                {descriptionEs ?? descriptionEn}
            </p>
        </div>
    </div>
    <div
        class={`pt-5 mt-5 border-t border-white/10 flex items-center justify-between ${isVideo ? "mx-6 mb-6" : ""}`}
    >
        <a
            class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-yellow hover:text-white transition-colors group-hover:translate-x-0.5 transform duration-200"
            href={url}
            target="_blank"
            rel="noopener noreferrer"
        >
            {
                type === "web" ? (
                    <span data-i18n="exploreResource">Explorar recurso</span>
                ) : type === "channel" ? (
                    <span data-i18n-es="Ver canal" data-i18n-en="Visit channel">
                        Ver canal
                    </span>
                ) : (
                    <span
                        data-i18n-es="Ver en YouTube"
                        data-i18n-en="Watch on YouTube"
                    >
                        Ver en YouTube
                    </span>
                )
            }
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-3.5 h-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
        </a>
    </div>
</div>
