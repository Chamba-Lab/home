---
interface Props {
    title: string;
    descriptionEn: string;
    descriptionEs?: string;
    url: string;
    category: string;
    access?: "free" | "freemium" | "paid";
}

const { title, descriptionEn, descriptionEs, url, category, access } =
    Astro.props;

const accessBadges = {
    free: {
        es: "Gratis",
        en: "Free",
        class: "border-emerald-500/30 text-emerald-400",
    },
    freemium: {
        es: "Gratis + de pago",
        en: "Free + paid",
        class: "border-amber-500/30 text-amber-400",
    },
    paid: {
        es: "De pago",
        en: "Paid",
        class: "border-slate-500/40 text-slate-300",
    },
} as const;
const accessBadge = access ? accessBadges[access] : undefined;

const categoryBadges: Record<
    string,
    { label: string; labelEn: string; class: string }
> = {
    cv: {
        label: "CV & LinkedIn",
        labelEn: "CV & LinkedIn",
        class: "border-brand-yellow/30 bg-brand-yellow/10 text-brand-yellow",
    },
    empleo: {
        label: "Portales de empleo",
        labelEn: "Job boards",
        class: "border-sky-500/30 bg-sky-500/10 text-sky-400",
    },
    aprendizaje: {
        label: "Aprendizaje",
        labelEn: "Learning",
        class: "border-emerald-500/30 bg-emerald-500/10 text-emerald-400",
    },
    certificacion: {
        label: "Certificaciones",
        labelEn: "Certifications",
        class: "border-orange-500/30 bg-orange-500/10 text-orange-400",
    },
    ia: {
        label: "Herramientas de IA",
        labelEn: "AI tools",
        class: "border-fuchsia-500/30 bg-fuchsia-500/10 text-fuchsia-400",
    },
    opensource: {
        label: "Open source y GitHub",
        labelEn: "Open source & GitHub",
        class: "border-slate-400/30 bg-slate-400/10 text-slate-300",
    },
    practica: {
        label: "Práctica Técnica",
        labelEn: "Technical Practice",
        class: "border-brand-discord/30 bg-brand-discord/10 text-[#8a95ff]",
    },
};

const badge = categoryBadges[category] || {
    label: category,
    labelEn: category,
    class: "border-white/10 bg-slate-900 text-slate-300",
};
---

<div
    data-resource-card={category}
    class="card-glass rounded-2xl p-6 flex flex-col justify-between group transition-all duration-300 hover:border-brand-yellow/40 hover:-translate-y-0.5 shadow-lg shadow-black/20"
>
    <div class="flex flex-col">
        <div class="flex items-center justify-between mb-4">
            <span
                class={`text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded border ${badge.class}`}
                data-i18n-es={badge.label}
                data-i18n-en={badge.labelEn}
            >
                {badge.label}
            </span>
            {
                accessBadge && (
                    <span
                        class={`text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded border ${accessBadge.class}`}
                        data-i18n-es={accessBadge.es}
                        data-i18n-en={accessBadge.en}
                    >
                        {accessBadge.es}
                    </span>
                )
            }
        </div>
        <h2
            class="font-display text-lg font-bold text-white mb-2 group-hover:text-brand-yellow transition-colors leading-snug"
        >
            {title}
        </h2>
        <p
            class="text-sm text-slate-400 leading-relaxed"
            data-i18n-en={descriptionEn}
            data-i18n-es={descriptionEs}
        >
            {descriptionEs ?? descriptionEn}
        </p>
    </div>
    <div
        class="pt-5 mt-5 border-t border-white/10 flex items-center justify-between"
    >
        <a
            class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-yellow hover:text-white transition-colors group-hover:translate-x-0.5 transform duration-200"
            href={url}
            target="_blank"
            rel="noopener noreferrer"
        >
            <span data-i18n="exploreResource">Explorar recurso</span>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-3.5 h-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
        </a>
    </div>
</div>
