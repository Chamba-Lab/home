---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const resources = await getCollection("resources");

const categoryOrder = ["cv", "aprendizaje", "practica"] as const;
const categoryLabel: Record<
    (typeof categoryOrder)[number],
    { en: string; es: string }
> = {
    cv: { en: "CV & LinkedIn", es: "CV y LinkedIn" },
    aprendizaje: { en: "Learning", es: "Aprendizaje" },
    practica: { en: "Technical practice", es: "Práctica técnica" },
};

const grouped = categoryOrder.map((category) => ({
    category,
    label: categoryLabel[category],
    items: resources.filter((r) => r.data.category === category),
}));
---

<Layout title="Chamba Lab | Recursos">
    <main class="max-w-3xl mx-auto px-6 py-20 sm:py-28">
        <h1
            class="text-4xl md:text-5xl font-display font-bold mb-4 tracking-tight text-slate-900 dark:text-white"
            data-i18n="resourcesTitle"
        >
            Recursos
        </h1>
        <p
            class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed mb-8"
            data-i18n="resourcesIntro"
        >
            Una selección de guías, plataformas de práctica y plantillas que la
            comunidad recomienda.
        </p>

        <div class="mb-8 space-y-4">
            <input
                id="resource-search"
                type="search"
                data-i18n-placeholder-en="Search resources..."
                data-i18n-placeholder-es="Buscar recursos..."
                placeholder="Buscar recursos..."
                class="w-full px-4 py-2.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/50 text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500"
            />
            <div class="flex flex-wrap gap-2">
                <button
                    type="button"
                    data-filter="all"
                    aria-pressed="true"
                    class="resource-filter-pill px-3 py-1.5 rounded-full text-xs font-semibold border transition-colors bg-indigo-600 border-indigo-600 text-white"
                    data-i18n="filterAll"
                >
                    Todos
                </button>
                {
                    categoryOrder.map((category) => (
                        <button
                            type="button"
                            data-filter={category}
                            aria-pressed="false"
                            class="resource-filter-pill px-3 py-1.5 rounded-full text-xs font-semibold border transition-colors bg-white dark:bg-slate-800/50 border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300"
                            data-i18n-en={categoryLabel[category].en}
                            data-i18n-es={categoryLabel[category].es}
                        >
                            {categoryLabel[category].es}
                        </button>
                    ))
                }
            </div>
        </div>

        <div class="space-y-12">
            {
                grouped.map(
                    (group) =>
                        group.items.length > 0 && (
                            <section data-resource-section={group.category}>
                                <h2
                                    class="text-sm font-semibold uppercase tracking-wide text-indigo-600 dark:text-indigo-400 mb-4"
                                    data-i18n-en={group.label.en}
                                    data-i18n-es={group.label.es}
                                >
                                    {group.label.es}
                                </h2>
                                <div class="grid sm:grid-cols-2 gap-4">
                                    {group.items.map((item) => (
                                        <a
                                            href={item.data.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            data-resource-card={
                                                item.data.category
                                            }
                                            class="block p-5 rounded-xl bg-white dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 hover:border-indigo-300 dark:hover:border-indigo-700 shadow-sm hover:shadow-md transition-all"
                                        >
                                            <h3 class="font-semibold text-slate-900 dark:text-white mb-2">
                                                {item.data.title}
                                            </h3>
                                            <p
                                                class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed"
                                                data-i18n-en={
                                                    item.data.description.en
                                                }
                                                data-i18n-es={
                                                    item.data.description.es
                                                }
                                            >
                                                {item.data.description.es ??
                                                    item.data.description.en}
                                            </p>
                                        </a>
                                    ))}
                                </div>
                            </section>
                        ),
                )
            }
        </div>

        <p
            id="resources-empty"
            hidden
            class="text-sm text-slate-500 dark:text-slate-400 py-10 text-center border border-dashed border-slate-200 dark:border-slate-700 rounded-xl"
            data-i18n="noResourcesFound"
        >
            No encontramos recursos que coincidan con tu búsqueda.
        </p>
    </main>

    <script>
        const searchInput =
            document.querySelector<HTMLInputElement>("#resource-search");
        const pills = Array.from(
            document.querySelectorAll<HTMLButtonElement>("[data-filter]"),
        );
        const sections = Array.from(
            document.querySelectorAll<HTMLElement>("[data-resource-section]"),
        );
        const emptyState =
            document.querySelector<HTMLElement>("#resources-empty");

        let activeFilter = "all";

        function normalize(text: string) {
            return text.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
        }

        function applyFilter() {
            const query = normalize(searchInput?.value ?? "");
            let anyVisible = false;

            sections.forEach((section) => {
                let sectionHasVisible = false;
                section
                    .querySelectorAll<HTMLElement>("[data-resource-card]")
                    .forEach((card) => {
                        const matchesCategory =
                            activeFilter === "all" ||
                            card.dataset.resourceCard === activeFilter;
                        const matchesQuery =
                            query === "" ||
                            normalize(card.textContent ?? "").includes(query);
                        const visible = matchesCategory && matchesQuery;
                        card.hidden = !visible;
                        if (visible) sectionHasVisible = true;
                    });
                section.hidden = !sectionHasVisible;
                if (sectionHasVisible) anyVisible = true;
            });

            if (emptyState) emptyState.hidden = anyVisible;
        }

        pills.forEach((pill) => {
            pill.addEventListener("click", () => {
                activeFilter = pill.dataset.filter ?? "all";
                pills.forEach((p) => {
                    const active = p === pill;
                    p.setAttribute("aria-pressed", String(active));
                    p.classList.toggle("bg-indigo-600", active);
                    p.classList.toggle("border-indigo-600", active);
                    p.classList.toggle("text-white", active);
                    p.classList.toggle("bg-white", !active);
                    p.classList.toggle("dark:bg-slate-800/50", !active);
                    p.classList.toggle("border-slate-200", !active);
                    p.classList.toggle("dark:border-slate-700", !active);
                    p.classList.toggle("text-slate-600", !active);
                    p.classList.toggle("dark:text-slate-300", !active);
                });
                applyFilter();
            });
        });

        searchInput?.addEventListener("input", applyFilter);

        document.addEventListener("chamba-lab:lang", (event) => {
            const lang = (event as CustomEvent<{ lang: "es" | "en" }>).detail
                .lang;
            if (searchInput) {
                searchInput.placeholder =
                    lang === "es"
                        ? (searchInput.dataset.i18nPlaceholderEs ?? "")
                        : (searchInput.dataset.i18nPlaceholderEn ?? "");
            }
            applyFilter();
        });
    </script>
</Layout>
