---
import Layout from "../layouts/Layout.astro";
import DiscordIcon from "../components/icons/DiscordIcon.astro";
import { DISCORD_URL } from "../lib/constants";
import { getCollection } from "astro:content";
import order from "../content/activities.json";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

// The collection does not keep the file order: follow the one in the JSON.
const ids = order.map((activity) => activity.id);
const activities = (await getCollection("activities")).sort(
    (a, b) => ids.indexOf(a.id) - ids.indexOf(b.id),
);
---

<Layout
    title="Dinámicas y actividades comunitarias | Chamba Lab"
    description="Mini actividades para la comunidad. Gira la ruleta, elige un tema, debate en vivo o desafíate a ti mismo en sesiones de Discord."
    breadcrumbs={[
        { name: "Inicio", path: "/" },
        { name: "Dinámicas", path: "/activities/" },
    ]}
>
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
        <!-- Header -->
        <div class="max-w-3xl mb-12">
            <h1
                class="font-display text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4"
                data-i18n="dynamicsTitle"
            >
                Dinámicas
            </h1>
            <p
                class="text-lg text-slate-300 leading-relaxed"
                data-i18n="dynamicsIntro"
            >
                Mini actividades para la comunidad. Gira la ruleta, elige un
                tema, debate en vivo o desafíate a ti mismo. Perfecto para
                sesiones en Discord, eventos o simplemente para romper el hielo.
            </p>
        </div>

        <!-- Activities Grid -->
        <section class="mb-16">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {activities.map((activity) => {
                    const { data } = activity;
                    const available = data.status === "available";
                    const Tag = available ? "a" : "div";
                    return (
                        <Tag
                            href={
                                available
                                    ? `${base}activities/${activity.id}/`
                                    : undefined
                            }
                            class={
                                available
                                    ? "card-glass rounded-2xl p-7 flex flex-col justify-between group transition-all duration-300 hover:border-brand-yellow/40 hover:-translate-y-0.5 shadow-lg shadow-black/20"
                                    : "card-glass rounded-2xl p-7 flex flex-col justify-between border border-white/5 opacity-60 bg-slate-900/40"
                            }
                        >
                            <div>
                                <div
                                    class="mb-5 grid h-14 w-14 place-items-center rounded-2xl border border-brand-yellow/25 bg-brand-yellow/10 text-3xl"
                                    aria-hidden="true"
                                >
                                    {data.icon}
                                </div>
                                <h3
                                    class:list={[
                                        "font-display text-2xl font-bold mb-2 leading-snug transition-colors",
                                        available
                                            ? "text-white group-hover:text-brand-yellow"
                                            : "text-slate-300",
                                    ]}
                                    data-i18n-es={data.name.es}
                                    data-i18n-en={data.name.en}
                                >
                                    {data.name.es}
                                </h3>
                                <p
                                    class="text-sm text-slate-400 leading-relaxed mb-6"
                                    data-i18n-es={data.description.es}
                                    data-i18n-en={data.description.en}
                                >
                                    {data.description.es}
                                </p>
                                <ul class="mb-6 space-y-2 text-xs font-semibold text-slate-300">
                                    <li class="flex items-center gap-2">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="h-4 w-4 shrink-0 text-brand-yellow"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            aria-hidden="true"
                                        >
                                            <circle cx="12" cy="12" r="9" />
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M12 7v5l3 2"
                                            />
                                        </svg>
                                        <span>{data.duration}</span>
                                    </li>
                                    <li class="flex items-center gap-2">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="h-4 w-4 shrink-0 text-brand-yellow"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            aria-hidden="true"
                                        >
                                            <rect
                                                x="9"
                                                y="3"
                                                width="6"
                                                height="11"
                                                rx="3"
                                            />
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M5 11a7 7 0 0014 0M12 18v3"
                                            />
                                        </svg>
                                        <span
                                            data-i18n-es={data.format.es}
                                            data-i18n-en={data.format.en}
                                        >
                                            {data.format.es}
                                        </span>
                                    </li>
                                    <li class="flex items-center gap-2">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="h-4 w-4 shrink-0 text-brand-yellow"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            aria-hidden="true"
                                        >
                                            <circle cx="12" cy="12" r="9" />
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M8 12.5l3 3 5-6"
                                            />
                                        </svg>
                                        <span
                                            data-i18n-es={data.prep.es}
                                            data-i18n-en={data.prep.en}
                                        >
                                            {data.prep.es}
                                        </span>
                                    </li>
                                </ul>
                            </div>
                            <div class="pt-5 border-t border-white/10">
                                {available ? (
                                    <span class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-yellow group-hover:translate-x-1 transition-transform">
                                        <span data-i18n="dynamicsTry">
                                            Probar dinámica
                                        </span>
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="w-3.5 h-3.5"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                            aria-hidden="true"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M14 5l7 7m0 0l-7 7m7-7H3"
                                            />
                                        </svg>
                                    </span>
                                ) : (
                                    <span
                                        class="text-xs text-slate-500 font-semibold"
                                        data-i18n="dynamicsInDev"
                                    >
                                        En desarrollo para la comunidad
                                    </span>
                                )}
                            </div>
                        </Tag>
                    );
                })}
            </div>
        </section>

        <!-- Discord Suggestion Box -->
        <div class="card-glass rounded-2xl p-8 flex flex-col sm:flex-row items-center justify-between gap-6 border border-white/10 bg-gradient-to-br from-surface via-slate-900/80 to-brand-discord/10">
            <div class="space-y-1 text-center sm:text-left">
                <h3
                    class="font-display text-xl font-bold text-white"
                    data-i18n="dynamicsSuggestTitle"
                >
                    ¿Tienes ideas para más dinámicas o juegos?
                </h3>
                <p
                    class="text-sm text-slate-400"
                    data-i18n="dynamicsSuggestDesc"
                >
                    Comparte tus propuestas y feedback en la comunidad de
                    Discord.
                </p>
            </div>
            <a
                href={DISCORD_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-brand-discord hover:bg-brand-discord-hover text-white px-6 py-3 rounded-xl text-sm font-bold transition-all shadow-lg shadow-brand-discord/25 hover:shadow-brand-discord/40 shrink-0"
            >
                <DiscordIcon class="w-4 h-4" />
                <span data-i18n="dynamicsSuggestCta">Ir a Discord</span>
            </a>
        </div>
    </main>
</Layout>
