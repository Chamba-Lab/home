---
import Layout from "../layouts/Layout.astro";
import DiscordIcon from "../components/icons/DiscordIcon.astro";
import { DISCORD_URL } from "../lib/constants";
import { getCollection } from "astro:content";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const activitiesData = await getCollection("activities");
const config = activitiesData[0]?.data;

if (!config) {
    throw new Error("Activities configuration not found");
}

const { activities } = config;
---

<Layout title="Chamba Lab | Dinámicas y Actividades Comunitarias">
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
        <!-- Header -->
        <div class="max-w-3xl mb-12">
            <div
                class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full card-glass text-xs font-semibold text-slate-300 border border-white/10 mb-6"
            >
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"
                ></span>
                <span>Dinámicas Comunitarias</span>
            </div>
            <h1
                class="font-display text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4"
                data-i18n="dynamicsTitle"
            >
                Dinámicas
            </h1>
            <p
                class="text-lg text-slate-300 leading-relaxed"
                data-i18n="dynamicsIntro"
            >
                Mini actividades para la comunidad. Gira la ruleta, elige un
                tema, debate en vivo o desafíate a ti mismo. Perfecto para
                sesiones en Discord, eventos o simplemente para romper el hielo.
            </p>
        </div>

        <!-- Activities Grid -->
        <section class="mb-16">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {
                    activities.map((activity, i) =>
                        activity.status === "available" ? (
                            <a
                                href={`${base}activities/${activity.id}`}
                                class="card-glass rounded-2xl p-7 flex flex-col justify-between group transition-all duration-300 hover:border-brand-yellow/40 hover:-translate-y-0.5 shadow-lg shadow-black/20"
                            >
                                <div>
                                    <div class="flex items-center justify-between mb-4">
                                        <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-brand-yellow/10 border border-brand-yellow/30 text-brand-yellow">
                                            Dinámica{" "}
                                            {String(i + 1).padStart(2, "0")} •
                                            Activa
                                        </span>
                                    </div>
                                    <h3 class="font-display text-2xl font-bold text-white mb-2 group-hover:text-brand-yellow transition-colors leading-snug">
                                        {activity.name}
                                    </h3>
                                    <p class="text-sm text-slate-400 leading-relaxed mb-6">
                                        {activity.description}
                                    </p>
                                </div>
                                <div class="pt-5 border-t border-white/10 flex items-center justify-between">
                                    <span class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-yellow group-hover:translate-x-1 transition-transform">
                                        <span>Probar dinámica</span>
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="w-3.5 h-3.5"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M14 5l7 7m0 0l-7 7m7-7H3"
                                            />
                                        </svg>
                                    </span>
                                </div>
                            </a>
                        ) : (
                            <div class="card-glass rounded-2xl p-7 flex flex-col justify-between border border-white/5 opacity-60 bg-slate-900/40">
                                <div>
                                    <div class="flex items-center justify-between mb-4">
                                        <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-slate-800 text-slate-400 border border-white/10">
                                            Próximamente
                                        </span>
                                    </div>
                                    <h3 class="font-display text-2xl font-bold text-slate-300 mb-2 leading-snug">
                                        {activity.name}
                                    </h3>
                                    <p class="text-sm text-slate-500 leading-relaxed">
                                        {activity.description}
                                    </p>
                                </div>
                                <div class="pt-5 border-t border-white/5">
                                    <span class="text-xs text-slate-500 font-semibold">
                                        En desarrollo para la comunidad
                                    </span>
                                </div>
                            </div>
                        ),
                    )
                }
            </div>
        </section>

        <!-- Discord Suggestion Box -->
        <div
            class="card-glass rounded-2xl p-8 flex flex-col sm:flex-row items-center justify-between gap-6 border border-white/10 bg-gradient-to-br from-[#0B1120] via-slate-900/80 to-[#5865F2]/10"
        >
            <div class="space-y-1 text-center sm:text-left">
                <h3 class="font-display text-xl font-bold text-white">
                    ¿Tienes ideas para más dinámicas o juegos?
                </h3>
                <p class="text-sm text-slate-400">
                    Comparte tus propuestas y feedback en la comunidad de
                    Discord.
                </p>
            </div>
            <a
                href={DISCORD_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-[#5865F2] hover:bg-[#4752c4] text-white px-6 py-3 rounded-xl text-sm font-bold transition-all shadow-lg shadow-[#5865F2]/25 hover:shadow-[#5865F2]/40 shrink-0"
            >
                <DiscordIcon class="w-4 h-4" />
                <span>Ir a Discord</span>
            </a>
        </div>
    </main>
</Layout>
