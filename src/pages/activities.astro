---
import Layout from "../layouts/Layout.astro";
import DiscordIcon from "../components/icons/DiscordIcon.astro";
import { DISCORD_URL } from "../lib/constants";
import { getCollection } from "astro:content";
import order from "../content/activities.json";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

// The collection does not keep the file order: follow the one in the JSON.
const ids = order.map((activity) => activity.id);
const activities = (await getCollection("activities")).sort(
    (a, b) => ids.indexOf(a.id) - ids.indexOf(b.id),
);

// English copy of the cards (the JSON data is in Spanish).
const EN: Record<string, { name: string; description: string }> = {
    roulette: {
        name: "🎡 The Roulette",
        description:
            "Spin and discover a topic to debate or improvise. Free mode or preset topics.",
    },
    "quick-questions": {
        name: "⚡ Quick Questions",
        description: "Lightning quiz to break the ice in community sessions.",
    },
};
---

<Layout
    title="Dinámicas y actividades comunitarias | Chamba Lab"
    description="Mini actividades para la comunidad. Gira la ruleta, elige un tema, debate en vivo o desafíate a ti mismo en sesiones de Discord."
    breadcrumbs={[
        { name: "Inicio", path: "/" },
        { name: "Dinámicas", path: "/activities/" },
    ]}
>
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
        <!-- Header -->
        <div class="max-w-3xl mb-12">
            <h1
                class="font-display text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4"
                data-i18n="dynamicsTitle"
            >
                Dinámicas
            </h1>
            <p
                class="text-lg text-slate-300 leading-relaxed"
                data-i18n="dynamicsIntro"
            >
                Mini actividades para la comunidad. Gira la ruleta, elige un
                tema, debate en vivo o desafíate a ti mismo. Perfecto para
                sesiones en Discord, eventos o simplemente para romper el hielo.
            </p>
        </div>

        <!-- Activities Grid -->
        <section class="mb-16">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {activities.map((activity, i) =>
                    activity.data.status === "available" ? (
                        <a
                            href={`${base}activities/${activity.id}/`}
                            class="card-glass rounded-2xl p-7 flex flex-col justify-between group transition-all duration-300 hover:border-brand-yellow/40 hover:-translate-y-0.5 shadow-lg shadow-black/20"
                        >
                            <div>
                                <div class="flex items-center justify-between mb-4">
                                    <span
                                        class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-brand-yellow/10 border border-brand-yellow/30 text-brand-yellow"
                                        data-i18n-es={`Dinámica ${String(i + 1).padStart(2, "0")} • Activa`}
                                        data-i18n-en={`Dynamic ${String(i + 1).padStart(2, "0")} • Active`}
                                    >
                                        Dinámica{" "}
                                        {String(i + 1).padStart(2, "0")} •
                                        Activa
                                    </span>
                                </div>
                                <h3
                                    class="font-display text-2xl font-bold text-white mb-2 group-hover:text-brand-yellow transition-colors leading-snug"
                                    data-i18n-es={activity.data.name}
                                    data-i18n-en={
                                        EN[activity.id]?.name ??
                                        activity.data.name
                                    }
                                >
                                    {activity.data.name}
                                </h3>
                                <p
                                    class="text-sm text-slate-400 leading-relaxed mb-6"
                                    data-i18n-es={activity.data.description}
                                    data-i18n-en={
                                        EN[activity.id]?.description ??
                                        activity.data.description
                                    }
                                >
                                    {activity.data.description}
                                </p>
                            </div>
                            <div class="pt-5 border-t border-white/10 flex items-center justify-between">
                                <span class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-yellow group-hover:translate-x-1 transition-transform">
                                    <span data-i18n="dynamicsTry">
                                        Probar dinámica
                                    </span>
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="w-3.5 h-3.5"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M14 5l7 7m0 0l-7 7m7-7H3"
                                        />
                                    </svg>
                                </span>
                            </div>
                        </a>
                    ) : (
                        <div class="card-glass rounded-2xl p-7 flex flex-col justify-between border border-white/5 opacity-60 bg-slate-900/40">
                            <div>
                                <div class="flex items-center justify-between mb-4">
                                    <span
                                        class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-slate-800 text-slate-400 border border-white/10"
                                        data-i18n="dynamicsComingSoon"
                                    >
                                        Próximamente
                                    </span>
                                </div>
                                <h3
                                    class="font-display text-2xl font-bold text-slate-300 mb-2 leading-snug"
                                    data-i18n-es={activity.data.name}
                                    data-i18n-en={
                                        EN[activity.id]?.name ??
                                        activity.data.name
                                    }
                                >
                                    {activity.data.name}
                                </h3>
                                <p
                                    class="text-sm text-slate-500 leading-relaxed"
                                    data-i18n-es={activity.data.description}
                                    data-i18n-en={
                                        EN[activity.id]?.description ??
                                        activity.data.description
                                    }
                                >
                                    {activity.data.description}
                                </p>
                            </div>
                            <div class="pt-5 border-t border-white/5">
                                <span
                                    class="text-xs text-slate-500 font-semibold"
                                    data-i18n="dynamicsInDev"
                                >
                                    En desarrollo para la comunidad
                                </span>
                            </div>
                        </div>
                    ),
                )}
            </div>
        </section>

        <!-- Discord Suggestion Box -->
        <div class="card-glass rounded-2xl p-8 flex flex-col sm:flex-row items-center justify-between gap-6 border border-white/10 bg-gradient-to-br from-surface via-slate-900/80 to-brand-discord/10">
            <div class="space-y-1 text-center sm:text-left">
                <h3
                    class="font-display text-xl font-bold text-white"
                    data-i18n="dynamicsSuggestTitle"
                >
                    ¿Tienes ideas para más dinámicas o juegos?
                </h3>
                <p
                    class="text-sm text-slate-400"
                    data-i18n="dynamicsSuggestDesc"
                >
                    Comparte tus propuestas y feedback en la comunidad de
                    Discord.
                </p>
            </div>
            <a
                href={DISCORD_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-brand-discord hover:bg-brand-discord-hover text-white px-6 py-3 rounded-xl text-sm font-bold transition-all shadow-lg shadow-brand-discord/25 hover:shadow-brand-discord/40 shrink-0"
            >
                <DiscordIcon class="w-4 h-4" />
                <span data-i18n="dynamicsSuggestCta">Ir a Discord</span>
            </a>
        </div>
    </main>
</Layout>
