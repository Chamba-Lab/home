---
import Layout from "../layouts/Layout.astro";
import DiscordCta from "../components/DiscordCta.astro";
---

<Layout title="Chamba Lab | Comunidad Tech">
    <main
        class="max-w-3xl mx-auto px-6 py-24 sm:py-32 flex flex-col items-center text-center"
    >
        <!-- Badge -->
        <div
            class="inline-flex items-center px-3 py-1 border-[3px] border-border bg-accent text-on-accent shadow-brutal-sm text-xs font-bold uppercase mb-6"
        >
            <span data-i18n="badge">Comunidad Tech</span>
        </div>

        <!-- Heading -->
        <h1
            class="text-5xl md:text-7xl font-display uppercase mb-6 tracking-tight text-content"
        >
            Chamba <span class="bg-accent text-on-accent px-2">Lab</span>
        </h1>

        <!-- Intro -->
        <p
            class="text-lg md:text-xl text-muted max-w-2xl leading-relaxed"
            data-i18n="intro"
        >
            Una comunidad para quienes construyen su carrera en tech —
            estudiantes, profesionales y todo lo que hay en el medio.
            Compartimos conocimiento, oportunidades y apoyo real para crecer
            juntos. Todo pasa en nuestro Discord.
        </p>

        <!-- CTA -->
        <div class="mt-10">
            <DiscordCta />
        </div>
    </main>
</Layout>
