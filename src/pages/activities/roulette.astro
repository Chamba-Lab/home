---
import Layout from "../../layouts/Layout.astro";
import RouletteWheel from "../../components/RouletteWheel";
import { getCollection } from "astro:content";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const activitiesData = await getCollection("activities");
const config = activitiesData[0]?.data;

if (!config) {
    throw new Error("Activities configuration not found");
}

const { roulette } = config;
---

<Layout title="Chamba Lab | La Ruleta">
    <main class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
        <!-- Back Link -->
        <a
            href={`${base}activities`}
            class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-300 hover:text-brand-yellow transition-colors card-glass border border-white/10 px-3.5 py-2 rounded-xl mb-8"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-3.5 h-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>Volver a Dinámicas</span>
        </a>

        <!-- Header -->
        <div class="mb-8">
            <span
                class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-brand-yellow/10 border border-brand-yellow/30 text-brand-yellow inline-block mb-3"
            >
                Dinámica 01 • Rompehielos
            </span>
            <h1
                class="font-display text-3xl sm:text-4xl font-extrabold text-white tracking-tight"
            >
                🎡 La Ruleta
            </h1>
        </div>

        <!-- Wheel Island Card -->
        <div
            class="card-glass rounded-2xl p-6 sm:p-8 border border-white/10 shadow-2xl mb-10 bg-[#0B1120]/80"
        >
            <RouletteWheel
                client:load
                presets={roulette.presets}
                freeModePlaceholder={roulette.freeMode.placeholder}
                freeModeMaxOptions={roulette.freeMode.maxOptions}
            />
        </div>

        <!-- Help & Instructions Card -->
        <div
            class="card-glass rounded-2xl p-6 sm:p-8 border border-white/10 bg-slate-900/60"
        >
            <h2
                class="font-display text-base font-bold uppercase tracking-wide text-white mb-4 flex items-center gap-2"
            >
                <span>💡</span>
                <span>Cómo usar esta dinámica</span>
            </h2>
            <ul class="space-y-3 text-sm text-slate-300">
                <li class="flex items-start gap-2">
                    <span class="text-brand-yellow font-bold">•</span>
                    <span>
                        <strong class="text-white">Ruleta Libre:</strong> Agrega tus
                        propias opciones personalizadas (hasta 12 alternativas).
                    </span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="text-brand-yellow font-bold">•</span>
                    <span>
                        <strong class="text-white"
                            >Temas Preestablecidos:</strong
                        >
                        Elige entre preguntas de Empleabilidad, Debates Tech o Qué
                        Aprender en 2026.
                    </span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="text-brand-yellow font-bold">•</span>
                    <span>
                        <strong class="text-white">Gira y comparte:</strong> Ideal
                        para abrir debates en llamadas de Discord y romper el hielo.
                    </span>
                </li>
            </ul>
        </div>
    </main>
</Layout>
