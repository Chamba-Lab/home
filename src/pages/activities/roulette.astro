---
import Layout from "../../layouts/Layout.astro";
import RouletteWheel from "../../components/RouletteWheel";
import { getCollection } from "astro:content";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const activitiesData = await getCollection("activities");
const config = activitiesData[0]?.data;

if (!config) {
    throw new Error("Activities configuration not found");
}

const { roulette } = config;
---

<Layout title="Chamba Lab | La Ruleta de la Comunidad">
    <main
        class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 relative"
    >
        <!-- Top Ambient Glow -->
        <div
            class="absolute top-0 left-1/2 -translate-x-1/2 w-96 h-96 bg-brand-yellow/5 rounded-full blur-3xl pointer-events-none -z-10"
        >
        </div>

        <!-- Back Link & Breadcrumb -->
        <div class="flex items-center justify-between mb-8">
            <a
                href={`${base}activities`}
                class="inline-flex items-center gap-2 text-xs font-bold text-slate-300 hover:text-brand-yellow transition-all card-glass border border-white/10 px-4 py-2.5 rounded-xl hover:-translate-x-0.5"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                <span>Volver a Dinámicas</span>
            </a>

            <span
                class="text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-brand-yellow/10 border border-brand-yellow/30 text-brand-yellow hidden sm:inline-block"
            >
                Dinámica 01 • Rompehielos Tech
            </span>
        </div>

        <!-- Page Header -->
        <div class="max-w-3xl mb-10">
            <h1
                class="font-display text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-3 flex items-center gap-3"
            >
                <span>🎡</span>
                <span>La Ruleta de la Comunidad</span>
            </h1>
            <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
                Descubre temas de conversación, dilemas de arquitectura o
                desafíos técnicos para debatir en vivo. Perfecto para dinamizar
                canales de voz en Discord o practicar improvisación técnica.
            </p>
        </div>

        <!-- Wheel Interactive Island -->
        <div class="mb-12">
            <RouletteWheel
                client:load
                presets={roulette.presets}
                freeModePlaceholder={roulette.freeMode.placeholder}
                freeModeMaxOptions={roulette.freeMode.maxOptions}
            />
        </div>

        <!-- How to Use / Discord Moderation Tips -->
        <div
            class="card-glass rounded-2xl p-6 sm:p-8 border border-white/10 bg-[#0B1120]/70"
        >
            <h2
                class="font-display text-lg font-bold text-white mb-4 flex items-center gap-2.5"
            >
                <span class="text-brand-yellow">💡</span>
                <span>Cómo usar esta dinámica en Discord</span>
            </h2>
            <div
                class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm text-slate-300"
            >
                <div
                    class="p-4 rounded-xl bg-slate-900/50 border border-white/5 space-y-1.5"
                >
                    <div
                        class="font-bold text-white text-xs uppercase tracking-wider text-brand-yellow"
                    >
                        01. Selecciona o Personaliza
                    </div>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Elige uno de los packs temáticos (Empleabilidad, Debates
                        Tech, 2026) o escribe preguntas personalizadas en Ruleta
                        Libre.
                    </p>
                </div>
                <div
                    class="p-4 rounded-xl bg-slate-900/50 border border-white/5 space-y-1.5"
                >
                    <div
                        class="font-bold text-white text-xs uppercase tracking-wider text-brand-yellow"
                    >
                        02. Gira y Comparte
                    </div>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Presiona Girar y usa el botón "Copiar pregunta" para
                        pegar el debate directamente en el canal de texto de la
                        sesión.
                    </p>
                </div>
                <div
                    class="p-4 rounded-xl bg-slate-900/50 border border-white/5 space-y-1.5"
                >
                    <div
                        class="font-bold text-white text-xs uppercase tracking-wider text-brand-yellow"
                    >
                        03. Debate en Comunidad
                    </div>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Dale 2 minutos a cada participante para exponer su punto
                        de vista o anécdota. ¡Ideal para romper el hielo!
                    </p>
                </div>
            </div>
        </div>
    </main>
</Layout>
