---
import Layout from "../layouts/Layout.astro";
import EventItem from "../components/EventItem.astro";
import ChevronIcon from "../components/icons/ChevronIcon.astro";
import EventPosters from "../components/EventPosters.astro";
import SeasonalImage from "../components/scene/SeasonalImage.astro";
import { Image } from "astro:assets";
import barista from "../assets/scenes/busts/barista.webp";
import corkboard from "../assets/scenes/cafe/corkboard.webp";
import corkboardChristmas from "../assets/scenes/cafe/corkboard-christmas.webp";
import { DISCORD_URL, EVENT_PROPOSAL_URL, SITE_URL } from "../lib/constants";
import { eventJsonLd } from "../lib/seo";
import { weeklyDates, type EventKind } from "../lib/events";
import { postPath, publishedPosts } from "../lib/posts";
import { getCollection } from "astro:content";

const MONTHS_AHEAD = 12;
// Eventos próximos que se publican como datos estructurados.
const SEO_EVENTS_LIMIT = 10;
const siteOrigin = Astro.site?.origin ?? SITE_URL;

const events = await getCollection("events");

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

// Entradas del blog publicadas, por id: un evento puede enlazar la suya (campo
// `post` de events.json). Si apunta a una que no está publicada, el build
// falla en vez de enlazar a una página que no existe.
const postsById = new Map(
    publishedPosts(await getCollection("posts")).map((post) => [post.id, post]),
);
for (const event of events) {
    const postId = event.data.post?.id;
    if (postId && !postsById.has(postId)) {
        throw new Error(
            `El evento "${event.id}" enlaza la entrada "${postId}", que no existe o está en borrador (draft: true).`,
        );
    }
}

function startOfMonth(d: Date) {
    return new Date(d.getFullYear(), d.getMonth(), 1);
}
function addMonths(d: Date, n: number) {
    return new Date(d.getFullYear(), d.getMonth() + n, 1);
}
function endOfMonth(d: Date) {
    return new Date(d.getFullYear(), d.getMonth() + 1, 0);
}
function isoOf(d: Date) {
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
}
function capitalize(s: string) {
    return s.charAt(0).toUpperCase() + s.slice(1);
}

type I18nText = { en: string; es?: string };

interface Occurrence {
    id: string;
    date: Date;
    dateIso: string;
    startTime?: string;
    endTime?: string;
    timezone?: string;
    isRecurring?: boolean;
    // Serie semanal: su último día y las semanas canceladas (calendarios).
    until?: string;
    exdates?: string[];
    title: I18nText;
    description: I18nText;
    kind?: EventKind;
    tag?: I18nText;
    // Evento nativo de Discord (para marcar «Me interesa» y recibir su aviso).
    discordEvent?: string;
    // Entrada del blog que documenta el evento (solo eventos únicos).
    postUrl?: string;
    postTitle?: string;
    postLang?: string;
}

const currentMonth = startOfMonth(new Date());

function monthsBetween(from: Date, to: Date) {
    return (
        (to.getFullYear() - from.getFullYear()) * 12 +
        (to.getMonth() - from.getMonth())
    );
}

// El calendario arranca en el mes del primer evento registrado (aunque ya
// haya pasado) para que el historial siga siendo navegable.
const earliestMonth = events.reduce((earliest, event) => {
    const iso =
        event.data.type === "fixed" ? event.data.date : event.data.startDate;
    if (!iso) return earliest;
    const [y, m] = iso.split("-").map(Number);
    const month = new Date(y, m - 1, 1);
    return month < earliest ? month : earliest;
}, currentMonth);

const firstMonth = earliestMonth;
const initialIndex = monthsBetween(firstMonth, currentMonth);
const totalMonths = initialIndex + MONTHS_AHEAD;

const months = Array.from({ length: totalMonths }, (_, i) => {
    const monthStart = addMonths(firstMonth, i);
    const monthEnd = endOfMonth(monthStart);
    const occurrences: Occurrence[] = [];

    for (const event of events) {
        const eventId = event.id;
        if (event.data.type === "fixed" && event.data.date) {
            const [y, m, d] = event.data.date.split("-").map(Number);
            const date = new Date(y, m - 1, d);
            if (date >= monthStart && date <= monthEnd) {
                occurrences.push({
                    id: eventId,
                    date,
                    dateIso: event.data.date,
                    startTime: event.data.startTime,
                    endTime: event.data.endTime,
                    timezone: event.data.timezone,
                    isRecurring: false,
                    title: event.data.title,
                    description: event.data.description,
                    kind: event.data.kind,
                    tag: event.data.tag,
                    discordEvent: event.data.discordEvent,
                    ...(event.data.post && {
                        postUrl: postPath(event.data.post.id, base),
                        postTitle: postsById.get(event.data.post.id)?.data
                            .title,
                        postLang: postsById.get(event.data.post.id)?.data.lang,
                    }),
                });
            }
        } else if (
            event.data.type === "recurring" &&
            event.data.startDate &&
            event.data.weekday !== undefined
        ) {
            const series = {
                startDate: event.data.startDate,
                weekday: event.data.weekday,
                endDate: event.data.endDate,
                skipDates: event.data.skipDates,
            };
            for (const curDateIso of weeklyDates(
                series,
                isoOf(monthStart),
                isoOf(monthEnd),
            )) {
                const [y, m, d] = curDateIso.split("-").map(Number);
                occurrences.push({
                    id: `${eventId}-${curDateIso}`,
                    date: new Date(y, m - 1, d),
                    dateIso: curDateIso,
                    startTime: event.data.startTime,
                    endTime: event.data.endTime,
                    timezone: event.data.timezone,
                    isRecurring: true,
                    until: event.data.endDate,
                    exdates: event.data.skipDates,
                    title: event.data.title,
                    description: event.data.description,
                    kind: event.data.kind,
                    tag: event.data.tag,
                    discordEvent: event.data.discordEvent,
                });
            }
        }
    }

    // Por día y, el mismo día, por hora.
    occurrences.sort((a, b) =>
        `${a.dateIso}T${a.startTime ?? "00:00"}` <
        `${b.dateIso}T${b.startTime ?? "00:00"}`
            ? -1
            : 1,
    );

    return {
        key: `${monthStart.getFullYear()}-${String(monthStart.getMonth() + 1).padStart(2, "0")}`,
        labelEn: capitalize(
            monthStart.toLocaleDateString("en-US", {
                month: "long",
                year: "numeric",
            }),
        ),
        labelEs: capitalize(
            monthStart.toLocaleDateString("es-PE", {
                month: "long",
                year: "numeric",
            }),
        ),
        occurrences,
    };
});

const today = new Date();
today.setHours(0, 0, 0, 0);
const upcomingEvents = months
    .flatMap((month) => month.occurrences)
    .filter((occurrence) => occurrence.date >= today)
    .slice(0, SEO_EVENTS_LIMIT);
---

<Layout
    title="Calendario de eventos y sesiones | Chamba Lab"
    description="Sesiones en vivo, simulacros técnicos y espacios de coworking de la comunidad. Horarios y enlaces a Google Calendar e iCal."
    breadcrumbs={[
        { name: "Inicio", path: "/" },
        { name: "Eventos", path: "/events/" },
    ]}
    jsonLd={upcomingEvents.map((o) =>
        eventJsonLd(siteOrigin, {
            name: o.title.es ?? o.title.en,
            description: o.description.es ?? o.description.en,
            date: o.dateIso,
            startTime: o.startTime,
            endTime: o.endTime,
            timezone: o.timezone,
        }),
    )}
>
    <main class="events-page">
        <section class="events-hero" aria-labelledby="events-heading">
            <div class="events-invitation">
                <h1
                    id="events-heading"
                    data-i18n-es="Nos vemos en&#10;Chamba."
                    data-i18n-en="See you at&#10;Chamba."
                >
                    Nos vemos en
                    <br />
                    Chamba.
                </h1>
                <p
                    class="events-subtitle"
                    data-i18n-es="Un encuentro puede cambiar tu semana."
                    data-i18n-en="One gathering can change your week."
                >
                    Un encuentro puede cambiar tu semana.
                </p>
                <p
                    class="events-intro"
                    data-i18n-es="Sesiones para compartir, avanzar en lo tuyo y conocer a quienes están construyendo su camino en tecnología."
                    data-i18n-en="Sessions to share, make progress on your projects and meet others building their path in tech."
                >
                    Sesiones para compartir, avanzar en lo tuyo y conocer a
                    quienes están construyendo su camino en tecnología.
                </p>
                <a class="events-explore" href="#agenda">
                    <span
                        data-i18n-es="Explorar la agenda"
                        data-i18n-en="Explore the agenda"
                    >
                        Explorar la agenda
                    </span>{" "}
                    <span aria-hidden="true">↓</span>
                </a>
            </div>
            <!-- Los carteles van clavados en el tablón de la cafetería, donde
                 Rakim toma un café mirándolos. La escena se ancla a los
                 carteles: el corcho queda detrás de ellos a cualquier ancho. -->
            <div class="events-board">
                <SeasonalImage
                    variants={{
                        default: corkboard,
                        christmas: corkboardChristmas,
                    }}
                    widths={[800, 1100, 1438, 1672]}
                    sizes="(min-width: 768px) 1438px, 806px"
                    class="events-board__scene"
                    loading="eager"
                    fetchpriority="high"
                />
                <EventPosters />
            </div>
        </section>
        <aside class="events-note">
            <strong data-i18n-es="EN DISCORD" data-i18n-en="ON DISCORD">
                EN DISCORD
            </strong>
            <span
                data-i18n-es="Encuentros, café y proyectos que avanzan en compañía."
                data-i18n-en="Gatherings, coffee and projects moving forward together."
            >
                Encuentros, café y proyectos que avanzan en compañía.
            </span>
            <small
                data-i18n-es="Fechas confirmadas en #eventos de Discord."
                data-i18n-en="Dates confirmed in Discord’s #eventos channel."
            >
                Fechas confirmadas en #eventos de Discord.
            </small>
        </aside>
        <section id="agenda" aria-labelledby="agenda-heading">
            <div class="events-agenda-header">
                <div>
                    <h2
                        id="agenda-heading"
                        data-i18n-es="Hazle espacio en tu semana."
                        data-i18n-en="Make room in your week."
                    >
                        Hazle espacio en tu semana.
                    </h2>
                    <p
                        data-i18n-es="Todos los horarios en UTC−5. Nos encontramos en Discord."
                        data-i18n-en="All times in UTC−5. Meet us on Discord."
                    >
                        Todos los horarios en UTC−5. Nos encontramos en Discord.
                    </p>
                </div>
                <nav
                    class="events-month-nav"
                    aria-label="Mes de la agenda"
                    data-i18n-aria-label-es="Mes de la agenda"
                    data-i18n-aria-label-en="Agenda month"
                >
                    <button
                        id="month-prev"
                        type="button"
                        aria-label="Mes anterior"
                        data-i18n-aria-label-es="Mes anterior"
                        data-i18n-aria-label-en="Previous month"
                    >
                        <ChevronIcon direction="left" />
                    </button>
                    <span
                        id="month-label"
                        aria-live="polite"
                        aria-atomic="true"
                    >
                        <span>{months[initialIndex].labelEs}</span>
                    </span>
                    <button
                        id="month-next"
                        type="button"
                        aria-label="Mes siguiente"
                        data-i18n-aria-label-es="Mes siguiente"
                        data-i18n-aria-label-en="Next month"
                    >
                        <ChevronIcon direction="right" />
                    </button>
                </nav>
            </div>
            <!-- Months Sections -->
            <div class="mb-14" data-initial-index={initialIndex}>
                {months.map((month, i) => (
                    <ol
                        data-month-index={i}
                        data-month-key={month.key}
                        data-month-label-en={month.labelEn}
                        data-month-label-es={month.labelEs}
                        hidden={i !== initialIndex}
                        class="events-list"
                    >
                        {month.occurrences.length === 0 && (
                            <li
                                class="card-glass rounded-2xl p-12 text-center text-slate-400 border border-white/10"
                                data-i18n="noEvents"
                            >
                                No hay eventos programados este mes.
                            </li>
                        )}
                        {month.occurrences.map((occurrence) => (
                            <EventItem
                                id={occurrence.id}
                                day={occurrence.date.getDate()}
                                monthShortEn={occurrence.date
                                    .toLocaleDateString("en-US", {
                                        month: "short",
                                    })
                                    .toUpperCase()}
                                monthShortEs={occurrence.date
                                    .toLocaleDateString("es-PE", {
                                        month: "short",
                                    })
                                    .toUpperCase()}
                                titleEs={
                                    occurrence.title.es ?? occurrence.title.en
                                }
                                titleEn={occurrence.title.en}
                                descriptionEn={occurrence.description.en}
                                descriptionEs={occurrence.description.es}
                                dateIso={occurrence.dateIso}
                                startTime={occurrence.startTime}
                                endTime={occurrence.endTime}
                                timezone={occurrence.timezone}
                                isRecurring={occurrence.isRecurring}
                                until={occurrence.until}
                                exdates={occurrence.exdates}
                                kind={occurrence.kind}
                                tag={occurrence.tag}
                                discordEvent={occurrence.discordEvent}
                                postUrl={occurrence.postUrl}
                                postTitle={occurrence.postTitle}
                                postLang={occurrence.postLang}
                            />
                        ))}
                    </ol>
                ))}
            </div>

            <aside class="events-propose">
                <!-- El jefe barista asoma sobre el botón, como los dueños en Recursos -->
                <Image
                    src={barista}
                    alt=""
                    aria-hidden="true"
                    height={138}
                    densities={[1, 2]}
                    class="events-propose-bust"
                />
                <div>
                    <h2
                        data-i18n-es="¿Qué te gustaría compartir?"
                        data-i18n-en="What would you like to share?"
                    >
                        ¿Qué te gustaría compartir?
                    </h2>
                    <p
                        data-i18n-es="Propón un taller o una sesión en el canal #eventos de Discord."
                        data-i18n-en="Suggest a workshop or session in Discord’s #eventos channel."
                    >
                        Propón un taller o una sesión en el canal #eventos de
                        Discord.
                    </p>
                    <p class="events-propose-alt">
                        <span
                            data-i18n-es="¿Prefieres dejarlo por escrito?"
                            data-i18n-en="Prefer to write it down?"
                        >
                            ¿Prefieres dejarlo por escrito?
                        </span>{" "}
                        <a
                            href={EVENT_PROPOSAL_URL}
                            target="_blank"
                            rel="noopener noreferrer"
                            data-i18n-es="Abre un issue en GitHub."
                            data-i18n-en="Open an issue on GitHub."
                        >
                            Abre un issue en GitHub.
                        </a>
                    </p>
                </div>
                <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer">
                    <span
                        data-i18n-es="Proponer en Discord"
                        data-i18n-en="Suggest on Discord"
                    >
                        Proponer en Discord
                    </span>{" "}
                    ↗
                </a>
            </aside>
        </section>
    </main>

    <script>
        import { limaNowStamp } from "../lib/events";

        const sections = Array.from(
            document.querySelectorAll<HTMLElement>("[data-month-index]"),
        );
        const prevBtn =
            document.querySelector<HTMLButtonElement>("#month-prev");
        const nextBtn =
            document.querySelector<HTMLButtonElement>("#month-next");
        const label = document.querySelector<HTMLElement>("#month-label");

        const container = sections[0]?.parentElement;
        const serverIndex = Number(container?.dataset.initialIndex ?? 0);
        const now = new Date();
        const todayKey = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;
        // El build es estático: el mes actual real se resuelve en el cliente.
        const todayIndex = sections.findIndex(
            (section) => section.dataset.monthKey === todayKey,
        );
        let currentIndex = todayIndex >= 0 ? todayIndex : serverIndex;

        // Eventos pasados: sin acciones de calendario y con la fecha en gris.
        // Un evento pasa al terminar (su hora de fin en Lima, o el fin del día
        // si no tiene), no al cambiar de día. La fila no se atenúa, para que
        // la entrada del blog de un evento pasado se lea con claridad.
        const nowStamp = limaNowStamp();
        document
            .querySelectorAll<HTMLElement>("[data-ends-at]")
            .forEach((item) => {
                const endsAt = item.dataset.endsAt;
                if (endsAt && endsAt <= nowStamp) {
                    item.dataset.past = "";
                }
            });
        let currentLang: "es" | "en" = "es";

        function render() {
            sections.forEach((section, i) => {
                section.hidden = i !== currentIndex;
            });
            const active = sections[currentIndex];
            if (active && label) {
                const en = active.dataset.monthLabelEn;
                const es = active.dataset.monthLabelEs;
                const text = currentLang === "es" ? (es ?? en) : en;
                const span = label.querySelector("span");
                if (span && text) span.textContent = text;
            }
            if (prevBtn) prevBtn.disabled = currentIndex === 0;
            if (nextBtn)
                nextBtn.disabled = currentIndex === sections.length - 1;
        }

        document.addEventListener("chamba-lab:lang", (event) => {
            currentLang = (event as CustomEvent<{ lang: "es" | "en" }>).detail
                .lang;
            render();
        });

        prevBtn?.addEventListener("click", () => {
            if (currentIndex > 0) {
                currentIndex -= 1;
                render();
            }
        });

        nextBtn?.addEventListener("click", () => {
            if (currentIndex < sections.length - 1) {
                currentIndex += 1;
                render();
            }
        });

        render();
    </script>
</Layout>

<style>
    .events-page {
        width: 100%;
        max-width: 1440px;
        margin: auto;
        padding: 82px 80px 72px;
        /* La escena del tablón sale por la derecha. */
        overflow-x: clip;
    }
    .events-invitation {
        position: relative;
        z-index: 1;
    }
    .events-board {
        position: relative;
    }
    /* En Figma a 1440: escena de 1438 × 809 en x 60, y 85; carteles en
       x 750, y 163, 610 × 495. Las medidas van en % de los carteles. */
    .events-board :global(.events-board__scene) {
        position: absolute;
        left: -113.11%;
        top: -15.76%;
        width: 235.74%;
        height: 163.43%;
        pointer-events: none;
        /* Velos de Figma como máscara: la zona del titular a la izquierda,
           bajo la cabecera arriba y el fundido inferior. */
        --board-fade-x: linear-gradient(
            to right,
            rgb(0 0 0 / 0.07) 0%,
            rgb(0 0 0 / 0.1) 2.16%,
            rgb(0 0 0 / 0.32) 16.97%,
            rgb(0 0 0 / 0.78) 33.87%,
            #000 48.68%,
            #000 92%,
            transparent 100%
        );
        --board-fade-y: linear-gradient(
            to bottom,
            transparent 5.69%,
            #000 11.12%,
            #000 75.28%,
            transparent 100%
        );
        -webkit-mask-image: var(--board-fade-x), var(--board-fade-y);
        -webkit-mask-composite: source-in;
        mask-image: var(--board-fade-x), var(--board-fade-y);
        mask-composite: intersect;
    }
    .events-board :global(.events-board__scene img) {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .events-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 60px;
        align-items: center;
    }
    .events-invitation {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 24px;
    }
    .events-invitation h1 {
        font-family: var(--font-display);
        font-size: clamp(48px, 5.6vw, 80px);
        font-weight: 800;
        line-height: 1.16;
        letter-spacing: -0.04em;
        color: var(--color-content-inverse);
        white-space: pre-line;
    }
    .events-subtitle {
        font-size: 22px;
        font-weight: 600;
        color: var(--color-brand-cream);
    }
    .events-intro {
        font-size: 17px;
        line-height: 1.55;
        color: var(--color-muted);
        /* No pisa a Rakim, sentado detrás. */
        max-width: 410px;
    }
    .events-explore {
        display: inline-flex;
        gap: 12px;
        padding: 16px;
        border-radius: 10px;
        background: var(--color-brand-yellow);
        color: var(--color-on-accent);
        font-size: 14px;
        font-weight: 600;
    }
    .events-explore:hover {
        background: var(--color-brand-yellow-hover);
    }
    .events-note {
        display: flex;
        gap: 32px;
        align-items: center;
        position: relative;
        /* Baja hasta el final de la escena del tablón. */
        margin: 209px 0 100px;
        padding: 18px;
        border-radius: 12px;
        background: var(--color-surface);
        font-size: 14px;
    }
    .events-note strong {
        font-size: 11px;
        color: var(--color-brand-yellow);
        min-width: 120px;
    }
    .events-note small {
        margin-left: auto;
        color: var(--color-muted);
        font-size: 12px;
    }
    .events-agenda-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 32px;
        margin-bottom: 32px;
    }
    .events-agenda-header h2 {
        font: 800 34px/1.16 var(--font-display);
        color: var(--color-content-inverse);
        letter-spacing: -0.03em;
    }
    .events-agenda-header p {
        margin-top: 8px;
        font-size: 14px;
        color: var(--color-muted);
    }
    .events-month-nav {
        display: flex;
        align-items: center;
        gap: 18px;
        min-width: 390px;
    }
    .events-month-nav button {
        display: grid;
        place-items: center;
        width: 44px;
        height: 54px;
        border: 1px solid var(--color-surface-border-subtle);
        background: var(--color-surface-subtle);
        border-radius: 10px;
        cursor: pointer;
    }
    .events-month-nav button:hover {
        border-color: var(--color-brand-yellow);
    }
    .events-month-nav button:disabled {
        opacity: 0.25;
        cursor: default;
    }
    .events-month-nav > span {
        flex: 1;
        font: 800 23px/1.2 var(--font-display);
        color: var(--color-brand-cream);
    }
    .events-list {
        border-top: 1px solid var(--color-surface-border-subtle);
    }
    #agenda {
        scroll-margin-top: 110px;
    }
    .events-propose {
        position: relative;
        margin-top: 48px;
        display: flex;
        justify-content: space-between;
        gap: 32px;
        align-items: center;
        background: var(--color-brand-cream);
        color: var(--color-on-accent);
        padding: 36px;
        border-radius: 24px;
    }
    /* En Figma: 138 px de alto, 65 px por encima del borde y centrado sobre
       el botón (36 px de padding + medio botón, ~89 px). */
    .events-propose-bust {
        position: absolute;
        top: -72px;
        right: 125px;
        width: auto;
        height: 138px;
