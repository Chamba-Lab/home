---
import Layout from "../layouts/Layout.astro";
import EventItem from "../components/EventItem.astro";
import ChevronIcon from "../components/icons/ChevronIcon.astro";
import EventPosters from "../components/EventPosters.astro";
import { DISCORD_URL, SITE_URL } from "../lib/constants";
import { eventJsonLd } from "../lib/seo";
import { getCollection } from "astro:content";

const MONTHS_AHEAD = 12;
// Eventos próximos que se publican como datos estructurados.
const SEO_EVENTS_LIMIT = 10;
const siteOrigin = Astro.site?.origin ?? SITE_URL;

const events = await getCollection("events");

function startOfMonth(d: Date) {
    return new Date(d.getFullYear(), d.getMonth(), 1);
}
function addMonths(d: Date, n: number) {
    return new Date(d.getFullYear(), d.getMonth() + n, 1);
}
function endOfMonth(d: Date) {
    return new Date(d.getFullYear(), d.getMonth() + 1, 0);
}
function capitalize(s: string) {
    return s.charAt(0).toUpperCase() + s.slice(1);
}

type I18nText = { en: string; es?: string };

interface Occurrence {
    id: string;
    date: Date;
    dateIso: string;
    startTime?: string;
    endTime?: string;
    timezone?: string;
    isRecurring?: boolean;
    title: I18nText;
    description: I18nText;
    recurrenceLabel?: I18nText;
    kind?: "activity";
    tag?: I18nText;
}

const currentMonth = startOfMonth(new Date());

function monthsBetween(from: Date, to: Date) {
    return (
        (to.getFullYear() - from.getFullYear()) * 12 +
        (to.getMonth() - from.getMonth())
    );
}

// El calendario arranca en el mes del primer evento registrado (aunque ya
// haya pasado) para que el historial siga siendo navegable.
const earliestMonth = events.reduce((earliest, event) => {
    const iso =
        event.data.type === "fixed" ? event.data.date : event.data.startDate;
    if (!iso) return earliest;
    const [y, m] = iso.split("-").map(Number);
    const month = new Date(y, m - 1, 1);
    return month < earliest ? month : earliest;
}, currentMonth);

const firstMonth = earliestMonth;
const initialIndex = monthsBetween(firstMonth, currentMonth);
const totalMonths = initialIndex + MONTHS_AHEAD;

const months = Array.from({ length: totalMonths }, (_, i) => {
    const monthStart = addMonths(firstMonth, i);
    const monthEnd = endOfMonth(monthStart);
    const occurrences: Occurrence[] = [];

    for (const event of events) {
        const eventId = event.id;
        if (event.data.type === "fixed" && event.data.date) {
            const [y, m, d] = event.data.date.split("-").map(Number);
            const date = new Date(y, m - 1, d);
            if (date >= monthStart && date <= monthEnd) {
                occurrences.push({
                    id: eventId,
                    date,
                    dateIso: event.data.date,
                    startTime: event.data.startTime,
                    endTime: event.data.endTime,
                    timezone: event.data.timezone,
                    isRecurring: false,
                    title: event.data.title,
                    description: event.data.description,
                    kind: event.data.kind,
                    tag: event.data.tag,
                });
            }
        } else if (
            event.data.type === "recurring" &&
            event.data.startDate &&
            event.data.weekday !== undefined
        ) {
            const [sy, sm, sd] = event.data.startDate.split("-").map(Number);
            const start = new Date(sy, sm - 1, sd);
            const rangeStart = start > monthStart ? start : monthStart;
            const cursor = new Date(rangeStart);
            cursor.setDate(
                cursor.getDate() +
                    ((event.data.weekday - cursor.getDay() + 7) % 7),
            );
            while (cursor <= monthEnd) {
                const curDateIso = `${cursor.getFullYear()}-${String(cursor.getMonth() + 1).padStart(2, "0")}-${String(cursor.getDate()).padStart(2, "0")}`;
                occurrences.push({
                    id: `${eventId}-${curDateIso}`,
                    date: new Date(cursor),
                    dateIso: curDateIso,
                    startTime: event.data.startTime,
                    endTime: event.data.endTime,
                    timezone: event.data.timezone,
                    isRecurring: true,
                    title: event.data.title,
                    description: event.data.description,
                    recurrenceLabel: event.data.recurrenceLabel,
                });
                cursor.setDate(cursor.getDate() + 7);
            }
        }
    }

    occurrences.sort((a, b) => a.date.getTime() - b.date.getTime());

    return {
        key: `${monthStart.getFullYear()}-${String(monthStart.getMonth() + 1).padStart(2, "0")}`,
        labelEn: capitalize(
            monthStart.toLocaleDateString("en-US", {
                month: "long",
                year: "numeric",
            }),
        ),
        labelEs: capitalize(
            monthStart.toLocaleDateString("es-PE", {
                month: "long",
                year: "numeric",
            }),
        ),
        occurrences,
    };
});

const today = new Date();
today.setHours(0, 0, 0, 0);
const upcomingEvents = months
    .flatMap((month) => month.occurrences)
    .filter((occurrence) => occurrence.date >= today)
    .slice(0, SEO_EVENTS_LIMIT);
---

<Layout
    title="Calendario de eventos y sesiones | Chamba Lab"
    description="Sesiones en vivo, simulacros técnicos y espacios de coworking de la comunidad. Horarios y enlaces a Google Calendar e iCal."
    breadcrumbs={[
        { name: "Inicio", path: "/" },
        { name: "Eventos", path: "/events/" },
    ]}
    jsonLd={upcomingEvents.map((o) =>
        eventJsonLd(siteOrigin, {
            name: o.title.es ?? o.title.en,
            description: o.description.es ?? o.description.en,
            date: o.dateIso,
            startTime: o.startTime,
            endTime: o.endTime,
            timezone: o.timezone,
        }),
    )}
>
    <main class="events-page">
        <section class="events-hero" aria-labelledby="events-heading">
            <div class="events-invitation">
                <h1
                    id="events-heading"
                    data-i18n-es="Nos vemos&#10;en Chamba."
                    data-i18n-en="See you&#10;at Chamba."
                >
                    Nos vemos
                    <br />
                    en Chamba.
                </h1>
                <p
                    class="events-subtitle"
                    data-i18n-es="Un encuentro puede cambiar tu semana."
                    data-i18n-en="One gathering can change your week."
                >
                    Un encuentro puede cambiar tu semana.
                </p>
                <p
                    class="events-intro"
                    data-i18n-es="Sesiones para compartir, avanzar en lo tuyo y conocer a quienes están construyendo su camino en tecnología."
                    data-i18n-en="Sessions to share, make progress on your projects and meet others building their path in tech."
                >
                    Sesiones para compartir, avanzar en lo tuyo y conocer a
                    quienes están construyendo su camino en tecnología.
                </p>
                <a class="events-explore" href="#agenda">
                    <span
                        data-i18n-es="Explorar la agenda"
                        data-i18n-en="Explore the agenda"
                    >
                        Explorar la agenda
                    </span>{" "}
                    <span aria-hidden="true">↓</span>
                </a>
            </div>
            <EventPosters />
        </section>
        <aside class="events-note">
            <strong data-i18n-es="EN DISCORD" data-i18n-en="ON DISCORD">
                EN DISCORD
            </strong>
            <span
                data-i18n-es="Encuentros, café y proyectos que avanzan en compañía."
                data-i18n-en="Gatherings, coffee and projects moving forward together."
            >
                Encuentros, café y proyectos que avanzan en compañía.
            </span>
            <small
                data-i18n-es="Fechas confirmadas en #eventos de Discord."
                data-i18n-en="Dates confirmed in Discord’s #eventos channel."
            >
                Fechas confirmadas en #eventos de Discord.
            </small>
        </aside>
        <section id="agenda" aria-labelledby="agenda-heading">
            <div class="events-agenda-header">
                <div>
                    <h2
                        id="agenda-heading"
                        data-i18n-es="Hazle espacio en tu semana."
                        data-i18n-en="Make room in your week."
                    >
                        Hazle espacio en tu semana.
                    </h2>
                    <p
                        data-i18n-es="Todos los horarios en UTC−5. Nos encontramos en Discord."
                        data-i18n-en="All times in UTC−5. Meet us on Discord."
                    >
                        Todos los horarios en UTC−5. Nos encontramos en Discord.
                    </p>
                </div>
                <nav
                    class="events-month-nav"
                    aria-label="Mes de la agenda"
                    data-i18n-aria-label-es="Mes de la agenda"
                    data-i18n-aria-label-en="Agenda month"
                >
                    <button
                        id="month-prev"
                        type="button"
                        aria-label="Mes anterior"
                        data-i18n-aria-label-es="Mes anterior"
                        data-i18n-aria-label-en="Previous month"
                    >
                        <ChevronIcon direction="left" />
                    </button>
                    <span
                        id="month-label"
                        aria-live="polite"
                        aria-atomic="true"
                    >
                        <span>{months[initialIndex].labelEs}</span>
                    </span>
                    <button
                        id="month-next"
                        type="button"
                        aria-label="Mes siguiente"
                        data-i18n-aria-label-es="Mes siguiente"
                        data-i18n-aria-label-en="Next month"
                    >
                        <ChevronIcon direction="right" />
                    </button>
                </nav>
            </div>
            <!-- Months Sections -->
            <div class="mb-14" data-initial-index={initialIndex}>
                {months.map((month, i) => (
                    <ol
                        data-month-index={i}
                        data-month-key={month.key}
                        data-month-label-en={month.labelEn}
                        data-month-label-es={month.labelEs}
                        hidden={i !== initialIndex}
                        class="events-list"
                    >
                        {month.occurrences.length === 0 && (
                            <li
                                class="card-glass rounded-2xl p-12 text-center text-slate-400 border border-white/10"
                                data-i18n="noEvents"
                            >
                                No hay eventos programados este mes.
                            </li>
                        )}
                        {month.occurrences.map((occurrence) => (
                            <EventItem
                                id={occurrence.id}
                                day={occurrence.date.getDate()}
                                monthShortEn={occurrence.date
                                    .toLocaleDateString("en-US", {
                                        month: "short",
                                    })
                                    .toUpperCase()}
                                monthShortEs={occurrence.date
                                    .toLocaleDateString("es-PE", {
                                        month: "short",
                                    })
                                    .toUpperCase()}
                                titleEs={
                                    occurrence.title.es ?? occurrence.title.en
                                }
                                titleEn={occurrence.title.en}
                                descriptionEn={occurrence.description.en}
                                descriptionEs={occurrence.description.es}
                                recurrenceLabelEn={
                                    occurrence.recurrenceLabel?.en
                                }
                                recurrenceLabelEs={
                                    occurrence.recurrenceLabel?.es
                                }
                                dateIso={occurrence.dateIso}
                                startTime={occurrence.startTime}
                                endTime={occurrence.endTime}
                                timezone={occurrence.timezone}
                                isRecurring={occurrence.isRecurring}
                                kind={occurrence.kind}
                                tagEn={occurrence.tag?.en}
                                tagEs={occurrence.tag?.es}
                            />
                        ))}
                    </ol>
                ))}
            </div>

            <aside class="events-propose">
                <div>
                    <h2
                        data-i18n-es="¿Qué te gustaría compartir?"
                        data-i18n-en="What would you like to share?"
                    >
                        ¿Qué te gustaría compartir?
                    </h2>
                    <p
                        data-i18n-es="Propón un taller o una sesión en el canal #eventos de Discord."
                        data-i18n-en="Suggest a workshop or session in Discord’s #eventos channel."
                    >
                        Propón un taller o una sesión en el canal #eventos de
                        Discord.
                    </p>
                </div>
                <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer">
                    <span
                        data-i18n-es="Proponer en Discord"
                        data-i18n-en="Suggest on Discord"
                    >
                        Proponer en Discord
                    </span>{" "}
                    ↗
                </a>
            </aside>
        </section>
    </main>

    <script>
        const sections = Array.from(
            document.querySelectorAll<HTMLElement>("[data-month-index]"),
        );
        const prevBtn =
            document.querySelector<HTMLButtonElement>("#month-prev");
        const nextBtn =
            document.querySelector<HTMLButtonElement>("#month-next");
        const label = document.querySelector<HTMLElement>("#month-label");

        const container = sections[0]?.parentElement;
        const serverIndex = Number(container?.dataset.initialIndex ?? 0);
        const now = new Date();
        const todayKey = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;
        const todayIso = `${todayKey}-${String(now.getDate()).padStart(2, "0")}`;
        // El build es estático: el mes actual real se resuelve en el cliente.
        const todayIndex = sections.findIndex(
            (section) => section.dataset.monthKey === todayKey,
        );
        let currentIndex = todayIndex >= 0 ? todayIndex : serverIndex;

        // Eventos pasados atenuados y sin acciones de calendario (el navegador
        // conoce la fecha de hoy).
        document
            .querySelectorAll<HTMLElement>("[data-date-iso]")
            .forEach((item) => {
                const iso = item.dataset.dateIso;
                if (iso && iso < todayIso) {
                    item.classList.add("opacity-60", "is-past");
                }
            });
        let currentLang: "es" | "en" = "es";

        function render() {
            sections.forEach((section, i) => {
                section.hidden = i !== currentIndex;
            });
            const active = sections[currentIndex];
            if (active && label) {
                const en = active.dataset.monthLabelEn;
                const es = active.dataset.monthLabelEs;
                const text = currentLang === "es" ? (es ?? en) : en;
                const span = label.querySelector("span");
                if (span && text) span.textContent = text;
            }
            if (prevBtn) prevBtn.disabled = currentIndex === 0;
            if (nextBtn)
                nextBtn.disabled = currentIndex === sections.length - 1;
        }

        document.addEventListener("chamba-lab:lang", (event) => {
            currentLang = (event as CustomEvent<{ lang: "es" | "en" }>).detail
                .lang;
            render();
        });

        prevBtn?.addEventListener("click", () => {
            if (currentIndex > 0) {
                currentIndex -= 1;
                render();
            }
        });

        nextBtn?.addEventListener("click", () => {
            if (currentIndex < sections.length - 1) {
                currentIndex += 1;
                render();
            }
        });

        render();
    </script>
</Layout>

<style>
    .events-page {
        width: 100%;
        max-width: 1440px;
        margin: auto;
        padding: 82px 80px 72px;
    }
    .events-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 60px;
        align-items: center;
    }
    .events-invitation {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 24px;
    }
    .events-invitation h1 {
        font-family: var(--font-display);
        font-size: clamp(48px, 5.6vw, 80px);
        font-weight: 800;
        line-height: 1.16;
        letter-spacing: -0.04em;
        color: var(--color-content-inverse);
        white-space: pre-line;
    }
    .events-subtitle {
        font-size: 22px;
        font-weight: 600;
        color: var(--color-brand-cream);
    }
    .events-intro {
        font-size: 17px;
        line-height: 1.55;
        color: var(--color-muted);
        max-width: 530px;
    }
    .events-explore {
        display: inline-flex;
        gap: 12px;
        padding: 16px;
        border-radius: 10px;
        background: var(--color-brand-yellow);
        color: var(--color-on-accent);
        font-size: 14px;
        font-weight: 600;
    }
    .events-explore:hover {
        background: var(--color-brand-yellow-hover);
    }
    .events-note {
        display: flex;
        gap: 32px;
        align-items: center;
        margin: 54px 0 100px;
        padding: 18px;
        border-radius: 12px;
        background: var(--color-surface);
        font-size: 14px;
    }
    .events-note strong {
        font-size: 11px;
        color: var(--color-brand-yellow);
        min-width: 120px;
    }
    .events-note small {
        margin-left: auto;
        color: var(--color-muted);
        font-size: 12px;
    }
    .events-agenda-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 32px;
        margin-bottom: 32px;
    }
    .events-agenda-header h2 {
        font: 800 34px/1.16 var(--font-display);
        color: var(--color-content-inverse);
        letter-spacing: -0.03em;
    }
    .events-agenda-header p {
        margin-top: 8px;
        font-size: 14px;
        color: var(--color-muted);
    }
    .events-month-nav {
        display: flex;
        align-items: center;
        gap: 18px;
        min-width: 390px;
    }
    .events-month-nav button {
        display: grid;
        place-items: center;
        width: 44px;
        height: 54px;
        border: 1px solid var(--color-surface-border-subtle);
        background: var(--color-surface-subtle);
        border-radius: 10px;
        cursor: pointer;
    }
    .events-month-nav button:hover {
        border-color: var(--color-brand-yellow);
    }
    .events-month-nav button:disabled {
        opacity: 0.25;
        cursor: default;
    }
    .events-month-nav > span {
        flex: 1;
        font: 800 23px/1.2 var(--font-display);
        color: var(--color-brand-cream);
    }
    .events-list {
        border-top: 1px solid var(--color-surface-border-subtle);
    }
    #agenda {
        scroll-margin-top: 110px;
    }
    .events-propose {
        display: flex;
        justify-content: space-between;
        gap: 32px;
        align-items: center;
        background: var(--color-brand-cream);
        color: var(--color-on-accent);
        padding: 36px;
        border-radius: 24px;
    }
    .events-propose h2 {
        font: 800 32px/1.16 var(--font-display);
        margin: 10px 0;
    }
    .events-propose p {
        font-size: 15px;
        line-height: 1.55;
    }
    .events-propose a {
        flex-shrink: 0;
        background: var(--color-on-accent);
        color: var(--color-brand-cream);
        padding: 16px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
    }
    .events-page a:focus-visible,
    .events-page button:focus-visible {
        outline: 2px solid var(--color-brand-yellow);
        outline-offset: 5px;
    }
    @media (max-width: 1100px) {
        .events-page {
            padding: 64px 32px;
        }
        .events-hero {
            gap: 20px;
        }
        .events-month-nav {
            min-width: 310px;
        }
        .events-agenda-header h2 {
            font-size: 30px;
        }
        .events-note {
            gap: 20px;
        }
        .events-note strong {
            min-width: auto;
        }
    }
    @media (max-width: 767px) {
        .events-page {
            padding: 44px 24px 40px;
        }
        .events-hero {
            grid-template-columns: 1fr;
            gap: 24px;
        }
        .events-invitation h1 {
            font-size: 48px;
        }
        .events-subtitle {
            font-size: 20px;
        }
        .events-intro {
            font-size: 15px;
        }
        .events-note {
            margin: 24px 0 64px;
            padding: 0;
            background: none;
        }
        .events-note strong,
        .events-note > span {
            display: none;
        }
        .events-note small {
            margin: 0;
            font-size: 12px;
        }
        .events-agenda-header {
            display: block;
            margin-bottom: 28px;
        }
        .events-agenda-header h2 {
            font-size: 30px;
            max-width: 290px;
        }
        .events-month-nav {
            margin-top: 28px;
            min-width: 0;
            gap: 12px;
        }
        .events-month-nav > span {
            font-size: 20px;
        }
        .events-propose {
            display: block;
            padding: 24px;
        }
        .events-propose h2 {
            font-size: 26px;
        }
        .events-propose p {
            font-size: 14px;
        }
        .events-propose a {
            display: inline-flex;
            gap: 12px;
            margin-top: 20px;
        }
    }
</style>
