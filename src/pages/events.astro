---
import Layout from "../layouts/Layout.astro";
import EventItem from "../components/EventItem.astro";
import ChevronIcon from "../components/icons/ChevronIcon.astro";
import DiscordIcon from "../components/icons/DiscordIcon.astro";
import { DISCORD_URL } from "../lib/constants";
import { getCollection } from "astro:content";

const MONTHS_AHEAD = 12;

const events = await getCollection("events");

function startOfMonth(d: Date) {
    return new Date(d.getFullYear(), d.getMonth(), 1);
}
function addMonths(d: Date, n: number) {
    return new Date(d.getFullYear(), d.getMonth() + n, 1);
}
function endOfMonth(d: Date) {
    return new Date(d.getFullYear(), d.getMonth() + 1, 0);
}
function capitalize(s: string) {
    return s.charAt(0).toUpperCase() + s.slice(1);
}

type I18nText = { en: string; es?: string };

interface Occurrence {
    date: Date;
    title: I18nText;
    description: I18nText;
    recurrenceLabel?: I18nText;
}

const firstMonth = startOfMonth(new Date());

const months = Array.from({ length: MONTHS_AHEAD }, (_, i) => {
    const monthStart = addMonths(firstMonth, i);
    const monthEnd = endOfMonth(monthStart);
    const occurrences: Occurrence[] = [];

    for (const event of events) {
        if (event.data.type === "fixed" && event.data.date) {
            const date = new Date(`${event.data.date}T00:00:00`);
            if (date >= monthStart && date <= monthEnd) {
                occurrences.push({
                    date,
                    title: event.data.title,
                    description: event.data.description,
                });
            }
        } else if (
            event.data.type === "recurring" &&
            event.data.startDate &&
            event.data.weekday !== undefined
        ) {
            const start = new Date(`${event.data.startDate}T00:00:00`);
            const rangeStart = start > monthStart ? start : monthStart;
            const cursor = new Date(rangeStart);
            cursor.setDate(
                cursor.getDate() +
                    ((event.data.weekday - cursor.getDay() + 7) % 7),
            );
            while (cursor <= monthEnd) {
                occurrences.push({
                    date: new Date(cursor),
                    title: event.data.title,
                    description: event.data.description,
                    recurrenceLabel: event.data.recurrenceLabel,
                });
                cursor.setDate(cursor.getDate() + 7);
            }
        }
    }

    occurrences.sort((a, b) => a.date.getTime() - b.date.getTime());

    return {
        labelEn: capitalize(
            monthStart.toLocaleDateString("en-US", {
                month: "long",
                year: "numeric",
            }),
        ),
        labelEs: capitalize(
            monthStart.toLocaleDateString("es-PE", {
                month: "long",
                year: "numeric",
            }),
        ),
        occurrences,
    };
});
---

<Layout title="Chamba Lab | Calendario de Eventos y Sesiones">
    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
        <!-- Header -->
        <div class="max-w-3xl mb-12">
            <div
                class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full card-glass text-xs font-semibold text-slate-300 border border-white/10 mb-6"
            >
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"
                ></span>
                <span>Calendario Comunitario</span>
            </div>
            <h1
                class="font-display text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4"
                data-i18n="eventsTitle"
            >
                Próximos eventos
            </h1>
            <p
                class="text-lg text-slate-300 leading-relaxed"
                data-i18n="eventsIntro"
            >
                El lanzamiento y las sesiones recurrentes de la comunidad.
                Fechas exactas siempre confirmadas en el canal #eventos de
                Discord.
            </p>
        </div>

        <!-- Month Navigation Bar -->
        <div
            class="card-glass rounded-2xl p-4 flex items-center justify-between mb-8 border border-white/10 shadow-lg"
        >
            <button
                id="month-prev"
                type="button"
                aria-label="Mes anterior"
                class="w-10 h-10 flex items-center justify-center rounded-xl bg-slate-900/90 border border-white/10 text-slate-300 hover:text-white hover:border-brand-yellow/40 transition-all disabled:opacity-25 disabled:pointer-events-none"
            >
                <ChevronIcon direction="left" />
            </button>

            <span
                id="month-label"
                class="font-display text-base sm:text-lg font-bold uppercase tracking-wider text-white flex items-center gap-2"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5 text-brand-yellow"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                    ></path>
                </svg>
                <span>{months[0].labelEs}</span>
            </span>

            <button
                id="month-next"
                type="button"
                aria-label="Mes siguiente"
                class="w-10 h-10 flex items-center justify-center rounded-xl bg-slate-900/90 border border-white/10 text-slate-300 hover:text-white hover:border-brand-yellow/40 transition-all disabled:opacity-25 disabled:pointer-events-none"
            >
                <ChevronIcon direction="right" />
            </button>
        </div>

        <!-- Months Sections -->
        <div class="mb-14">
            {
                months.map((month, i) => (
                    <ol
                        data-month-index={i}
                        data-month-label-en={month.labelEn}
                        data-month-label-es={month.labelEs}
                        hidden={i !== 0}
                        class="space-y-4"
                    >
                        {month.occurrences.length === 0 && (
                            <li
                                class="card-glass rounded-2xl p-12 text-center text-slate-400 border border-white/10"
                                data-i18n="noEvents"
                            >
                                No hay eventos programados este mes.
                            </li>
                        )}
                        {month.occurrences.map((occurrence) => (
                            <EventItem
                                day={occurrence.date.getDate()}
                                monthShortEn={occurrence.date
                                    .toLocaleDateString("en-US", {
                                        month: "short",
                                    })
                                    .toUpperCase()}
                                monthShortEs={occurrence.date
                                    .toLocaleDateString("es-PE", {
                                        month: "short",
                                    })
                                    .toUpperCase()}
                                titleEs={
                                    occurrence.title.es ?? occurrence.title.en
                                }
                                titleEn={occurrence.title.en}
                                descriptionEn={occurrence.description.en}
                                descriptionEs={occurrence.description.es}
                                recurrenceLabelEn={
                                    occurrence.recurrenceLabel?.en
                                }
                                recurrenceLabelEs={
                                    occurrence.recurrenceLabel?.es
                                }
                            />
                        ))}
                    </ol>
                ))
            }
        </div>

        <!-- Bottom Community Discord Card -->
        <div
            class="card-glass rounded-2xl p-8 flex flex-col sm:flex-row items-center justify-between gap-6 border border-white/10 bg-gradient-to-br from-[#0B1120] via-slate-900/80 to-[#5865F2]/10"
        >
            <div class="space-y-1 text-center sm:text-left">
                <h3 class="font-display text-xl font-bold text-white">
                    ¿Quieres proponer un taller o sesión?
                </h3>
                <p class="text-sm text-slate-400">
                    Súmate a nuestro Discord y propón temas en el canal
                    #eventos.
                </p>
            </div>
            <a
                href={DISCORD_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-[#5865F2] hover:bg-[#4752c4] text-white px-6 py-3 rounded-xl text-sm font-bold transition-all shadow-lg shadow-[#5865F2]/25 hover:shadow-[#5865F2]/40 shrink-0"
            >
                <DiscordIcon class="w-4 h-4" />
                <span>Unirse al Discord</span>
            </a>
        </div>
    </main>

    <script>
        const sections = Array.from(
            document.querySelectorAll<HTMLElement>("[data-month-index]"),
        );
        const prevBtn =
            document.querySelector<HTMLButtonElement>("#month-prev");
        const nextBtn =
            document.querySelector<HTMLButtonElement>("#month-next");
        const label = document.querySelector<HTMLElement>("#month-label");

        let currentIndex = 0;
        let currentLang: "es" | "en" = "es";

        function render() {
            sections.forEach((section, i) => {
                section.hidden = i !== currentIndex;
            });
            const active = sections[currentIndex];
            if (active && label) {
                const en = active.dataset.monthLabelEn;
                const es = active.dataset.monthLabelEs;
                const text = currentLang === "es" ? (es ?? en) : en;
                const span = label.querySelector("span");
                if (span && text) span.textContent = text;
            }
            if (prevBtn) prevBtn.disabled = currentIndex === 0;
            if (nextBtn)
                nextBtn.disabled = currentIndex === sections.length - 1;
        }

        document.addEventListener("chamba-lab:lang", (event) => {
            currentLang = (event as CustomEvent<{ lang: "es" | "en" }>).detail
                .lang;
            render();
        });

        prevBtn?.addEventListener("click", () => {
            if (currentIndex > 0) {
                currentIndex -= 1;
                render();
            }
        });

        nextBtn?.addEventListener("click", () => {
            if (currentIndex < sections.length - 1) {
                currentIndex += 1;
                render();
            }
        });

        render();
    </script>
</Layout>
