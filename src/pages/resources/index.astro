---
import Layout from "../../layouts/Layout.astro";
import ResourceCard from "../../components/ResourceCard.astro";
import ResourceSection from "../../components/ResourceSection.astro";
import CategoryCard from "../../components/CategoryCard.astro";
import ResourceSearch from "../../components/ResourceSearch.astro";
import ResourceEmptyState from "../../components/ResourceEmptyState.astro";
import ResourceCriteriaNote from "../../components/ResourceCriteriaNote.astro";
import ResourceProposeCta from "../../components/ResourceProposeCta.astro";
import { getCollection } from "astro:content";
import {
    VIDEO_CAROUSEL_MIN,
    groupByCategory,
    groupByFormat,
} from "../../lib/resources";

const resources = (await getCollection("resources")).map((r) => r.data);
const groups = groupByCategory(resources);
// Resultados de búsqueda separados por formato, como en cada categoría, y en
// el orden de las categorías dentro de cada sección.
const sections = groupByFormat(groups.flatMap(({ items }) => items));
---

<Layout
    title="Biblioteca de recursos tech | Chamba Lab"
    description="Biblioteca curada de guías, plataformas de práctica y plantillas para tu CV, tu aprendizaje y tus entrevistas, recomendada por la comunidad tech."
    breadcrumbs={[
        { name: "Inicio", path: "/" },
        { name: "Recursos", path: "/resources/" },
    ]}
>
    <main class="w-full min-w-0 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
        <div class="max-w-3xl mb-12">
            <h1
                class="font-display text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4"
                data-i18n="resourcesTitle"
            >
                Recursos
            </h1>
            <p
                class="text-lg text-slate-300 leading-relaxed"
                data-i18n="resourcesIntro"
            >
                Una selección de guías, plataformas de práctica y plantillas que
                la comunidad recomienda.
            </p>
        </div>

        <div class="mb-12">
            <ResourceSearch
                placeholderEs="Buscar en todos los recursos..."
                placeholderEn="Search all resources..."
            />
        </div>

        <!-- Categorías: cada una lleva a su listado -->
        <div
            data-hide-when-searching
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
        >
            {groups.map(({ category, items }) => (
                <CategoryCard category={category} count={items.length} />
            ))}
        </div>

        <!-- Resultados de búsqueda: todos los recursos por formato, ocultos
             hasta buscar. El buscador oculta las secciones sin coincidencias. -->
        <div data-search-only hidden class="space-y-14">
            {sections.map((section) => (
                <ResourceSection
                    label={section.label}
                    count={section.items.length}
                    showHeading={sections.length > 1}
                    carousel={
                        section.format === "video" &&
                        section.items.length >= VIDEO_CAROUSEL_MIN
                    }
                >
                    {section.items.map((item) => (
                        <ResourceCard
                            title={item.title}
                            descriptionEn={item.description.en}
                            descriptionEs={item.description.es}
                            url={item.url}
                            category={item.category}
                            type={item.type}
                            avatar={item.avatar}
                            channel={item.channel}
                            access={item.access}
                            community={item.community}
                            recommended={item.recommended}
                            headingLevel={sections.length > 1 ? 3 : 2}
                        />
                    ))}
                </ResourceSection>
            ))}
        </div>

        <ResourceEmptyState />
        <ResourceProposeCta />
        <ResourceCriteriaNote />
    </main>
</Layout>
