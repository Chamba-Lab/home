---
import Layout from "../../layouts/Layout.astro";
import ResourceCard from "../../components/ResourceCard.astro";
import CategoryIcon from "../../components/CategoryIcon.astro";
import ResourceSearch from "../../components/ResourceSearch.astro";
import ResourceEmptyState from "../../components/ResourceEmptyState.astro";
import ResourceCriteriaNote from "../../components/ResourceCriteriaNote.astro";
import { getCollection } from "astro:content";
import {
    categoryPath,
    groupByCategory,
    resourceCountLabel,
} from "../../lib/resources";

const resources = (await getCollection("resources")).map((r) => r.data);
const groups = groupByCategory(resources);
---

<Layout
    title="Biblioteca de recursos tech | Chamba Lab"
    description="Biblioteca curada de guías, plataformas de práctica y plantillas para tu CV, tu aprendizaje y tus entrevistas, recomendada por la comunidad tech."
    breadcrumbs={[
        { name: "Inicio", path: "/" },
        { name: "Recursos", path: "/resources/" },
    ]}
>
    <main class="w-full min-w-0 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
        <div class="max-w-3xl mb-12">
            <h1
                class="font-display text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4"
                data-i18n="resourcesTitle"
            >
                Recursos
            </h1>
            <p
                class="text-lg text-slate-300 leading-relaxed"
                data-i18n="resourcesIntro"
            >
                Una selección de guías, plataformas de práctica y plantillas que
                la comunidad recomienda.
            </p>
        </div>

        <div class="mb-12">
            <ResourceSearch
                placeholderEs="Buscar en todos los recursos..."
                placeholderEn="Search all resources..."
            />
        </div>

        <!-- Categorías: cada una lleva a su listado -->
        <div
            data-hide-when-searching
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
        >
            {groups.map(({ category, items }) => (
                <a
                    href={categoryPath(category.id)}
                    class="card-glass rounded-2xl p-6 flex flex-col justify-between group transition-all duration-300 hover:border-brand-yellow/40 hover:-translate-y-0.5 shadow-lg shadow-black/20"
                >
                    <div>
                        <div class="mb-4 flex items-start justify-between gap-3">
                            <CategoryIcon category={category} />
                            <span
                                class="text-xs font-semibold text-slate-400"
                                data-i18n-es={resourceCountLabel(
                                    items.length,
                                    "es",
                                )}
                                data-i18n-en={resourceCountLabel(
                                    items.length,
                                    "en",
                                )}
                            >
                                {resourceCountLabel(items.length, "es")}
                            </span>
                        </div>
                        <h2
                            class="font-display text-xl font-bold text-white group-hover:text-brand-yellow transition-colors leading-snug mb-2"
                            data-i18n-es={category.label.es}
                            data-i18n-en={category.label.en}
                        >
                            {category.label.es}
                        </h2>
                        <p
                            class="text-sm text-slate-400 leading-relaxed"
                            data-i18n-es={category.description.es}
                            data-i18n-en={category.description.en}
                        >
                            {category.description.es}
                        </p>
                    </div>
                    <span class="pt-5 mt-5 border-t border-white/10 inline-flex items-center gap-1.5 text-xs font-bold text-brand-yellow group-hover:text-white transition-colors">
                        <span
                            data-i18n-es="Ver recursos"
                            data-i18n-en="View resources"
                        >
                            Ver recursos
                        </span>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-3.5 h-3.5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M14 5l7 7m0 0l-7 7m7-7H3"
                            />
                        </svg>
                    </span>
                </a>
            ))}
        </div>

        <!-- Resultados de búsqueda: todos los recursos, ocultos hasta buscar -->
        <div
            data-search-only
            hidden
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
        >
            {groups.flatMap(({ items }) =>
                items.map((item) => (
                    <ResourceCard
                        title={item.title}
                        descriptionEn={item.description.en}
                        descriptionEs={item.description.es}
                        url={item.url}
                        category={item.category}
                        type={item.type}
                        avatar={item.avatar}
                        channel={item.channel}
                        access={item.access}
                    />
                )),
            )}
        </div>

        <ResourceEmptyState />
        <ResourceCriteriaNote />
    </main>
</Layout>
