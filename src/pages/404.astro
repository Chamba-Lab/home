---
import Layout from "../layouts/Layout.astro";
import DiscordIcon from "../components/icons/DiscordIcon.astro";
import { DISCORD_URL } from "../lib/constants";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
---

<Layout
    title="Página no encontrada | Chamba Lab"
    description="La página que buscas no existe o cambió de lugar."
    noindex
>
    <main class="flex-1 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 text-center">
        <p class="font-display text-sm font-bold text-brand-yellow mb-4">404</p>
        <h1
            class="font-display text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4"
            data-i18n-es="Esta página no existe"
            data-i18n-en="This page doesn't exist"
        >
            Esta página no existe
        </h1>
        <p
            class="text-lg text-slate-300 leading-relaxed mb-10"
            data-i18n-es="Puede que el enlace haya cambiado o tenga un error. Vuelve al inicio o sigue la conversación en Discord."
            data-i18n-en="The link may have changed or contain a typo. Go back home or keep the conversation going on Discord."
        >
            Puede que el enlace haya cambiado o tenga un error. Vuelve al inicio
            o sigue la conversación en Discord.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
                href={base}
                class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-brand-yellow text-slate-950 font-bold hover:brightness-110 transition"
                data-i18n-es="Volver al inicio"
                data-i18n-en="Back to home"
            >
                Volver al inicio
            </a>
            <a
                href={DISCORD_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl card-glass border border-white/10 text-white font-semibold hover:border-white/20 transition"
            >
                <DiscordIcon class="w-5 h-5" />
                <span>Discord</span>
            </a>
        </div>
    </main>
</Layout>
