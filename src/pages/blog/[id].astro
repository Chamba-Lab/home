---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { getImage, Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import BeforeAfter from "../../components/blog/BeforeAfter.astro";
import Clip from "../../components/blog/Clip.astro";
import Link from "../../components/blog/Link.astro";
import YouTube from "../../components/blog/YouTube.astro";
import { SITE_URL } from "../../lib/constants";
import { formatLongDate } from "../../lib/events";
import { postDateIso, postPath, publishedPosts } from "../../lib/posts";
import { blogPostingJsonLd } from "../../lib/seo";

export async function getStaticPaths() {
    const posts = publishedPosts(await getCollection("posts"));
    return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
    post: CollectionEntry<"posts">;
}

// Ancho máximo de la imagen de las vistas previas.
const SHARE_MAX_WIDTH = 1200;

const { post } = Astro.props;
const { Content } = await render(post);

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const siteOrigin = Astro.site?.origin ?? SITE_URL;

const {
    title,
    description,
    date,
    cover,
    coverAlt,
    ogImage,
    tags,
    author,
    lang,
} = post.data;
const iso = postDateIso(date);

// Imagen para las vistas previas: solo la del campo `ogImage`, tal cual, sin
// recortarla. Sin ella, Layout usa la imagen general del sitio.
const share = ogImage
    ? await getImage({
          src: ogImage,
          width: Math.min(ogImage.width, SHARE_MAX_WIDTH),
          format: "jpg",
      })
    : undefined;
const shareImageUrl = new URL(share?.src ?? "/og-image.png", siteOrigin).href;
---

<Layout
    title={`${title} | Chamba Lab`}
    description={description}
    type="article"
    image={share?.src}
    imageWidth={share?.attributes.width}
    imageHeight={share?.attributes.height}
    imageAlt={title}
    breadcrumbs={[
        { name: "Inicio", path: "/" },
        { name: "Blog", path: "/blog/" },
        { name: title, path: postPath(post.id) },
    ]}
    jsonLd={[
        blogPostingJsonLd(siteOrigin, {
            title,
            description,
            date: iso,
            path: postPath(post.id),
            image: shareImageUrl,
            lang,
        }),
    ]}
    rss
>
    <main class="w-full max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
        <a
            href={`${base}blog/`}
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-400 hover:text-brand-yellow transition-colors mb-8"
        >
            <span aria-hidden="true">←</span>
            <span data-i18n="blogBack">Volver al blog</span>
        </a>

        <article lang={lang}>
            <header class="mb-10">
                <p
                    class="text-[11px] font-bold uppercase tracking-wider text-brand-yellow mb-3"
                    data-i18n-es={formatLongDate(iso, "es")}
                    data-i18n-en={formatLongDate(iso, "en")}
                >
                    {formatLongDate(iso, "es")}
                </p>
                <h1 class="font-display text-4xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
                    {title}
                </h1>
                <p class="text-lg text-slate-300 leading-relaxed">
                    {description}
                </p>
                <div class="mt-5 flex flex-wrap items-center gap-3 text-sm text-slate-400">
                    {author && (
                        <span>
                            <span data-i18n="blogBy">Por</span>{" "}
                            <strong class="text-slate-200">{author}</strong>
                        </span>
                    )}
                    {tags.map((tag) => (
                        <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded bg-slate-800 text-slate-300 border border-white/10">
                            {tag}
                        </span>
                    ))}
                </div>
            </header>

            {cover && (
                <Image
                    src={cover}
                    alt={coverAlt ?? ""}
                    widths={[480, 768, 1200]}
                    sizes="(min-width: 768px) 768px, 100vw"
                    class="post-cover"
                />
            )}

            <div class="post-body">
                <Content components={{ a: Link, BeforeAfter, Clip, YouTube }} />
            </div>
        </article>
    </main>
</Layout>

<script>
    import { initBlogZoom } from "../../lib/blog-zoom";

    initBlogZoom();
</script>

<style is:global>
    /* Ampliar imágenes y clips: el botón y el diálogo los crea o pone
       blog-zoom.ts (el botón de los clips viene de Clip.astro). */
    .zoom-wrap {
        position: relative;
        display: block;
        width: fit-content;
        max-width: 100%;
        margin: 2rem auto;
    }
    .zoom-wrap.is-cover {
        margin: 0 auto 2.5rem;
    }
    figure.clip .zoom-wrap {
        margin: 0 auto;
    }
    .zoom-wrap > img {
        margin: 0 !important;
    }
    .zoom-btn {
        position: absolute;
        right: 0.5rem;
        bottom: 0.5rem;
        display: grid;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 999px;
        border: 1px solid rgb(255 255 255 / 0.25);
        background: rgb(8 13 26 / 0.7);
        color: #fff;
        cursor: zoom-in;
        backdrop-filter: blur(4px);
        transition:
            border-color 0.15s,
            color 0.15s;
    }
    .zoom-btn:hover {
        border-color: var(--color-brand-yellow);
        color: var(--color-brand-yellow);
    }
    .zoom-btn:focus-visible {
        outline: 2px solid var(--color-brand-yellow);
        outline-offset: 2px;
    }
    html:has(dialog.lightbox[open]) {
        overflow: hidden;
    }
    dialog.lightbox {
        width: 100vw;
        height: 100dvh;
        max-width: none;
        max-height: none;
        margin: 0;
        padding: 0;
        border: 0;
        overflow: hidden;
        background: rgb(8 13 26 / 0.92);
    }
    dialog.lightbox::backdrop {
        background: rgb(8 13 26 / 0.92);
    }
    .lightbox-stage {
        display: grid;
        place-items: center;
        width: 100%;
        height: 100%;
        padding: 1rem;
    }
    .lightbox-stage img,
    .lightbox-stage video {
        max-width: calc(100vw - 2rem);
        max-height: calc(100dvh - 2rem);
        object-fit: contain;
        border-radius: 0.75rem;
    }
    .lightbox-close {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 999px;
        border: 1px solid rgb(255 255 255 / 0.3);
        background: rgb(8 13 26 / 0.8);
        color: #fff;
        font-size: 1.5rem;
        line-height: 1;
        cursor: pointer;
    }
    .lightbox-close:hover,
    .lightbox-close:focus-visible {
        border-color: var(--color-brand-yellow);
        color: var(--color-brand-yellow);
        outline: none;
    }
</style>

<style>
    .post-cover {
        display: block;
        width: 100%;
        max-height: 32rem;
        object-fit: contain;
        margin: 0 auto 2.5rem;
        border-radius: 1rem;
        border: 1px solid var(--color-surface-border-subtle);
        background: var(--color-surface-subtle);
    }

    /* Cuerpo de la entrada: estilos acotados con los tokens del sitio, sin
       plugin de tipografía. Los bloques de código van sin resaltado (la CSP no
       admite Shiki). */
    .post-body {
        font-size: 1.0625rem;
        line-height: 1.75;
        color: var(--color-content);
    }
    .post-body :global(> * + *) {
        margin-top: 1.25rem;
    }
    .post-body :global(h2) {
        margin-top: 2.75rem;
        font: 800 1.75rem/1.25 var(--font-display);
        letter-spacing: -0.02em;
        color: var(--color-content-inverse);
    }
    .post-body :global(h3) {
        margin-top: 2.25rem;
        font: 700 1.3125rem/1.3 var(--font-display);
        color: var(--color-content-inverse);
    }
    .post-body :global(a) {
        color: var(--color-brand-yellow);
        text-decoration: underline;
        text-underline-offset: 3px;
    }
    .post-body :global(a:hover) {
        color: var(--color-brand-yellow-hover);
    }
    .post-body :global(a:focus-visible) {
        outline: 2px solid var(--color-brand-yellow);
        outline-offset: 3px;
        border-radius: 2px;
    }
    /* Insignia de los enlaces a GitHub y YouTube (los marca Link.astro con
       data-kind): una píldora con el icono antes del texto. */
    .post-body :global(a[data-kind]) {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.0625rem 0.625rem 0.0625rem 0.5rem;
        border-radius: 999px;
        border: 1px solid var(--color-surface-border-subtle);
        background: var(--color-surface-card);
        color: var(--color-content-inverse);
        font-size: 0.95em;
        font-weight: 600;
        text-decoration: none;
        transition:
            border-color 0.15s,
            color 0.15s;
    }
    .post-body :global(a[data-kind]:hover) {
        border-color: var(--color-brand-yellow);
        color: var(--color-brand-yellow);
    }
    .post-body :global(a[data-kind] svg),
    .post-body :global(a[data-kind] img) {
        flex: none;
        width: 1em;
        height: 1em;
        object-fit: contain;
    }
    /* El logo no es una imagen de la entrada: sin los márgenes ni el borde de
       `.post-body img`. */
    .post-body :global(a[data-kind] img) {
        max-height: none;
        margin: 0;
        border: 0;
        border-radius: 0.25rem;
    }
    .post-body :global(strong) {
        color: var(--color-content-inverse);
    }
    .post-body :global(ul),
    .post-body :global(ol) {
        padding-left: 1.5rem;
    }
    .post-body :global(ul) {
        list-style: disc;
    }
    .post-body :global(ol) {
        list-style: decimal;
    }
    .post-body :global(li + li) {
        margin-top: 0.5rem;
    }
    .post-body :global(li::marker) {
        color: var(--color-brand-yellow);
    }
    .post-body :global(blockquote) {
        padding: 0.25rem 0 0.25rem 1.25rem;
        border-left: 3px solid var(--color-brand-yellow);
        color: var(--color-muted);
    }
    .post-body :global(code) {
        padding: 0.125rem 0.375rem;
        border-radius: 0.375rem;
        background: var(--color-surface-card);
        font-size: 0.9em;
    }
    .post-body :global(pre) {
        overflow-x: auto;
        padding: 1rem 1.25rem;
        border-radius: 0.75rem;
        border: 1px solid var(--color-surface-border-subtle);
        background: var(--color-surface);
        font-size: 0.875rem;
        line-height: 1.6;
    }
    .post-body :global(pre code) {
        padding: 0;
        background: none;
    }
    .post-body :global(img) {
        display: block;
        max-width: 100%;
        max-height: min(36rem, 80vh);
        width: auto;
        height: auto;
        margin: 2rem auto;
        border-radius: 1rem;
        border: 1px solid var(--color-surface-border-subtle);
    }
    /* Tablas: una tarjeta con cabecera marcada, filas alternas y la primera
       columna destacada. Pensadas para pocas columnas y celdas cortas; en
       pantallas estrechas hacen scroll horizontal dentro de la tarjeta para
       no ensanchar la página. */
    .post-body :global(table) {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        overflow: hidden;
        border: 1px solid var(--color-surface-border-subtle);
        border-radius: 0.75rem;
        background: var(--color-surface);
        font-size: 0.9375rem;
        line-height: 1.5;
    }
    @media (max-width: 640px) {
        .post-body :global(table) {
            display: block;
            overflow-x: auto;
        }
    }
    .post-body :global(th),
    .post-body :global(td) {
        padding: 0.75rem 1rem;
        text-align: left;
        vertical-align: top;
    }
    .post-body :global(thead th) {
        background: var(--color-surface-card);
        color: var(--color-muted);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .post-body :global(tbody td) {
        border-top: 1px solid var(--color-surface-border-subtle);
    }
    .post-body :global(tbody tr:nth-child(even) td) {
        background: rgb(255 255 255 / 0.025);
    }
    .post-body :global(tbody td:first-child) {
        color: var(--color-content-inverse);
        font-weight: 600;
    }
    .post-body :global(hr) {
        margin: 2.5rem 0;
        border-color: var(--color-surface-border-subtle);
    }
</style>
