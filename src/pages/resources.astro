---
import Layout from "../layouts/Layout.astro";
import ResourceCard from "../components/ResourceCard.astro";
import { getCollection } from "astro:content";
import { RESOURCE_CATEGORIES, groupByCategory } from "../lib/resources";

const resources = (await getCollection("resources")).map((r) => r.data);
const groups = groupByCategory(resources);
---

<Layout
    title="Biblioteca de recursos tech | Chamba Lab"
    description="Biblioteca curada de guías, plataformas de práctica y plantillas para tu CV, tu aprendizaje y tus entrevistas, recomendada por la comunidad tech."
    breadcrumbs={[
        { name: "Inicio", path: "/" },
        { name: "Recursos", path: "/resources/" },
    ]}
>
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
        <!-- Page Header -->
        <div class="max-w-3xl mb-12">
            <div
                class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full card-glass text-xs font-semibold text-slate-300 border border-white/10 mb-6"
            >
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"
                ></span>
                <span>Biblioteca Curada</span>
            </div>
            <h1
                class="font-display text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4"
                data-i18n="resourcesTitle"
            >
                Recursos
            </h1>
            <p
                class="text-lg text-slate-300 leading-relaxed"
                data-i18n="resourcesIntro"
            >
                Una selección de guías, plataformas de práctica y plantillas que
                la comunidad recomienda.
            </p>
        </div>

        <!-- Search and Filter Bar -->
        <div class="mb-12 space-y-4 max-w-4xl">
            <div class="relative">
                <input
                    id="resource-search"
                    type="search"
                    data-i18n-placeholder-en="Search resources by title or description..."
                    data-i18n-placeholder-es="Buscar recursos por título o descripción..."
                    placeholder="Buscar recursos por título o descripción..."
                    class="w-full card-glass rounded-xl px-5 py-3.5 pl-12 text-sm text-white placeholder:text-slate-500 border border-white/10 focus:outline-none focus:border-brand-yellow/50 transition-all shadow-inner"
                />
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5 text-slate-400 absolute left-4 top-3.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
            </div>

            <!-- Segmented Category Filters -->
            <div class="flex flex-wrap items-center gap-2.5 pt-1">
                <button
                    type="button"
                    data-filter="all"
                    aria-pressed="true"
                    class="resource-filter-pill px-4 py-2 text-xs font-bold uppercase rounded-xl transition-all bg-brand-yellow text-slate-950 shadow-md shadow-brand-yellow/20"
                    data-i18n="filterAll"
                >
                    Todos
                </button>
                {
                    RESOURCE_CATEGORIES.map((category) => (
                        <button
                            type="button"
                            data-filter={category.id}
                            aria-pressed="false"
                            class="resource-filter-pill px-4 py-2 text-xs font-bold uppercase rounded-xl transition-all bg-slate-900/80 border border-white/10 text-slate-300 hover:text-white hover:border-white/20"
                            data-i18n-en={category.label.en}
                            data-i18n-es={category.label.es}
                        >
                            {category.label.es}
                        </button>
                    ))
                }
            </div>
        </div>

        <!-- Groups List -->
        <div class="space-y-6">
            {
                groups.map((group) => (
                    <section
                        data-resource-section={group.category.id}
                        class="space-y-6"
                    >
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            {group.items.map((item) => (
                                <ResourceCard
                                    title={item.title}
                                    descriptionEn={item.description.en}
                                    descriptionEs={item.description.es}
                                    url={item.url}
                                    category={item.category}
                                    type={item.type}
                                    avatar={item.avatar}
                                    channel={item.channel}
                                    access={item.access}
                                />
                            ))}
                        </div>
                    </section>
                ))
            }
        </div>

        <p
            class="mt-12 max-w-3xl text-sm text-slate-400 leading-relaxed"
            data-i18n="resourcesCriteria"
        >
            Elegimos recursos seguros, con un propósito claro y fáciles de
            empezar sin pagar. En cursos y certificaciones indicamos si son
            gratis, gratis con extras de pago o de pago. Los planes y precios
            cambian: confírmalos en cada sitio.
        </p>

        <!-- Empty State -->
        <div
            id="resources-empty"
            hidden
            class="card-glass rounded-2xl p-12 text-center text-slate-400 border border-white/10 my-12"
            data-i18n="noResourcesFound"
        >
            No encontramos recursos que coincidan con tu búsqueda.
        </div>
    </main>

    <script>
        import { matchesFilters } from "../lib/resources";

        const searchInput =
            document.querySelector<HTMLInputElement>("#resource-search");
        const categoryPills = Array.from(
            document.querySelectorAll<HTMLButtonElement>("[data-filter]"),
        );
        const sections = Array.from(
            document.querySelectorAll<HTMLElement>("[data-resource-section]"),
        );
        const emptyState =
            document.querySelector<HTMLElement>("#resources-empty");

        let activeFilter = "all";

        function applyFilter() {
            const query = searchInput?.value ?? "";
            let anyVisible = false;

            sections.forEach((section) => {
                let sectionHasVisible = false;
                section
                    .querySelectorAll<HTMLElement>("[data-resource-card]")
                    .forEach((card) => {
                        const visible = matchesFilters(
                            {
                                category: card.dataset.resourceCard ?? "",
                                text: card.textContent ?? "",
                            },
                            {
                                category: activeFilter,
                                query,
                            },
                        );
                        card.hidden = !visible;
                        if (visible) sectionHasVisible = true;
                    });
                section.hidden = !sectionHasVisible;
                if (sectionHasVisible) anyVisible = true;
            });

            if (emptyState) emptyState.hidden = anyVisible;
        }

        function paintPills(pills: HTMLButtonElement[], selected: HTMLElement) {
            pills.forEach((p) => {
                const active = p === selected;
                p.setAttribute("aria-pressed", String(active));
                if (active) {
                    p.classList.add(
                        "bg-brand-yellow",
                        "text-slate-950",
                        "shadow-md",
                        "shadow-brand-yellow/20",
                    );
                    p.classList.remove(
                        "bg-slate-900/80",
                        "border-white/10",
                        "text-slate-300",
                    );
                } else {
                    p.classList.remove(
                        "bg-brand-yellow",
                        "text-slate-950",
                        "shadow-md",
                        "shadow-brand-yellow/20",
                    );
                    p.classList.add(
                        "bg-slate-900/80",
                        "border-white/10",
                        "text-slate-300",
                    );
                }
            });
        }

        categoryPills.forEach((pill) => {
            pill.addEventListener("click", () => {
                activeFilter = pill.dataset.filter ?? "all";
                paintPills(categoryPills, pill);
                applyFilter();
            });
        });

        searchInput?.addEventListener("input", applyFilter);

        document.addEventListener("chamba-lab:lang", (event) => {
            const lang = (event as CustomEvent<{ lang: "es" | "en" }>).detail
                .lang;
            if (searchInput) {
                searchInput.placeholder =
                    lang === "es"
                        ? (searchInput.dataset.i18nPlaceholderEs ?? "")
                        : (searchInput.dataset.i18nPlaceholderEn ?? "");
            }
            applyFilter();
        });

        // Videos: la miniatura es un enlace a YouTube. Con JS, al pulsarla se
        // carga el reproductor (sin cookies de seguimiento) en el mismo lugar;
        // antes de eso no se envía nada a YouTube salvo la miniatura.
        document
            .querySelectorAll<HTMLAnchorElement>("[data-video-id]")
            .forEach((thumb) => {
                thumb.addEventListener("click", (event) => {
                    event.preventDefault();
                    const iframe = document.createElement("iframe");
                    iframe.src = `https://www.youtube-nocookie.com/embed/${thumb.dataset.videoId}?autoplay=1&rel=0`;
                    iframe.title = thumb.dataset.videoTitle ?? "Video";
                    iframe.allow =
                        "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen";
                    iframe.allowFullscreen = true;
                    iframe.className = "absolute inset-0 h-full w-full";
                    thumb.replaceChildren(iframe);
                    thumb.removeAttribute("href");
                    thumb.removeAttribute("aria-label");
                });
            });
    </script>
</Layout>
