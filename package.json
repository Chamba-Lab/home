{
    "name": "chamba-lab",
    "type": "module",
    "version": "0.14.0",
    "description": "Chamba Lab: Community-Led Tech Platform",
    "license": "MIT",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "release": "release-it",
        "changelog": "auto-changelog -p",
        "lint": "eslint . && prettier --check .",
        "lint:fix": "eslint . --fix && prettier --write .",
        "test": "vitest run",
        "brand:optimize": "svgo -f src/assets/brand --config svgo.config.cjs",
        "team:optimize": "svgo -f src/assets/team/logos --config svgo.config.cjs",
        "brand:og": "node scripts/build-og.mjs"
    },
    "dependencies": {
        "@astrojs/react": "^6.0.6",
        "@astrojs/sitemap": "^3.7.4",
        "@tailwindcss/vite": "^4.2.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "astro": "^7.3.3",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "tailwindcss": "^4.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@release-it/conventional-changelog": "^10.0.6",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@typescript-eslint/eslint-plugin": "^8.56.0",
        "@typescript-eslint/parser": "^8.56.0",
        "auto-changelog": "^2.5.0",
        "eslint": "^10.0.0",
        "eslint-plugin-astro": "^1.6.0",
        "happy-dom": "^20.6.3",
        "prettier": "^3.8.1",
        "prettier-plugin-astro": "^0.14.1",
        "release-it": "^19.2.4",
        "sharp": "^0.35.5",
        "svgo": "^4.1.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18"
    },
    "overrides": {
        "undici": "^7.24.3"
    }
}
