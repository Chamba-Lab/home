{
    "name": "chamba-lab",
    "type": "module",
    "version": "0.25.10",
    "description": "Chamba Lab: public site of the tech community",
    "license": "MIT",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "release": "release-it",
        "changelog": "auto-changelog -p",
        "lint": "eslint . && prettier --check .",
        "lint:fix": "eslint . --fix && prettier --write .",
        "test": "vitest run",
        "brand:optimize": "svgo -f src/assets/brand --config svgo.config.cjs",
        "team:optimize": "svgo -f src/assets/team/logos --config svgo.config.cjs",
        "brand:og": "node scripts/build-og.mjs",
        "brand:discord": "node scripts/build-discord-assets.mjs"
    },
    "dependencies": {
        "@astrojs/react": "^7.0.1",
        "@astrojs/sitemap": "^3.7.4",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
        "@tailwindcss/vite": "^4.2.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "astro": "^7.3.8",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "tailwindcss": "^4.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@release-it/conventional-changelog": "^12.0.2",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.56.0",
        "auto-changelog": "^2.7.0",
        "eslint": "^10.12.0",
        "eslint-plugin-astro": "^3.2.1",
        "happy-dom": "^21.0.1",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^1.1.1",
        "release-it": "^19.2.4",
        "sharp": "^0.35.5",
        "svgo": "^4.1.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18"
    },
    "overrides": {
        "undici": "^7.24.3",
        "basic-ftp": "^6.2.3"
    }
}
